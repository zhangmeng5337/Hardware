#ifndef __CONTROLLER_H_
#define __CONTROLLER_H_

#include <stdbool.h>
#include <stdint.h>
#include "utilities.h"
#include "nvmem.h"
#include "StepMotor.h"

#define CONTROLMODE_DIGITAL   0
#define CONTROLMODE_ANALOG    1

#define SAFETY_NORMAL         0
#define SAFETY_OVERRIDE       1

#define SIGPROC_PERIOD_MS     2

#define PURGE_GASPAGE         6

#define FFDPSPAN  5

#define NC_VALVE              0
#define NO_VALVE              1

typedef enum {
  OVERRIDE_NORMAL = 0,
  OVERRIDE_OFF,
  OVERRIDE_ON,
  OVERRIDE_HOLD,
  OVERRIDE_SAFESTATE,
  OVERRIDE_MANUAL_DRIVE = 50,
  OVERRIDE_SYSTEM_IDENT = 99
} override_mode;

typedef struct {
  uint8_t override;
  uint8_t status;
} dns_saa_struct;

typedef struct {
  float pvariable;
  uint8_t status;
} dns_ssc_struct;

typedef struct {
  float   pzfValue;
  float   pzfPoleGain;
  float   pzfZeroGain;
} PzfRecord;

typedef struct {
  float       piIntegral;     // previous integrator output
  float       piIGain;
  float       piPGain;
  PzfRecord   pidDFilter;
  float       llDTerm;        // result of D-term calculation
  float       ffValue;
  float       fcGllOutput;
  float       pTerm;
} PiRecord, *PiPtr;

typedef struct {
  uint8_t idx;
  float fny[FFDPSPAN];
  float m;
} mffdp_struct;

typedef struct {
  uint8_t type;           // controller type 1: new; default: old  
  float *feedback;
  float Pgain;
  float Igain;
  float Dgain;  // pole
  float D2gain; // zero
  float error;
  float pterm;
  float iterm;
  float dterm;
  bool saturated;
  bool signequal;
  float isath;
  float isatl;
  float prevError;        /* Requred for integarator */
  float prevMeasurement;  /* Regquired for differentiator */    
  float tau;              /* Derivative low-pass filter time constant */
  float T;                /* Smaple time (seconds) */
  float setpoint;
  float setpointunits;
  float ctrlv;
  uint8_t invertdrive;
  float normalizeddrive;  // normlaized drive signal going to DAC. inverion of ctrlv is placed here
  float icrack;
  float icrack2;
  float *currentpressure;
  float *currentmW;
  float scaledKp;
  float scaledKi;
  float scaledKiGas;
  float scaledcrack;  
  float asetpoint;
  float shutoffthreshold;
  uint8_t override;
  bool rampinprogress;
  int32_t  ramp;
  int32_t  ramprate;
  int32_t  minramprate;
  float spresolution;
  float currentsp;
  float targetsp;
  bool downdir;
  bool updir;
  int32_t delayctr;  
  int32_t turnondelay;
  int32_t turnoffdelay;
  lincurve_element dynPtable[MAX_DYNAMIC_GAIN_TABLE];
  lincurve_element dynItable[MAX_DYNAMIC_GAIN_TABLE];
  float lGainCorr[2];
  dns_saa_struct dnet_saa;
  dns_ssc_struct dnet_scc;
  system_identification_struct sysIdent;    
  
  PiRecord    fcGll;                  //!< Flow controller GLL
  float fcGllGain;

  mffdp_struct mffdp;
  float ffGain;
  
  uint8_t ctrlmode;
  uint8_t currSMState;  // current motor state
  uint8_t transSMState; // transition state request
  StepMotor_stru *sm;
  
} ctrl_struct;

typedef enum {
	CTRL_OFF = 0,
	CTRL_CRACK,
  CTRL_RAMP_SETUP,
	CTRL_NORMAL
} ctrl_state;

typedef struct {
  // inputs
  PiPtr       pi;     // LL structure (WR8)
  float       cmd;    // Command value (DR0) fcCompositeSetpoint
  float       flow;   // current measured flow fmNormalizedFlow
  // intermediate values
  float       gterm;  // Gain term (WR10)
  float       dterm;
  float       fbk;    // Feedback value (DR4)
  float       error;
//  float       pterm;
//  float       iterm;
  // outputs
  float       ctrlv;  // LL controller output (DR0)
  uint16_t      flags;  // PID overflow flags (R10)

  float		u;
  float		v;
  float		br;

} GllRecord, *GllPtr;

extern ctrl_struct ctrl;
extern ctrl_struct dpctrl;
extern ctrl_state getControllerState(void);
extern void load_controller_parameters(float *flow, float *custom, float *pa);
extern void controller(float pv, float sp, float *cv);
extern void actuatorControl(uint8_t stateRequest);
extern uint8_t checkSafety(float dpvalue, float maxlimit, float *ctrlv);
#endif
