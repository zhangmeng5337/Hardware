#ifndef STEP_MOTOR_H
#define STEP_MOTOR_H
#include "main.h"



#define DOWN_STEP_TIMEOUT 1500//-----3600
#define UP_STEP_TIMEOUT 100//100---1000scc--300torr 100--10L--300torr
#define POSITION_CAL_CYCLE 1
#define ROTAIONS_ERROR		0.003

#define MAIN_FREQ  SystemCoreClock

#define PWM_MODE   0//0:normal  1:dma


#define MOTOR_SENSOR    1//1:encoder sensor 
#define MOTOR_NO_SENSOR 0//0: no sensor

#define POS_CTRL   0
#define TIM_CTRL   1


#define MSTOP	1
#define MSTART	2

#define STATE_HOME 	0
#define STATE_MOVE	1
#define STATE_FOPEN	2
#define STATE_WAIT_COMPLETE 3

#define STATE_IDLE  4

#define MOVE_UP   1
#define MOVE_DOWN 2
#define MOVE_STOP 3
#define MOVE_MAX_UP 4

typedef struct
{  
  float max_position;//0-12.7 maybe changed
  float min_position;//0
  float set_position;//0-1
  float real_pos_mm;
  float requset_pos_mm;
  float real_pos_percent;
  float requ_encoder_pulse;
  unsigned char dir;
  
  float pos_error_resolution;
  float encoder_error_resolution;
  
  float freq;
  uint32_t arr;
  unsigned char  fault_status; //0:no fault

  unsigned char status;//1:start 0:stop
  unsigned char step_motor_status;
  unsigned char time_start_flag;//0:stop 1:start
  unsigned char ustep;
  float step_angle;
  float us_one_step;
  float distance_one_cycle;


} StepMotor_stru;

void StepMotorInit(void);
unsigned char StepMotorFault(void);
StepMotor_stru *getStepMotor(void);

void StepMotorStatusProc(void);
void StepMotorTeset(void);



unsigned char StepMotorCtrl(float set_pos);
#endif


