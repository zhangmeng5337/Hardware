void open_ration_cal()
{
    if (step_motor_usr.max_position == 0)
    {
        step_motor_usr.fault_status = 2;
        return ;

    }

    step_motor_usr.open_percent = (step_motor_usr.position) / step_motor_usr.max_position;
    if (step_motor_usr.open_percent <= 0.0096)
        step_motor_usr.open_percent = 0;

}
unsigned char StepMotorHoming()
{
    if (step_motor_usr.fault_status == 0)
    {
        // step_motor_usr.mode = POS_CTRL;
        step_motor_usr.pwm_total_pulse_count = step_motor_usr.max_position / step_motor_usr.distance_one_step *
                                               step_motor_usr.ustep;
        //step_motor_usr.pwm_total_pulse_count = 10;


        Timer_update_Cal(step_motor_usr.freq);
        StepMotorDirection(FORWARD);
        StepMotorModeCtrl(MSTART);
    }
    else
        return 0;


}
unsigned char StepMotorStatusProc()
{
    StepMotorFault();
    if (step_motor_usr.time_start_flag == 1)
    {
        if (step_motor_usr.timeout_count < step_motor_usr.down_time)
            step_motor_usr.timeout_count ++;
    }
}


// step motor position control

void StepMotorCtrlByPosition(float pos)
{
    float set_pos;

    set_pos = pos * step_motor_usr.max_position;
    if (set_pos > step_motor_usr.max_position)
    {
        // step_motor_usr.state = STATE_WAIT_COMPLETE;
        // step_motor_usr.op_complete = 1;
        step_motor_usr.fault_status = 3;
        set_pos = step_motor_usr.max_position;
        //return ;

    }
    //  if (step_motor_usr.position <= pos)
    {

        //step_motor_usr.mode = POS_CTRL;
        float tmp;
        if (pos <= 0)
        {
            step_motor_usr.Fopen_count = 0;
            if (step_motor_usr.home_count < step_motor_usr.retry_times)
            {
                step_motor_usr.home_count++;
                tmp = step_motor_usr.position + 1; //step_motor_usr.ustep;
                step_motor_usr.dir = FORWARD;
            }
            else
            {
                step_motor_usr.state = STATE_WAIT_COMPLETE;
                step_motor_usr.op_complete = 1;
                StepMotorModeCtrl(MSTOP);
                tmp = 0;
                step_motor_usr.position  = 0;
            }
        }
        else
        {
            step_motor_usr.home_count = 0;
            if (pos >= 1)
            {
                if (step_motor_usr.Fopen_count < step_motor_usr.retry_times)
                {
                    step_motor_usr.Fopen_count++;
                    //                    if (step_motor_usr.position >= 0.9 * step_motor_usr.max_position)
                    //                        tmp = step_motor_usr.position + 2 ; //step_motor_usr.ustep;
                    //                    else
                    tmp = step_motor_usr.max_position - step_motor_usr.position ; //step_motor_usr.ustep;

                    step_motor_usr.dir = BACKWARD;
                }
                else
                {
                    step_motor_usr.state = STATE_WAIT_COMPLETE;
                    step_motor_usr.op_complete = 1;
                    StepMotorModeCtrl(MSTOP);
                    tmp = 0;
                    step_motor_usr.position  =  step_motor_usr.max_position;
                }
            }
            else
            {
                if (set_pos < step_motor_usr.position)
                {
                    tmp = step_motor_usr.position - set_pos;
                    step_motor_usr.dir = FORWARD;

                }

                else
                {
                    tmp = set_pos - step_motor_usr.position;
                    step_motor_usr.dir = BACKWARD;
                }
                if (step_motor_usr.position >= (step_motor_usr.max_position + 1))
                {
                    tmp = 0;
                }
                step_motor_usr.Fopen_count = 0;

            }
        }
        tmp = tmp * step_motor_usr.ustep / step_motor_usr.distance_one_step ;
        tmp = round(tmp);
        step_motor_usr.pwm_total_pulse_count = tmp;
        if (step_motor_usr.pwm_total_pulse_count < step_motor_usr.ustep)
        {
            if (step_motor_usr.pwm_total_pulse_count > 0)
                step_motor_usr.pwm_total_pulse_count = step_motor_usr.ustep;
        }
        step_motor_usr.dma_buf[0] = step_motor_usr.arr / 2;

        //if (step_motor_usr.fault_status == 0&&step_motor_usr.pwm_total_pulse_count>5)
        if (step_motor_usr.pwm_total_pulse_count > step_motor_usr.ustep)
        {
            Timer_update_Cal(step_motor_usr.freq);
            StepMotorDirection(step_motor_usr.dir);
            StepMotorModeCtrl(MSTART);


        }
        else
        {
            step_motor_usr.state = STATE_WAIT_COMPLETE;
            step_motor_usr.op_complete = 1;
            StepMotorModeCtrl(MSTOP);

        }
    }

}


unsigned char StepMotorStateProc(unsigned char state)
{
    // position control

    unsigned char result;
    result = 0;
    if (step_motor_usr.state != STATE_WAIT_COMPLETE)
        step_motor_usr.state = state;
    switch (step_motor_usr.state)
    {
        case STATE_HOME:
            StepMotorHoming();
            step_motor_usr.state = STATE_WAIT_COMPLETE;
            break;

        case STATE_MOVE:
            StepMotorCtrlByPosition(getStepMotor()->set_position);
            step_motor_usr.state = STATE_WAIT_COMPLETE;
            break;

        case STATE_FOPEN:
            getStepMotor()->set_position = 1;
            //getStepMotor()->position = getStepMotor()->max_position;
            StepMotorCtrlByPosition(getStepMotor()->set_position);
            step_motor_usr.state = STATE_WAIT_COMPLETE;
            break;
        case STATE_WAIT_COMPLETE:
            if (getStepMotor()->op_complete == 1)
            {
                step_motor_usr.state = STATE_IDLE;
                result = 1;
            }

            break;
        default:
        case STATE_IDLE:
            StepMotorModeCtrl(MSTOP);
            result = 1;
            break;

    }
    return result;
}
