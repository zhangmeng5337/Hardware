void HAL_TIM_PWM_PulseFinishedCallback(TIM_HandleTypeDef *htim)
{

    uint32_t tmp;
    uint32_t pulse_count;
    if (htim == &htim15)
    {
        if (step_motor_usr.pwm_laod_pulse_count <= 256)
        {
            pulse_count = step_motor_usr.pwm_laod_pulse_count;
        }
        else
        {
            if (step_motor_usr.pwm_inst_pulse_count < step_motor_usr.pwm_laod_pulse_count)
            {
                step_motor_usr.pwm_inst_pulse_count = step_motor_usr.pwm_inst_pulse_count + 256;
                if (step_motor_usr.pwm_laod_pulse_count > step_motor_usr.pwm_inst_pulse_count)
                {
                    tmp = step_motor_usr.pwm_laod_pulse_count - step_motor_usr.pwm_inst_pulse_count;
                    pulse_count = step_motor_usr.pwm_inst_pulse_count -
                                  step_motor_usr.pwm_inst_last_pulse_count;//detal pusle
                    step_motor_usr.pwm_inst_last_pulse_count = step_motor_usr.pwm_inst_pulse_count;

                }

                else
                {
                    pulse_count = step_motor_usr.pwm_inst_pulse_count -
                                  step_motor_usr.pwm_inst_last_pulse_count;//detal pusle
                    pulse_count = pulse_count + step_motor_usr.pwm_laod_pulse_count -
                                  step_motor_usr.pwm_inst_pulse_count ;
                    tmp  = 0;
                }

                if (tmp <= 256)
                {
                    if (tmp > 0)
                        HAL_TIM_PWM_Start_DMA(&htim15, TIM_CHANNEL_1, (uint32_t *)step_motor_usr.dma_buf, tmp);
                    else
                    {
                        step_motor_usr.pwm_inst_pulse_count = 0;

                    }
                }
                else
                {
                    HAL_TIM_PWM_Start_DMA(&htim15, TIM_CHANNEL_1, (uint32_t *)step_motor_usr.dma_buf, 256);

                }
            }

        }

        if (step_motor_usr.dir == FORWARD)
            step_motor_usr.position = step_motor_usr.position -  pulse_count / step_motor_usr.ustep *
                                      step_motor_usr.distance_one_step;
        else
            step_motor_usr.position = step_motor_usr.position +  pulse_count / step_motor_usr.ustep *
                                      step_motor_usr.distance_one_step;

        if (step_motor_usr.position < step_motor_usr.min_position)
            step_motor_usr.position = 0;
        if (step_motor_usr.position > step_motor_usr.max_position)
            step_motor_usr.position = step_motor_usr.max_position;
        if (step_motor_usr.pwm_laod_pulse_count <= 256 || tmp == 0)
        {
            getStepMotor()->op_complete = 1;
            HAL_TIM_PWM_Stop_DMA(&htim15, TIM_CHANNEL_1);
            StepMotorModeCtrl(MSTOP);
            step_motor_usr.pwm_inst_pulse_count = 0;
            step_motor_usr.pwm_inst_last_pulse_count = 0;
            step_motor_usr.pwm_laod_pulse_count = 0;
            getStepMotor()->op_complete = 1;
            pulse_count = 0;
        }
        open_ration_cal();


    }

}

/***************************************************************************************/
/*****************************************************************************
command:
	 MOVE_UP   
	 MOVE_DOWN 
	 MOVE_STOP 
return 
	0:nomal
	1:step motor hit
***************************************************************************/

unsigned char StepMotorCtrl(unsigned char command)
{
    unsigned char result;
    unsigned char state;
    state = command;
    result = 0;
    if (step_motor_usr.step_motor_status != state)
    {
      step_motor_usr.time_start_flag = 1;
        step_motor_usr.timeout_count = 0;
        step_motor_usr.step_motor_status = state;

    }
    else
    {
      if (step_motor_usr.timeout_count >= step_motor_usr.up_time &&
         step_motor_usr.step_motor_status == MOVE_UP)
      {
        result = 1;
        state = MOVE_STOP;

      }    
    }
    if (step_motor_usr.timeout_count >= step_motor_usr.down_time)
    {
        result = 1;
        state = MOVE_STOP;

    }

    switch (state)
    {
        case MOVE_UP:
           // step_motor_usr.up_time = UP_STEP_TIMEOUT;
            step_motor_usr.dir = BACKWARD;
            step_motor_usr.time_start_flag = 1;
            Timer_update_Cal(step_motor_usr.freq);
            StepMotorDirection(step_motor_usr.dir);
            StepMotorModeCtrl(MSTART);

            break;
        case MOVE_MAX_UP:
            step_motor_usr.up_time = DOWN_STEP_TIMEOUT;
            step_motor_usr.dir = BACKWARD;
            step_motor_usr.time_start_flag = 1;
            Timer_update_Cal(step_motor_usr.freq);
            StepMotorDirection(step_motor_usr.dir);
            StepMotorModeCtrl(MSTART);

            break;        
        case MOVE_DOWN:
            step_motor_usr.dir = FORWARD;
            step_motor_usr.time_start_flag = 1;
            Timer_update_Cal(step_motor_usr.freq);
            StepMotorDirection(step_motor_usr.dir);
            StepMotorModeCtrl(MSTART);

            break;
        
        default:
        case MOVE_STOP:
            step_motor_usr.time_start_flag = 0;
            //step_motor_usr.step_motor_status = 0;
            StepMotorModeCtrl(MSTOP);
            //Timer_update_Cal(step_motor_usr.freq);
            break;

    }
   return result;
}

