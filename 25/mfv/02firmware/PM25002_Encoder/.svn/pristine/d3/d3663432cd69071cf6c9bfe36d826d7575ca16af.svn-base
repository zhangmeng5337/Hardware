#include "StepMotor.h"
#include "math.h"

extern TIM_HandleTypeDef htim15;
StepMotor_stru step_motor_usr;
unsigned char StepMotorPositionCal(void);
//update pwm freq
void Timer_update_Cal(float freq)
{
    float tmp, tmp1;
    uint32_t result;
    static uint32_t tick;

    tmp = MAIN_FREQ / freq;
    result = tmp;
    step_motor_usr.arr =  result;

__HAL_TIM_SET_COUNTER(&htim15, 0);

    __HAL_TIM_SET_AUTORELOAD(&htim15, step_motor_usr.arr);
    __HAL_TIM_SET_COMPARE(&htim15, TIM_CHANNEL_1, step_motor_usr.arr / 2);

}
//estimate step motor speed by freq

void StepMotorInit(void)
{
    step_motor_usr.max_position = 10;
    step_motor_usr.min_position = -0.048;
    step_motor_usr.ustep = 4;
    step_motor_usr.step_angle = 1.8;
    step_motor_usr.distance_one_step = 0.0122;
    step_motor_usr.distance_one_cycle =
        step_motor_usr.distance_one_step * 360;
    step_motor_usr.distance_one_cycle =
        step_motor_usr.distance_one_cycle / step_motor_usr.step_angle;
    step_motor_usr.step_motor_status = 0;
    step_motor_usr.time_start_flag = 0;
	step_motor_usr.down_time = DOWN_STEP_TIMEOUT;
  step_motor_usr.up_time = UP_STEP_TIMEOUT;
    step_motor_usr.arr = 0;
    step_motor_usr.dir = FORWARD;
    step_motor_usr.freq = 3600;//40000;//12000
    //step_motor_usr.timeout_flag = 0;
    //    step_motor_usr.mode = POS_CTRL;
    step_motor_usr.home_count = 0;
    step_motor_usr.Fopen_count = 0;
    step_motor_usr.retry_times = 2;
    //speed_cal();

    step_motor_usr.op_complete = 0;
    getStepMotor()->set_position = 10;
    step_motor_usr.state = STATE_HOME;

    Timer_update_Cal(step_motor_usr.freq);

    for (unsigned int i = 0; i < 256; i++)
        step_motor_usr.dma_buf[i] = step_motor_usr.arr / 2;
    HAL_GPIO_WritePin(MOTOR_Rst_GPIO_Port, MOTOR_Rst_Pin, GPIO_PIN_RESET);
    __HAL_TIM_SET_AUTORELOAD(&htim15, step_motor_usr.arr);
    __HAL_TIM_SET_COMPARE(&htim15, TIM_CHANNEL_1, step_motor_usr.arr / 2);
    HAL_GPIO_WritePin(MOTOR_Rst_GPIO_Port, MOTOR_Rst_Pin, GPIO_PIN_RESET);



}

void StepMotorReset(void)
{
    HAL_GPIO_WritePin(MOTOR_Rst_GPIO_Port, MOTOR_Rst_Pin, GPIO_PIN_RESET);

}
void StepMotorSet(void)
{
    HAL_GPIO_WritePin(MOTOR_Rst_GPIO_Port, MOTOR_Rst_Pin, GPIO_PIN_SET);
}
StepMotor_stru *getStepMotor()
{
    return &step_motor_usr;
}



void StepMotorDirection(unsigned char dir)
{
    step_motor_usr.dir = dir;
    if (dir == FORWARD)
    {

        HAL_GPIO_WritePin(MOTOR_Dir_GPIO_Port, MOTOR_Dir_Pin, GPIO_PIN_SET);
    }
    else
    {
        HAL_GPIO_WritePin(MOTOR_Dir_GPIO_Port, MOTOR_Dir_Pin, GPIO_PIN_RESET);
    }
}
/**
return :
0:no fault
1:driver fault
**/
unsigned char StepMotorFault()
{
    if (HAL_GPIO_ReadPin(MOTOR_Fault_GPIO_Port, MOTOR_Fault_Pin) == 0)
    {
        step_motor_usr.fault_status = 1;
    }
    else
    {
        if (step_motor_usr.fault_status == 1)
            step_motor_usr.fault_status = 0;
    }
    return step_motor_usr.fault_status ;

}

void StepMotorModeCtrl(unsigned char status)
{
    step_motor_usr.status = status;
    switch (status)
    {
        case MSTART:
            StepMotorSet();
            if (PWM_MODE == 0)
                HAL_TIM_PWM_Start(&htim15, TIM_CHANNEL_1); //?? PWM ??
            else
            {
                step_motor_usr.pwm_laod_pulse_count = step_motor_usr.pwm_total_pulse_count;
                if (step_motor_usr.pwm_total_pulse_count <= 256)

                    HAL_TIM_PWM_Start_DMA(&htim15, TIM_CHANNEL_1, (uint32_t *)step_motor_usr.dma_buf, step_motor_usr.pwm_total_pulse_count);
                else
                {
                    HAL_TIM_PWM_Start_DMA(&htim15, TIM_CHANNEL_1, (uint32_t *)step_motor_usr.dma_buf, 256);
                }

            }


            break;
        case MSTOP:

            HAL_TIM_PWM_Stop(&htim15, TIM_CHANNEL_1); //?? PWM ??
            StepMotorReset();
            break;

        default:
            StepMotorReset();
            HAL_TIM_PWM_Stop(&htim15, TIM_CHANNEL_1);
            break;
    }

}

