    switch (subindex)
    {
        case 1:
            MEMCPY(StoreParam0xFBF2.Command, pData, dataSize);
            if (strncmp(StoreParam0xFBF2.Command, "evas", 4) == 0)
            {
                // initiate NV save in here
            }
            break;
        default:
            return ABORTIDX_UNSUPPORTED_ACCESS;
            break;
    };
    return 0;
}

