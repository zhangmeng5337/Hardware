    }

    if (dataSize > 9)
    {
        return ABORTIDX_PARAM_LENGTH_TOO_LONG;
    }

    switch (subindex)
    {
        case 1:
            MEMCPY(ZeroAdjustForFlowSensor0xFB10.Command, pData, dataSize);
            break;
        default:
            return ABORTIDX_UNSUPPORTED_ACCESS;
            break;
    };
    return 0;
}

