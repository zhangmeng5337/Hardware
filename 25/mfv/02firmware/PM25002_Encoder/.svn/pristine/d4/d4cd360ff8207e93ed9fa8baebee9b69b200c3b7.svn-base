void disable_userobj(UINT16 Index)
{
    UINT16 obj = 0;
    while (ApplicationObjDic[obj].Index != 0xFFFF)
    {
        if (ApplicationObjDic[obj].Index == Index)
        {
            ApplicationObjDic[obj].Index = 0;
            return;
        }
        obj++;
    }
}

