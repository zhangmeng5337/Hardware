//update pwm freq
StepMotor_stru *get_stepMotor_status()
{
    return &step_motor_usr;
}
void Timer_update_Cal(float freq)
{
    float tmp, tmp1;
    uint32_t result;
    static uint32_t tick;
    step_motor_usr.arr =  SystemCoreClock / (TIM15PS + 1) / freq;
    __HAL_TIM_SET_COUNTER(&htim15, 0);
    __HAL_TIM_SET_AUTORELOAD(&htim15, step_motor_usr.arr);
    __HAL_TIM_SET_COMPARE(&htim15, TIM_CHANNEL_1, step_motor_usr.arr / 2);

}
//estimate step motor speed by freq
unsigned int get_stepper_motor_status()
{
    return step_motor_usr.status;
}
unsigned int set_stepper_motor_status(unsigned int status)
{
    step_motor_usr.status = step_motor_usr.status | status;
}
unsigned int reset_stepper_motor_status(unsigned int status)
{
    step_motor_usr.status = step_motor_usr.status & (~status);
}
float cal_encoder_max_pulse(float pos)
{
    float tmp;
    tmp = pos / step_motor_usr.distance_one_cycle;
    tmp = tmp * SPR;
    tmp = tmp / PULSE_RATIO; //encoder pulse count
    return tmp;

}
float cal_encoder_pulse(float pos)
{
    float tmp;
    tmp = pos+step_motor_usr.stepper_home_pos_mm;
	tmp = (pos-step_motor_usr.encoder_b)/step_motor_usr.encoder_slope;

    if (fabs(pos+step_motor_usr.stepper_home_pos_mm)<= 0.002)
        tmp  = step_motor_usr.stepper_home_encoder_count + 100;
//    if (tmp < 0)
//        tmp = 0;
//    if (tmp > PULSE_OFFSET)
//        tmp = PULSE_OFFSET + 20;
    return tmp;

}
void curve_s_init(void)
{

    curve_s_usr.set_speed = 18000;         // 目标速度
    curve_s_usr.set_acceleration = 300;   // 加速度
    curve_s_usr.set_deceleration = 250;   // 减速度
    curve_s_usr.direction = 1;
    curve_s_usr.speed = curve_s_usr.set_speed;         // 目标速度
    curve_s_usr.acceleration = curve_s_usr.set_acceleration;   // 加速度
    curve_s_usr.deceleration = curve_s_usr.set_deceleration;   // 减速度
    curve_s_usr.set_currentSpeed = 2000;
    curve_s_usr.sCurve_en = 0;//1:s curve 0：const speed
    curve_s_usr.sCurev_typ = 1;
}


