void PID_init()
{
    pid_usr.setpoint = 0.0;
    pid_usr.pv = 0.0;
    pid_usr.error = 0.0;
    pid_usr.err_k_2 = 0.0;
    pid_usr.err_k_1 = 0.0;
    pid_usr.err = 0.0;
    pid_usr.Kp = 6;                   // 需要自行整定
    pid_usr.Ki =
        0.1;                   // 注意，和普通增量，以及积分分离类型相比，这里加大了积分环节的值
    pid_usr.Kd = 0;
    pid_usr.interal = 0;
    pid_usr.crack2 = 0.001; //
    pid_usr.crack1 = 0;
    pid_usr.inter_enable = 0;
    pid_usr.umax = 1;
    pid_usr.umin = 0;
    pid_usr.cv = 0;
    pid_usr.controller_type = 1;
    pid_usr.increment = 0;

}

float ratio;
float pre_measure;
float set_point_last;
unsigned char stable_time = 0;
float err_cof = 5;
float cof2 = 0.5;
float out;
static uint32_t stable_total_time = 0;
float div3 = 1.5, div4 = 1.5, div5 = 2, div6 = 2;
static	unsigned int count = 0;
//float igainCof = 1;
unsigned char igainCofFlag;
float cof3;
float pressureUpProc(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{
    if (get_pos() > 0.06)
    {
        //  pre_measure = measurement;
        stable_time = 0;

    }
    else
    {

        if (get_pos() < 0.01 && ctrl_lcl->internal_state <= P_SLOPE_CTRL_STP1)//valve close
        {
            ctrl_lcl->slopeCtrlVal2 = meter.pressure_slope;
        }


    }

    if (ctrl_lcl->pressure_dir == 0)//start rise pressure
    {
        if (get_pos() <= 0.06 && ctrl_lcl->overShot_ctrl == 1) //rise pressure
        {

            if (stable_time++ >=  ctrl_lcl->slopeStableTime)//wait pressure stable
            {

                if ((measurement - pre_measure) >=  ctrl_lcl->slopeMinPerr1)//flow gas
                {
                    stable_time =  ctrl_lcl->slopeStableTime;
                    pre_measure = measurement;
                    ctrl_lcl->overShot_ctrl = 0;
                    ctrl_lcl->slopePoint1 = measurement;
                    ctrl_lcl->slope_flag = 1;
                }
                else
                {
                    {
                        stable_time = 0;
                        return 0;
                    }
                }
            }
        }
    }
    //    else if (ctrl_lcl->pressure_dir == 1)//down mode
    //    {
    //        ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
    //    }

    if (ctrl_lcl->pressure_dir == 0)
    {
        if (ctrl_lcl->internal_state <= P_SLOPE_CTRL_STP1)//1
        {
            if (meter.pressure_slope > 0)
            {
                ctrl_lcl->slopeCtrlVal2 = meter.pressure_slope;
                ctrl_lcl->slope_total_time = (ctrl_lcl->targetsp - measurement) * 1000 * meter.slopeCalPeriod /
                                             ctrl_lcl->slopeCtrlVal2;

                if (ctrl_lcl->slope_total_time <=  ctrl_lcl->internalSpCtrlPoint &&
                        ctrl_lcl->slope_total_time > 0)

                {
                    ctrl_lcl->slope_flag = 1;
                    if (ctrl_lcl->slope_total_time >  ctrl_lcl->internalSpCtrlPoint)
                    {
                        ctrl_lcl->internalSpStartPerc = (ctrl_lcl->slope_total_time -  ctrl_lcl->internalSpCtrlPoint) /
                                                        ctrl_lcl->slope_total_time;
                        ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                        ctrl_lcl->internalSpStartPre = measurement +  ctrl_lcl->internalSpStartPerc * (ctrl_lcl->currentsp - measurement);
                        ctrl_lcl->slopeCtrlMode = 0;

                    }
                    else
                    {
                        if (ctrl_lcl->slopeCtrlMode == 2)
                            ctrl_lcl->slopeCtrlMode = 1;
                        ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                        ctrl_lcl->internalSpStartPre = measurement;// +	ctrl_lcl->internalSpStartPerc * (ctrl_lcl->targetsp - measurement);
                    }
                }
            }
            else
            {
                ctrl_lcl->slope_total_time = 0;
            }

        }

        if (ctrl_lcl->internal_state < P_SLOPE_CTRL_STP1)  //1
        {
            if (ctrl_lcl->slope_flag == 1 ||
                    ctrl_lcl->slope_total_time <=  ctrl_lcl->internalSpCtrlPoint &&
                    ctrl_lcl->slope_total_time > 0
               )// valve close cal slope ctrl point pressure
            {

                if (ctrl_lcl->slope_total_time >  ctrl_lcl->internalSpCtrlPoint)
                {
                    ctrl_lcl->internalSpStartPerc = (ctrl_lcl->slope_total_time -  ctrl_lcl->internalSpCtrlPoint) /
                                                    ctrl_lcl->slope_total_time;
                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    ctrl_lcl->internalSpStartPre = measurement +  ctrl_lcl->internalSpStartPerc * (ctrl_lcl->currentsp - measurement);
                    ctrl_lcl->slopeCtrlMode = 0;
                    // slope_val_tmp = ctrl_lcl->slopeCtrlVal2;
                    ctrl_lcl->internal_state = P_SLOPE_CTRL_STP1;//1;
                }

                else
                {

                    ctrl_lcl->internal_state = P_SLOPE_CTRL_STP1;//1;
                    if (ctrl_lcl->slopeCtrlMode == 2)
                        ctrl_lcl->slopeCtrlMode = 1;
                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    //slope_val_tmp = ctrl_lcl->slopeCtrlVal2;
                    ctrl_lcl->internalSpStartPre = measurement;// +	ctrl_lcl->internalSpStartPerc * (ctrl_lcl->targetsp - measurement);
                }
                //ctrl_lcl->slopeCtrlVal2 =	meter.pressure_slope;
                ctrl_lcl->slope_time = 0;
                ctrl_lcl->slopePoint1 = 0;

            }
        }
    }
    else
    {
        if (ctrl_lcl->internal_state <= P_SLOPE_CTRL_STP1)
            ctrl_lcl->internal_state = P_SLOPE_CTRL_STP1;//1;
        ctrl_lcl->slope_flag = 2;
    }


    //    if (ctrl_lcl->internal_state == P_NO_SLOPE_CTRL)
    ctrl_lcl->error = ctrl_lcl->currentsp - measurement;
    //    else
    //    {
    //        ctrl_lcl->error =  ctrl_lcl->internal_sp - measurement;
    //    }



    if (ctrl_lcl->currentsp <= 1)//误差分段处理
    {
        if (ctrl_lcl->currentsp <=  ctrl_lcl->range1Sp)//10torr
        {
            ctrl_lcl->error = ctrl_lcl->error * ctrl_lcl->range10TorrC1;
            ctrl_lcl->Rang1PgainCof = nvmem.app.controllerObj.nRang1PgainCof;
        }
        else    if (ctrl_lcl->currentsp <=  ctrl_lcl->range2Sp)//30torr  50
        {
            ctrl_lcl->error = ctrl_lcl->error * ctrl_lcl->range30TorrC1;
            ctrl_lcl->Rang1PgainCof = ctrl_lcl->Rang2PgainCof;
        }
        else    if (ctrl_lcl->currentsp <=  ctrl_lcl->range3Sp)//100torr
        {

            ctrl_lcl->error = ctrl_lcl->error * ctrl_lcl->range100TorrC1;
            ctrl_lcl->Rang1PgainCof = ctrl_lcl->Rang3PgainCof;

        }
        else
        {

            ctrl_lcl->error = ctrl_lcl->error;
            ctrl_lcl->Rang1PgainCof = 1;
        }


        if (fabsf(ctrl_lcl->error) <= ctrl_lcl->errCofTh)
        {
            if (stable_total_time < 150)
                stable_total_time++;
            else
            {
                ctrl_lcl->error = ctrl_lcl->error * ctrl_lcl->cofErr;
            }
        }


    }


    static uint32_t slopeCtlrStableTime = 0;
    static unsigned char slopeStableFLag = 0;

    switch (ctrl_lcl->internal_state)
    {
        case P_NO_SLOPE_CTRL:
            // ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
            ctrl_lcl->internal_state = P_NO_SLOPE_CTRL;//0;
            break;
        case P_SLOPE_CTRL_STP1:
            //if (fabs(ctrl_lcl->targetsp) >= 0.01 &&  ctrl_lcl->slope_flag > 0 && ctrl_lcl->pressure_dir == 0)

            if (ctrl_lcl->slope_flag > 0 && ctrl_lcl->pressure_dir == 0)
            {
                if (measurement >=  ctrl_lcl->internalSpStartPre &&	ctrl_lcl->internalSpStartPre > 0)
                {
                    if (measurement < ctrl_lcl->targetsp)
                    {
                        // ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
                        ctrl_lcl->internal_state = P_SLOPE_CTRL_STP2;
                    }
                    else
                    {
                        ctrl_lcl->internal_state = P_SLOPE_CTRL_OVER;//4;
                        ctrl_lcl->pressure_dir = 1;
                    }
                }
                //else
                // ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
            }
            else
            {
                ctrl_lcl->internal_state = P_SLOPE_CTRL_STP3;//3;
                // ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
            }
            //	last_slope = meter.pressure_slope;
            //ctrlTimout = 0;

            break;
        case P_SLOPE_CTRL_STP2:
            //			 ctrl_lcl->internal_sp =  ctrl_lcl->internal_sp;
            //ctrl_lcl->internal_sp =	ctrl_lcl->targetsp;
            ctrl_lcl->internal_state = P_SLOPE_CTRL_STP2;//2;
            if (ratio >= ctrl_lcl->ratioCtrlTh || slopeStableFLag == 1) //40
                //			 if (ratio >= slope_set_val  ||
                //					 ctrl_lcl->stableTimeout >= ctrl_lcl->stableTimeTh)//40
            {
                ctrl_lcl->iterm = ctrl_lcl->pout - ctrl_lcl->Pgain * ctrl_lcl->error -
                                  ctrl_lcl->igainCof * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError) / 2; //ctrl_lcl->piterm;
                ctrl_lcl->pterm = 0;//ctrl_lcl->ppterm;
                ctrl_lcl->internal_state = P_SLOPE_CTRL_STP4;//3;
                ctrl_lcl->stableTimeout = 0;
                ctrl_lcl->rampinprogress_tmp = 0;
                slopeCtlrStableTime = 0;
                slopeStableFLag = 0;


            }
            else
            {
                static float out_last;

                if (ctrl_lcl->pout == 0)
                {
                    if (ctrl_lcl->out >= 0.95)//valve close th
                        out_last = 0.91;
                    else
                        out_last = ctrl_lcl->out;
                    ctrl_lcl->out = 0;
                }
                float changeSlopeCof;
                if (ctrl_lcl->currentsp <=	ctrl_lcl->range1Sp)//10torr
                {
                    changeSlopeCof = ctrl_lcl->range1ChangeSlopeCof;//down the overshot
                }
                else if (ctrl_lcl->currentsp <	ctrl_lcl->range2Sp)//50torr
                {
                    changeSlopeCof = ctrl_lcl->range2ChangeSlopeCof;
                }

                else if (ctrl_lcl->currentsp <=	ctrl_lcl->range3Sp)//100torr
                {
                    changeSlopeCof = ctrl_lcl->range3ChangeSlopeCof;//
                }
                else
                    changeSlopeCof = 1;

                if (ctrl_lcl->slopeCtrlVal2 > ctrl_lcl->slopeCtrlVal)
                    ctrl_lcl->pressureChangeSlope = changeSlopeCof * (ctrl_lcl->targetsp - ctrl_lcl->slopeCtrlVal2 / meter.slopeCalPeriod	*
                                                    ctrl_lcl->slopeCtrlVal3 * 0.6);
                else
                {

                    ctrl_lcl->pressureChangeSlope = changeSlopeCof * (ctrl_lcl->targetsp - ctrl_lcl->slopeCtrlVal2 /  meter.slopeCalPeriod *
                                                    ctrl_lcl->slopeCtrlVal3);

                }


                if (measurement >= ctrl_lcl->pressureChangeSlope)
                {
                    //					 if (ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeMin3 < 3 &&
                    //							 ctrl_lcl->slopeCtrlVal2 > 0)
                    //						 ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 4;
                    //					 else
                    if (ctrl_lcl->slopeCtrlVal2 > 0 &&
                            ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeMin3 < 2)
                    {
                        if (ctrl_lcl->slopeCtrlVal2 > ctrl_lcl->slopeMin3)
                            ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2; // close to set point change speed
                        else
                            ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 3;
                    }
                    else
                        ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;// close to set point change speed
                }

                else
                {
                    if (ctrl_lcl->rampinprogress_tmp == true && ctrl_lcl->rampmode != 0)
                    {
                        ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;
                        if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 2.5)
                        {

                            //						 cof2 =  ctrl_lcl->slopeCtrlMaxCof;
                            if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal &&
                                    ctrl_lcl->slopeCtrlVal2 > 0)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.5;//0.8
                            else
                            {
                                if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal &&
                                        ctrl_lcl->slopeCtrlVal2 > 0)
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * ctrl_lcl->pressLowRangSlopeCof; //ctrl_lcl->slopeCtrlVal;
                                else
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal;//
                            }

                        }

                        else
                        {
                            if (ctrl_lcl->slopeCtrlVal2 > 0)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.8;
                            else
                                ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;
                        }



                        //
                        //						 cof2 =  ctrl_lcl->slopeCtrlK / (1 + expf(ctrl_lcl->slopeCtrlB * ctrl_lcl->slopeCtrlVal2));
                        //						 if (cof2 > ctrl_lcl->slopeCtrlMaxCof)
                        //							 cof2 = ctrl_lcl->slopeCtrlMaxCof;
                        //						 if (cof2 <= ctrl_lcl->slopeCtrlMinCof)
                        //							 cof2 = ctrl_lcl->slopeCtrlMinCof;//0.2;

                    }
                    else
                    {
                        if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 2.5)
                        {

                            //						 cof2 =  ctrl_lcl->slopeCtrlMaxCof;
                            if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal &&
                                    ctrl_lcl->slopeCtrlVal2 > 0)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.8;//0.8
                            else
                            {
                                //								 if (meter.pressure_slope > 0)
                                {
                                    //									 if (meter.pressure_slope < ctrl_lcl->slopeCtrlVal)
                                    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal &&
                                            ctrl_lcl->slopeCtrlVal2 > 0)
                                        ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.8; //ctrl_lcl->slopeCtrlVal;
                                    else
                                        ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal;//
                                }
                                //								 else
                                //									 ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;//

                            }


                        }

                        else
                        {
                            if (ctrl_lcl->slopeCtrlVal2 > 0)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2;
                            else
                                ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;
                        }
                    }

                }

                unsigned char slopeEn = 0;
                float tmp4;
                tmp4 = meter.pressure_slope / ctrl_lcl->set_slope;
                if (meter.pressure_slope < ctrl_lcl->set_slope && meter.pressure_slope >= ctrl_lcl->slopeMin4)
                {
                    if (ctrl_lcl->set_slope > ctrl_lcl->slopeMin3 &&
                            meter.pressure_slope < ctrl_lcl->set_slope &&
                            meter.pressure_slope >= ctrl_lcl->slopeMin3)
                    {
                        if (fabsf(tmp4) <= 1 && fabsf(meter.pressure_slope) >=  ctrl_lcl->set_slope / 3)//3
                            //				   if (fabsf(tmp4) <= 1.2 && fabsf(tmp4) >= 0.5)

                        {
                            slopeEn = 0;
                        }
                        else
                            slopeEn = 1;

                    }
                    else
                        slopeEn = 1;

                    if (ctrl_lcl->set_slope == ctrl_lcl->slopeMin3)
                    {
                        if (meter.pressure_slope > 0)
                        {
                            if (fabsf(tmp4) <= 1 && fabsf(meter.pressure_slope) >=  ctrl_lcl->set_slope / 3)

                                //						 if (fabsf(tmp4) <= 1.1 && fabsf(tmp4) >= 0.3)
                            {


                                if (ctrl_lcl->stableTimeout >= 30)
                                {

                                    if (ratio >= 0.995) //wait stable
                                        slopeEn = 0;

                                }
                                else
                                    ctrl_lcl->stableTimeout ++;


                            }
                            else
                            {
                                ctrl_lcl->stableTimeout = 0;
                                slopeEn = 1;

                            }
                        }
                        else
                            slopeEn = 1;
                    }
                }
                else
                    slopeEn = 1;
                if (slopeEn == 1)
                {
                    if (ctrl_lcl->rampinprogress_tmp == true && ctrl_lcl->rampmode != 0)
                    {
                        if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                        {
                            //ctrl_lcl->perror = (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                            if (ctrl_lcl->slopeCtrlMode == 1)
                            {
                                err_cof = ctrl_lcl->slopeErrCof1;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / 5 * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                                else
                                    ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }
                            else
                            {
                                err_cof = ctrl_lcl->slopeErrCof2;//slopeErrCof1=5
                                ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }

                        }
                        else
                        {
                            if (ctrl_lcl->slopeCtrlMode == 1)
                            {
                                err_cof = ctrl_lcl->slopeErrCof1;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / 4	* (ctrl_lcl->set_slope - meter.pressure_slope)	;
                                else
                                    ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }
                            else
                            {
                                err_cof = ctrl_lcl->slopeErrCof1;//slopeErrCof1=5
                                //								 ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / 2 * (ctrl_lcl->set_slope - meter.pressure_slope);
                                else

                                    ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope);

                            }
                        }
                    }
                    else
                    {
                        if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                        {

                            if (ctrl_lcl->slopeCtrlMode == 1)
                            {
                                err_cof = ctrl_lcl->slopeErrCof2;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / ctrl_lcl->slopeErrCofDiv * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                                else
                                    ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }
                            else
                            {
                                err_cof = ctrl_lcl->slopeErrCof2;//slopeErrCof1=5
                                ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }
                        }
                        else
                        {

                            if (ctrl_lcl->slopeCtrlMode == 1)
                            {
                                err_cof = ctrl_lcl->slopeErrCof1;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / div5  * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                                else
                                    ctrl_lcl->perror =  err_cof / div3 * (ctrl_lcl->set_slope - meter.pressure_slope)  ;

                            }
                            else
                            {
                                err_cof = ctrl_lcl->slopeErrCof1;//slopeErrCof1=5
                                //								 ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                                if (ctrl_lcl->set_slope <= ctrl_lcl->slopeMin3)
                                    ctrl_lcl->perror =  err_cof / div6 * (ctrl_lcl->set_slope - meter.pressure_slope);
                                else

                                    ctrl_lcl->perror =  err_cof / div4 * (ctrl_lcl->set_slope - meter.pressure_slope);

                            }
                        }

                    }

                    if (ctrl_lcl->rampinprogress_tmp == true && ctrl_lcl->rampmode != 0)
                    {
                        cof2 =  ctrl_lcl->slopeCtrlK / (1 + expf(ctrl_lcl->slopeCtrlB * ctrl_lcl->slopeCtrlVal2)) / 3;
                    }
                    else
                    {
                        if (ctrl_lcl->rampinprogress_tmp == 0)
                        {
                            cof2 =  ctrl_lcl->slopeCtrlL / (1 + expf(ctrl_lcl->slopeCtrlC * ctrl_lcl->slopeCtrlVal2));
                        }
                        else
                            cof2 =  ctrl_lcl->slopeCtrlK / (1 + expf(ctrl_lcl->slopeCtrlB * ctrl_lcl->slopeCtrlVal2));

                    }
                    if (cof2 > ctrl_lcl->slopeCtrlMaxCof)
                        cof2 = ctrl_lcl->slopeCtrlMaxCof;
                    if (cof2 <= ctrl_lcl->slopeCtrlMinCof)
                        cof2 = ctrl_lcl->slopeCtrlMinCof;//0.2;

                    if (ctrl_lcl->currentsp <=  ctrl_lcl->range1Sp)//10torr
                    {
                        cof3 = ctrl_lcl->slopeMinTh1;
                    }
                    else    if (ctrl_lcl->currentsp <  ctrl_lcl->range2Sp)//30torr
                    {
                        cof3 = ctrl_lcl->slopeMinTh2;
                    }
                    else
                        cof3 = 1;
                    ctrl_lcl->piterm = ctrl_lcl->piterm + cof3 * cof2 * ctrl_lcl->pIgain * ctrl_lcl->perror;
                    ctrl_lcl->ppterm = cof2 * ctrl_lcl->pPgain * ctrl_lcl->perror;
                    ctrl_lcl->pout = ctrl_lcl->ppterm + ctrl_lcl->piterm + out_last;
                    if (ctrl_lcl->piterm >= ctrl_lcl->isath * 0.9) //积分限幅
                    {

                        if (ctrl_lcl->pout >= ctrl_lcl->isath)
                            ctrl_lcl->piterm = ctrl_lcl->isath * 0.9 ;
                    }
                    else  if (ctrl_lcl->piterm <= (ctrl_lcl->isatl - 1))
                    {
                        if (ctrl_lcl->pout <= ctrl_lcl->isatl)
                            ctrl_lcl->piterm = ctrl_lcl->isatl;
                    }
                    if (ctrl_lcl->piterm >= ctrl_lcl->isath * 0.9) //积分限幅
                    {

                        if (ctrl_lcl->pout >= ctrl_lcl->isath)
                            ctrl_lcl->piterm = ctrl_lcl->isath * 0.9 ;
                    }
                    else  if (ctrl_lcl->piterm <= (ctrl_lcl->isatl - 1))
                    {
                        if (ctrl_lcl->pout <= ctrl_lcl->isatl)
                            ctrl_lcl->piterm = ctrl_lcl->isatl;
                    }				 // if (ctrl_lcl->pout > 0.88)
                    //	ctrl_lcl->pout = 0.88;
                }
            }
            break;
        case P_SLOPE_CTRL_STP4:
            // ctrl_lcl->internal_sp =	ctrl_lcl->targetsp;
            //ctrl_lcl->pout = 0;
            ctrl_lcl->internal_state = P_SLOPE_CTRL_STP5;//4;
            break;
        case P_SLOPE_CTRL_STP5:
            // ctrl_lcl->internal_sp =	ctrl_lcl->targetsp;
            ctrl_lcl->rampinprogress_tmp = 0;
            ctrl_lcl->internal_state = P_SLOPE_CTRL_STP5;//4;
            break;
        case P_SLOPE_CTRL_STP3:
            //  ctrl_lcl->internal_sp =	ctrl_lcl->currentsp;
            ctrl_lcl->internal_state = P_SLOPE_CTRL_OVER;//4;
            break;
        case P_SLOPE_CTRL_OVER:
            //  ctrl_lcl->internal_sp =	ctrl_lcl->currentsp;
            break;
        default:
            //   ctrl_lcl->internal_sp = ctrl_lcl->currentsp;
            break;
    }

    //	 if(fabs(ctrl_lcl->set_slope - meter.pressure_slope)<= 0.02 && ctrl_lcl->internal_state == P_SLOPE_CTRL_STP2)
    //	 {
    //	   if(slopeCtlrStableTime <= 40)
    //		   {
    //	   slopeCtlrStableTime ++;
    //	   }
    //	   else
    //	   {
    //		   slopeCtlrStableTime = 0;
    //		   slopeStableFLag = 1;
    //	   }
    //  }

    //pid realized *******************************************************


    //*******************pid realize*******
    //	  if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl->pressure_dir == 1 &&
    //			 ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
    if ((ratio > 1.2 || ratio < 0.3)) //&& ctrl_lcl->currentsp >  ctrl_lcl->range1Sp
    {

        ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * ctrl_lcl->pidPgainCof;//change p speed
        if (fabsf(ctrl_lcl->pterm) >= 0.8)
        {
            if (ctrl_lcl->pterm >= 0.8)
                ctrl_lcl->pterm = 0.8;
            else
                ctrl_lcl->pterm = -0.8;
        }

        ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);
    }
    else
    {
        static float cof_tmp;
        if (ctrl_lcl->pressure_dir == 1)//down mode
        {
            if (ratio > 0.9)
            {
                if (measurement >= 0.25)
                    cof_tmp = ctrl_lcl->pidPgianCofDW / 3;

                else
                    cof_tmp = ctrl_lcl->pidPgianCofDW;
                ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * cof_tmp;
                ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);

            }
            else
            {
                cof_tmp = 1;//ctrl_lcl->pidPgianCofDW;
                ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * cof_tmp;
                ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);

            }

        }
        else
        {
            if (ctrl_lcl->internal_state != P_SLOPE_CTRL_STP2 &&
                    ctrl_lcl->internal_state != P_SLOPE_CTRL_STP3)
            {

                cof_tmp = 0;
                ctrl_lcl->pterm = ctrl_lcl->Rang1PgainCof * ctrl_lcl->Pgain * ctrl_lcl->error;
                ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);

            }


        }

    }


    // iterm process****************************************************

    if (ctrl_lcl->pressure_dir == 0)
    {
        if (ctrl_lcl->currentsp <=  ctrl_lcl->range1Sp)
        {
            ctrl_lcl->igainCof = 2;

        }
        else
        {
            if (ratio >= 0.999 && ratio <= 1.001)
                ctrl_lcl->igainCof = 0.2;//slow iterm speed after stable state
            else
                ctrl_lcl->igainCof = 1;
        }

    }
    else
    {
        if (ratio >= 1 && igainCofFlag == 0)
        {
            ctrl_lcl->igainCof = 1;//0.01;//slow iterm speed after stable state
            igainCofFlag = 1;

        }

        else
            ctrl_lcl->igainCof = 1;
        //	   igainCof = 5;
    }

    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        if (ctrl_lcl->error < 0 &&
                ctrl_lcl->internal_state != P_SLOPE_CTRL_STP2 && ctrl_lcl->internal_state != P_SLOPE_CTRL_STP3)//积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->igainCof * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  /
                              2;
        }
    }
    else if (ctrl_lcl->out < (ctrl_lcl->isatl + 0.03))
    {
        if (ctrl_lcl->error > 0 &&
                ctrl_lcl->internal_state != P_SLOPE_CTRL_STP2 && ctrl_lcl->internal_state != P_SLOPE_CTRL_STP3) //积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->igainCof * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  /
                              2;
        }
    }
    else
    {
        if ((ratio > 1.2 || ratio < 0.3) &&
                ctrl_lcl->currentsp >  ctrl_lcl->range1Sp)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->igainCof * ctrl_lcl->pidIgainCof * ctrl_lcl->Igain * (ctrl_lcl->error +
                              ctrl_lcl->pprevError)	/ 2 ;//change i speed

        }
        else
        {
            float cof_tmp2;
            if (ctrl_lcl->pressure_dir == 1)
            {

                cof_tmp2 = ctrl_lcl->pidIgainCofDW;
                if (fabsf(meter.pressure_slope) <= 0.02)
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->slopeCrack * ctrl_lcl->pidIgainCofDW * ctrl_lcl->Igain *
                                      (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

                else
                    ctrl_lcl->iterm = ctrl_lcl->iterm + cof_tmp2 * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

            }
            else
            {

                if (ctrl_lcl->internal_state != P_SLOPE_CTRL_STP2 &&
                        ctrl_lcl->internal_state != P_SLOPE_CTRL_STP3)
                {
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->igainCof * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  /
                                      2;

                }
            }

        }


    }

}




// 初始化控制器
void internalController_Init(ctrl_struct *downctrl)
{

    downctrl ->internalController.setpoint = 0.0f;
    downctrl ->internalController.target = 0.0f;
    downctrl ->internalController.ramp_active = false;
    //    downctrl ->internalController.slopeSwtichFast = ctrl.downFastSlope;//0.019;
    //    downctrl ->internalController.swtichErr = ctrl.downErrTh; //0.006;
    //    downctrl ->internalController.slopeSwtichSlow = ctrl.downSlowSlope;//0.005;

    //    downctrl ->internalController.rateMaxNorm = 0.0004;
    //    downctrl ->internalController.rateMinNorm = 0.00002;
    //    downctrl ->internalController.errGain = 1;
    //    downctrl ->internalController.errAllow = 10 / 1000.0;
    downctrl ->internalController.interlSepTh = 1.0;
    //	downctrl ->internalController.softLandTh = 10/1000.0;
    //	downctrl ->internalController.rateSepTh = 0.86;
}
float slope;
// 斜坡发生器：根据当前压力和最终目标生成动态设定值
static float Ramp_Update(ctrl_struct *downctrl, float current_pressure, float dt)
{
    // 目标变化时重置斜坡 downctrl
    if (downctrl->targetsp != downctrl->internalController.target)
    {
        downctrl->internalController.target = downctrl->targetsp;
        downctrl->internalController.setpoint = current_pressure;
        downctrl->internalController.ramp_active = true;
    }
    if (!downctrl->internalController.ramp_active)
        return downctrl->internalController.setpoint;

    float remaining = downctrl->internalController.setpoint - downctrl->internalController.target;
    if (remaining <= 0.0f)
    {
        downctrl->internalController.ramp_active = false;
        downctrl->internalController.setpoint = downctrl->internalController.target;
        return downctrl->setpoint;
    }

    float slope = (remaining > downctrl->internalController.swtichErr) ? downctrl->internalController.slopeSwtichFast :
                  downctrl->internalController.slopeSwtichSlow;
    float step = slope * dt;
    if (step > remaining)
        step = remaining;
    downctrl->internalController.setpoint -= step;

    if (downctrl->internalController.setpoint <= downctrl->internalController.target)
    {
        downctrl->internalController.setpoint = downctrl->internalController.target;
        downctrl->internalController.ramp_active = false;
    }
    return downctrl->internalController.setpoint;



    //    // 根据剩余偏差选择斜率
    //    float slope = (remaining > downctrl->swtichErr) ? downctrl->slopeSwtichFast : downctrl->slopeSwtichSlow;
    //    float step = slope * dt;
    //	float new_sp = downctrl->setpoint - step;
    //	if (new_sp < target) new_sp = target;
    //
    //		// 防超前：设定值不能比实际压力低太多
    //		if (new_sp < current_pressure - downctrl->setPerror) {
    //			new_sp = current_pressure - downctrl->setPerror;
    //			if (new_sp < target) new_sp = target;
    //		}
    //
    //		downctrl->setpoint = new_sp;
    //		if (downctrl->setpoint <= target) {
    //			downctrl->setpoint = target;
    //			downctrl->ramp_active = false;
    //		}
    //
    //    return downctrl->setpoint;
}




// 主控制函数（对外接口）
// 输入：当前压力 (0~1), 目标压力 (0~1)
// 输出：阀门控制信号 (0~1, 0=全开, 1=全关)
float PressureController_Update(float pressure, ctrl_struct *ctrl_lcl2)
{
    // 1. 生成斜坡设定值
    float setpoint = Ramp_Update(ctrl_lcl2, pressure, CTRL_PERIOD_MS / 1000.0);
    // 2. 计算误差e
    ctrl_lcl2->internalController.error = setpoint - pressure;
    // 3. PI计算正逻辑阀门开度 (0=关, 1=开)

}
// 斜坡发生器：根据当前压力和最终目标生成动态设定值

float rateSepTh;
float upPerror;
float ratioRang1Sp = 0.05;
float ratioRang2Sp = 0.05;
float ratioRang3Sp = 0.05;
float ratioRang4Sp = 0.05;
float changeSlopecof = 0.9;
float changeSlopecof2 = 0.85;
float changeSlopecof3 = 0.99;
float changeSlopecof4 = 0.98;
float changeSlopecof5 = 0.99;
float ppgainCof = 2;
float pigainCof = 8.5;
float dtCof;
static float RampRate_Update(ctrl_struct *rampRatectrl, float current_pressure, float dt)
{
    // 目标变化时重置斜坡 downctrl
    if (rampRatectrl->targetsp != rampRatectrl->internalController.target)
    {
        rampRatectrl->internalController.target = rampRatectrl->targetsp;
        rampRatectrl->internalController.setpoint = current_pressure;

        rampRatectrl->internalController.adaptive_rate = 0;
        rampRatectrl->internalController.ramp_active = true;
        rampRatectrl->internalController.adaptive_rate = rampRatectrl->ramp_rate;
        rampRatectrl->internal_state = P_NO_SLOPE_CTRL;

        upPerror = rampRatectrl->targetsp - current_pressure;
        //        if ((upPerror) > rampRatectrl->internalController.rateSepTh)
        //        {
        //
        //		}

        if (rampRatectrl->targetsp <=  rampRatectrl->range1Sp)//10torr
        {
            if (upPerror > rampRatectrl->internalController.rateSepTh)
                rateSepTh = rampRatectrl->internalController.rateSepTh * ratioRang1Sp;
            else
                rateSepTh = upPerror * ratioRang1Sp;

        }
        else    if (rampRatectrl->targetsp <  rampRatectrl->range2Sp)//30torr
        {
            if (upPerror > rampRatectrl->internalController.rateSepTh)
                rateSepTh = rampRatectrl->internalController.rateSepTh * ratioRang2Sp;
            else
                rateSepTh = upPerror * ratioRang2Sp;
        }
        else    if (rampRatectrl->targetsp <=  rampRatectrl->range3Sp)//100torr
        {

            if (upPerror > rampRatectrl->internalController.rateSepTh)
                rateSepTh = rampRatectrl->internalController.rateSepTh * ratioRang3Sp;
            else
                rateSepTh = upPerror * ratioRang3Sp;

        }
        else
        {
            if (upPerror > rampRatectrl->internalController.rateSepTh)
                rateSepTh = rampRatectrl->internalController.rateSepTh * ratioRang4Sp;
            else
                rateSepTh = upPerror * ratioRang4Sp;

        }


    }
    if (!rampRatectrl->internalController.ramp_active)
        return rampRatectrl->internalController.setpoint;

    float remaining = rampRatectrl->internalController.setpoint - rampRatectrl->internalController.target;
    if (remaining >= 0.0f)
    {
        rampRatectrl->internalController.ramp_active = false;
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
        return rampRatectrl->setpoint;
    }
    // 计算自适应速率: 误差越大, 速率越慢, 保证可跟踪
    rampRatectrl->internalController.error2 = rampRatectrl->internalController.setpoint -
            current_pressure;   // 此时误差可能为正(设定值高于实际)或负(实际已超前)
    // 我们只关心设定值高于实际的情况; 如果实际超前, 则减速至最小值
    float remaining2 = rampRatectrl->internalController.target -
                       rampRatectrl->internalController.setpoint;   // 剩余需要上升的量
    float slope;
    float step;

    // 软着陆：如果剩余偏差已经很小，直接使用固定慢速，不再使用自适应速率
    //    if (remaining2 <= rampRatectrl->internalController.softLandTh)


    if (fabsf(current_pressure - rampRatectrl->internalController.target) <= rateSepTh)
    {

        if ((rampRatectrl->internalController.target - current_pressure) <= rateSepTh)
            rampRatectrl->internalController.adaptive_rate =
                rampRatectrl->internalController.rateMinNorm +
                (rampRatectrl->ramp_rate - rampRatectrl->internalController.rateMinNorm) *
                (rampRatectrl->internalController.target - current_pressure) /
                rampRatectrl->internalController.rateSepTh;

        float step = rampRatectrl->internalController.adaptive_rate;
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.setpoint + step;

        if (rampRatectrl->internalController.setpoint > rampRatectrl->internalController.target)
            rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
    }

    else
    {

        rampRatectrl->internalController.adaptive_rate = rampRatectrl->ramp_rate + dtCof;

        if (rampRatectrl->internalController.adaptive_rate > rampRatectrl->internalController.rateMaxNorm)
            rampRatectrl->internalController.adaptive_rate = rampRatectrl->internalController.rateMaxNorm;

        if (rampRatectrl->internalController.adaptive_rate < rampRatectrl->internalController.rateMinNorm)
            rampRatectrl->internalController.adaptive_rate = rampRatectrl->internalController.rateMinNorm;
        slope = rampRatectrl->internalController.adaptive_rate;
        step = slope;

        rampRatectrl->internalController.setpoint += step;
    }

    //****************************************************


    //****************************************************************
    // 防超前约束: 设定值不能比实际压力高太多
    if (rampRatectrl->internalController.setpoint > current_pressure + rampRatectrl->internalController.errAllow)
    {
        rampRatectrl->internalController.setpoint = current_pressure + rampRatectrl->internalController.errAllow;

    }
    //*******************************************************************************
    if (rampRatectrl->internalController.setpoint >= rampRatectrl->internalController.target)
    {
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
        rampRatectrl->internalController.ramp_active = false;
    }
    return rampRatectrl->internalController.setpoint;

}
static float RampRate_UpdateByRate(ctrl_struct *rampRatectrl, float current_pressure, float dt)
{
    // 目标变化时重置斜坡 downctrl
    if (rampRatectrl->targetsp != rampRatectrl->internalController.target)
    {
        rampRatectrl->internalController.target = rampRatectrl->targetsp;
        rampRatectrl->internalController.setpoint = current_pressure;

        rampRatectrl->internalController.adaptive_rate = 0;
        rampRatectrl->internalController.ramp_active = true;
        rampRatectrl->internalController.adaptive_rate = rampRatectrl->ramp_rate;
        rampRatectrl->internal_state = P_NO_SLOPE_CTRL;




    }
    upPerror = rampRatectrl->targetsp - current_pressure;

    if (!rampRatectrl->internalController.ramp_active)
        return rampRatectrl->internalController.setpoint;

    float remaining = rampRatectrl->internalController.setpoint - rampRatectrl->internalController.target;
    if (remaining >= 0.0f)
    {
        rampRatectrl->internalController.ramp_active = false;
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
        return rampRatectrl->setpoint;
    }
    // 计算自适应速率: 误差越大, 速率越慢, 保证可跟踪
    rampRatectrl->internalController.error2 = rampRatectrl->internalController.setpoint -
            current_pressure;   // 此时误差可能为正(设定值高于实际)或负(实际已超前)
    // 我们只关心设定值高于实际的情况; 如果实际超前, 则减速至最小值
    float remaining2 = rampRatectrl->internalController.target -
                       rampRatectrl->internalController.setpoint;   // 剩余需要上升的量
    float slope;
    float step;

    // 软着陆：如果剩余偏差已经很小，直接使用固定慢速，不再使用自适应速率
    //    if (remaining2 <= rampRatectrl->internalController.softLandTh)


    if (fabsf(current_pressure - rampRatectrl->internalController.target) <= rateSepTh)
    {

        if ((rampRatectrl->internalController.target - current_pressure) <= rateSepTh)
            rampRatectrl->internalController.adaptive_rate =
                rampRatectrl->internalController.rateMinNorm +
                (rampRatectrl->ramp_rate - rampRatectrl->internalController.rateMinNorm) *
                (rampRatectrl->internalController.target - current_pressure) /
                rampRatectrl->internalController.rateSepTh;

        float step = rampRatectrl->internalController.adaptive_rate;
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.setpoint + step;

        if (rampRatectrl->internalController.setpoint > rampRatectrl->internalController.target)
            rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
    }

    else
    {

        rampRatectrl->internalController.adaptive_rate = rampRatectrl->ramp_rate + dtCof;

        if (rampRatectrl->internalController.adaptive_rate > rampRatectrl->internalController.rateMaxNorm)
            rampRatectrl->internalController.adaptive_rate = rampRatectrl->internalController.rateMaxNorm;

        if (rampRatectrl->internalController.adaptive_rate < rampRatectrl->internalController.rateMinNorm)
            rampRatectrl->internalController.adaptive_rate = rampRatectrl->internalController.rateMinNorm;
        slope = rampRatectrl->internalController.adaptive_rate;
        step = slope;

        rampRatectrl->internalController.setpoint += step;
    }

    //****************************************************


    //****************************************************************
    // 防超前约束: 设定值不能比实际压力高太多
    if (rampRatectrl->internalController.setpoint > current_pressure + rampRatectrl->internalController.errAllow)
    {
        rampRatectrl->internalController.setpoint = current_pressure + rampRatectrl->internalController.errAllow;

    }
    //*******************************************************************************
    if (rampRatectrl->internalController.setpoint >= rampRatectrl->internalController.target)
    {
        rampRatectrl->internalController.setpoint = rampRatectrl->internalController.target;
        rampRatectrl->internalController.ramp_active = false;
    }
    return rampRatectrl->internalController.setpoint;



    //    // 根据剩余偏差选择斜率
    //    float slope = (remaining > downctrl->swtichErr) ? downctrl->slopeSwtichFast : downctrl->slopeSwtichSlow;
    //    float step = slope * dt;
    //	float new_sp = downctrl->setpoint - step;
    //	if (new_sp < target) new_sp = target;
    //
    //		// 防超前：设定值不能比实际压力低太多
    //		if (new_sp < current_pressure - downctrl->setPerror) {
    //			new_sp = current_pressure - downctrl->setPerror;
    //			if (new_sp < target) new_sp = target;
    //		}
    //
    //		downctrl->setpoint = new_sp;
    //		if (downctrl->setpoint <= target) {
    //			downctrl->setpoint = target;
    //			downctrl->ramp_active = false;
    //		}
    //
    //    return downctrl->setpoint;
}

// 主控制函数（对外接口）
// 输入：当前压力 (0~1), 目标压力 (0~1)
// 输出：阀门控制信号 (0~1, 0=全开, 1=全关)
float PressureController_RampRateUpdate(float pressure, ctrl_struct *ctrl_lcl2)
{
    // 1. 生成斜坡设定值
    float setpoint = RampRate_Update(ctrl_lcl2, pressure, CTRL_PERIOD_MS / 1000.0);
    // 2. 计算误差e
    ctrl_lcl2->internalController.error = setpoint - pressure;
    // 3. PI计算正逻辑阀门开度 (0=关, 1=开)

}




// ============== 工具函数 ==============
static double clamp(double val, double lo, double hi)
{
    if (val < lo)
        return lo;
    if (val > hi)
        return hi;
    return val;
}
float restTime = 5;
double compute_decel_zone(double v_ramp, double total_delta_P)
{
    double zone_by_rate = (v_ramp * v_ramp) / (2.0 * ctrl.rampMaxDecRate) + ctrl.rampMagin;
    double zone_by_max = total_delta_P * 0.5;  // 最多不超过目标压差的一半
    float zone = fmin(zone_by_rate, zone_by_max);
    float resetP;
    resetP =  v_ramp * restTime / 100.0; //v_ramp*10*5/1000;
    if (zone > resetP)
        zone = resetP;
    else
    {
        if (zone > total_delta_P)
            zone = total_delta_P;  // 全程减速

    }


    return zone;


}



double generate_desired_rate(double delta_P)
{
    double raw;
    float v_des;

    if (delta_P > decel_zone)
    {
        raw = ctrl.ramprate / 10.0;
        decel_active = false;
    }
    else
    {
        raw = ctrl.ramprate / 10.0 * (delta_P / decel_zone);


        // 原线性减速值
        double raw_dec =  ctrl.ramprate / 10.0 * (delta_P / decel_zone);
        // 压力误差保护速率：例如 1 Torr 误差至少维持 0.3 Torr/s 的升压指令
        double raw_protect = Kp_protect * delta_P;   // Kp_protect 建议 0.2~0.5
        // 取两者最大值，确保压力偏低时有正向速率
        raw = (raw_dec > raw_protect) ? raw_dec : raw_protect;

        if (raw < ctrl.rampMinRate)
        {
            zero_rate_hold = true;
            raw = ctrl.rampMinRate;//0.02

        }

        decel_active = true;
    }
    // 滤波...
    // 一阶低通滤波，防止指令突变
    const double alpha_v = 0.2;
    v_des = alpha_v * raw + (1.0 - alpha_v) * ctrl.set_slope;
    return v_des;
}
// ============== 自适应逻辑 ==============
static void update_error_buffer(double error)
{
    error_buffer[buf_idx] = error;
    buf_idx = (buf_idx + 1) % WIN_LEN;
    if (buf_count < WIN_LEN)
        buf_count++;
}



/* ============================================================
 *  增益平滑逼近与无扰切换 (每个控制周期调用，在 PI 控制之前)
 * ============================================================ */
static void smooth_gain_update(double error)
{
    if (fabs(Kp_target - Kp) > 0.001 || fabs(Ki_target - Ki) > 0.001)
    {
        double max_dKp = ctrl.rampKpRate * CTRL_PERIOD_MS / 1000.0;
        double max_dKi = ctrl.rampKiRate * CTRL_PERIOD_MS / 1000.0;
        double dKp = Kp_target - Kp;
        double dKi = Ki_target - Ki;

        if (dKp > max_dKp)
            dKp = max_dKp;
        else if (dKp < -max_dKp)
            dKp = -max_dKp;
        if (dKi > max_dKi)
            dKi = max_dKi;
        else if (dKi < -max_dKi)
            dKi = -max_dKi;

        double new_Kp = Kp + dKp;
        double new_Ki = Ki + dKi;

        // 输出无扰：保持 u = Kp*e + Ki*integral 不变
        if (fabs(new_Ki) > 1e-9)
        {
            integral_rate = (Kp * error + Ki * integral_rate - new_Kp * error) / new_Ki;
        }
        else
        {
            integral_rate = 0.0;
        }

        Kp = new_Kp;
        Ki = new_Ki;
        Ki_old = Ki;
    }
}

/* 减速开始时主动降低增益的系数 */
#define DECEL_GAIN_FACTOR       0.6
bool decel_gain_reduced = false;  // 减速阶段是否已主动降增益
float Kp_ceiling; 
float osc_persist_cnt = 0;
void perform_adaptation(double current_v_des, double current_error)
{


    if (decel_active || lock_timer > 0.0)
        return;
//    if (fabs(current_v_des - ctrl.ramprate / 10.0) > 0.1)
//        return;
    if (buf_count < WIN_LEN)
        return;
////    // 新增：如果当前误差过大，暂时不进行任何自适应（尤其是增加增益）
////    if (fabs(current_error) > 2.0 / 10)
////        return;   // 可根据系统整定
//    // ==== 减速 / 零速率制动阶段专用逻辑 ====
//    if (decel_active || zero_rate_hold)
//    {
//        // 条件1：如果出现实际速率反向（过刹车），紧急降低增益
//        if ((current_error) > 0.5 / 10)   // 实际速率比指令低超过 0.5 Torr/s
//        {
//            Kp_target = clamp(Kp * 0.8, ctrl.rampKpMin, ctrl.rampKpMax);
//            Ki_target = clamp(Ki * 0.8, ctrl.rampKiMin, ctrl.rampKiMax);
//        }
//        // 条件2：首次进入减速，主动降至预设软增益
//
//        if (decel_active && first_decel)
//        {
//            Kp_target = clamp(Kp * 0.6, ctrl.rampKpMin, ctrl.rampKpMax);
//            Ki_target = clamp(Ki * 0.6, ctrl.rampKiMin, ctrl.rampKiMax);
//            first_decel = false;
//        }
//        // 注意：在离开减速区时（如返回恒速）要重置 first_decel 标志
//        return;  // 不走恒速段的自适应逻辑
//
//
//
//    }
//
//    // 计算均值和标准差（同前）
//    double sum = 0.0, sum_sq = 0.0;
//    for (int i = 0; i < WIN_LEN; i++)
//    {
//        double e = error_buffer[i];
//        sum += e;
//        sum_sq += e * e;
//    }
//    double mean_e = sum / WIN_LEN;
//    double var = (sum_sq / WIN_LEN) - (mean_e * mean_e);
//    if (var < 0.0)
//        var = 0.0;
//    std_e = sqrt(var);
//
//    // 决策：只计算 Kp_target, Ki_target 的乘数因子，不直接修改 Kp, Ki
//    double kp_factor = 1.0;
//    if (std_e > ctrl.rampOscH)
//    {
//        kp_factor = 0.85;          // 大幅减小
//        lock_timer = ctrl.rampLockTime;
//    }
//    else if (std_e > ctrl.rampOscL && fabs(mean_e) < ctrl.rampMeanT)
//    {
//        kp_factor = 0.95;          // 小幅减小
//    }
//    else if (std_e < ctrl.rampSteadyTh && fabs(mean_e) > ctrl.rampQTh)
//    {
//        kp_factor = 1.02;          // 缓慢增加   && Q > Q_THRESHOLD
//    }
//    // 其他情况 kp_factor = 1.0，不变
//
//    if (kp_factor != 1.0)
//    {
//        double new_Kp = clamp(Kp * kp_factor, ctrl.rampKpMin, ctrl.rampKpMax);
//        double new_Ki = clamp(Ki * kp_factor, ctrl.rampKiMin, ctrl.rampKiMax);
//        // 如果不变，跳过
//        if (fabs(new_Kp - Kp) > 0.001 || fabs(new_Ki - Ki) > 0.001)
//        {
//            Kp_target = new_Kp;
//            Ki_target = new_Ki;
//        }
//    }
//
//    // 最终限幅
//    Kp_target = clamp(Kp_target, ctrl.rampKpMin, ctrl.rampKpMax);
//    Ki_target = clamp(Ki_target, ctrl.rampKiMin, ctrl.rampKiMax);

	//*************************************************************************
	 // ---------- 计算均值和标准差 ----------
    double sum = 0.0, sum_sq = 0.0;
    for (int i = 0; i < WIN_LEN; i++) {
        double e = error_buffer[i];
        sum += e;
        sum_sq += e * e;
    }
    double mean_e = sum / WIN_LEN;
    double var = (sum_sq / WIN_LEN) - (mean_e * mean_e);
    if (var < 0.0) var = 0.0;
    double std_e = sqrt(var);

    // ---------- 减速 / 零速率保持阶段 ----------
    if (decel_active || zero_rate_hold) {
        // 仅根据标准差判断是否振荡 (不论均值)
        if (std_e > ctrl.rampOscL) {
            double new_Kp = clamp(Kp * 0.95, ctrl.rampKpMin, Kp_ceiling);
            double new_Ki = clamp(Ki * 0.95, ctrl.rampKiMin, ctrl.rampKiMax);
            Kp_target = new_Kp;
            Ki_target = new_Ki;
        }
        // 减速段绝对不增加增益，也不参与持续振荡计数
        osc_persist_cnt = 0;
        return;
    }

    // ---------- 恒速段自适应 ----------
    if (std_e > ctrl.rampOscH) {
        osc_persist_cnt++;
        if (osc_persist_cnt >= 3) {
            // 连续剧烈振荡，大幅砍增益并压缩上限
            Kp_target = clamp(Kp * 0.5, ctrl.rampKpMin, Kp_ceiling);
            Ki_target = clamp(Ki * 0.5, ctrl.rampKiMin, ctrl.rampKiMax);
            Kp_ceiling = Kp_target * 1.2;   // 短期内上限仅略高于当前值
            if (Kp_ceiling < ctrl.rampKpMin) Kp_ceiling = ctrl.rampKpMin;
            lock_timer = ctrl.rampLockTime;
            osc_persist_cnt = 0;            // 重置计数器
        } else {
            Kp_target = clamp(Kp * 0.85, ctrl.rampKpMin, Kp_ceiling);
            Ki_target = clamp(Ki * 0.85, ctrl.rampKiMin, ctrl.rampKiMax);
            lock_timer = ctrl.rampLockTime;
        }
    } else if (std_e > ctrl.rampOscL && fabs(mean_e) < ctrl.rampMeanT) {
        // 轻微振荡，小步减小
        osc_persist_cnt = 0;
        Kp_target = clamp(Kp * 0.95, ctrl.rampKpMin, Kp_ceiling);
        Ki_target = clamp(Ki * 0.95, ctrl.rampKiMin, ctrl.rampKiMax);
    } else {
        // 平稳段：重置持续振荡计数，并缓慢释放增益上限
        osc_persist_cnt = 0;
        Kp_ceiling += (ctrl.rampKpMax - Kp_ceiling) * 0.02;  // 每次恢复2%
        if (Kp_ceiling > ctrl.rampKpMax) Kp_ceiling = ctrl.rampKpMax;

        if (std_e < ctrl.rampSteadyTh) {
            double Q = 0.9 * Q_prev + 0.1 * fabs(mean_e);
            if (Q > ctrl.rampQTh && fabs(mean_e) < 0.8) {
                Kp_target = clamp(Kp * 1.03, ctrl.rampKpMin, Kp_ceiling);  // 增加时受上限约束
                Ki_target = clamp(Ki * 1.03, ctrl.rampKiMin, ctrl.rampKiMax);
            }
            Q_prev = Q;
        }
    }

    // ---------- 强制性能恢复 (防止 Kp 过小) ----------
    if (Kp <= ctrl.rampKpMin + 0.1 && fabs(mean_e) > 0.5 && std_e < ctrl.rampSteadyTh) {
        Kp_target = ctrl.rampKpOri * 0.8;
        Ki_target = Ki * (Kp_target / Kp);
        if (Ki_target < ctrl.rampKiMin) Ki_target = ctrl.rampKiMin;
        lock_timer = 3.0;
        // 同时适当提升上限
        Kp_ceiling = Kp_target * 1.5;
        if (Kp_ceiling > ctrl.rampKpMax) Kp_ceiling = ctrl.rampKpMax;
    }

    // ---------- 最终限幅 ----------
    Kp_target = clamp(Kp_target, ctrl.rampKpMin, Kp_ceiling);
    Ki_target = clamp(Ki_target, ctrl.rampKiMin, ctrl.rampKiMax);
}
// ============== 瞬时保护 (每个周期检查) ==============


static void instant_protection(double error)
{
    if (fabs(error) > ctrl.rampInstabliTh)
    {
        double old_Kp = Kp, old_Ki = Ki;
        Kp = clamp(Kp * 0.7, ctrl.rampKpMin, ctrl.rampKpMax);
        Ki = clamp(Ki * 0.7, ctrl.rampKiMin, ctrl.rampKiMax);
        lock_timer = ctrl.rampLockTime;
        // 输出无扰补偿
        if (fabs(Ki) > 1e-9)
        {
            integral_rate = (old_Kp * error + old_Ki * integral_rate - Kp * error) / Ki;
        }
        else
        {
            integral_rate = 0.0;
        }
        Ki_old = Ki;
        // 同步更新目标值
        Kp_target = Kp;
        Ki_target = Ki;

    }
}

float pperror = 0.01;
float ratioB = 0.992;
float ranage1000 = 1.5;
float alpha = 0.2;

float pressureRampProc(ctrl_struct *ctrl_lcl2, float tpsidiff, float measurement)
{

    float cof4 = 0.03, cof5 = 0.08;

    static uint32_t slopeCtlrStableTime = 0;
    static unsigned char slopeStableFLag = 0;


    // 2. 进入速率控制的条件：压力接近目标（例如误差 < 5 Torr）且仍高于目标
    //    if (ctrl_lcl2->internalController.ramp_active == 1)
    //    {
    //        ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP2;
    //    }

    // PressureController_RampRateUpdate(measurement, ctrl_lcl2);

    ctrl_lcl2->error = ctrl_lcl2->targetsp - measurement;





    //pid realized *******************************************************


    if (ctrl_lcl2->currentsp <= 1)//误差分段处理
    {
        if (ctrl_lcl2->currentsp <=	ctrl_lcl2->range1Sp)//10torr
        {
            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range10TorrC1;
        }
        else    if (ctrl_lcl2->currentsp <=  ctrl_lcl2->range2Sp)//30torr
        {
            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range30TorrC1;
        }
        else    if (ctrl_lcl2->currentsp <= ctrl_lcl2->range3Sp)//100torr
        {

            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range100TorrC1;

        }
        else
        {

            ctrl_lcl2->error = ctrl_lcl2->error*ranage1000;
        }
    }
    if (lock_timer > 0.0)
        lock_timer -= CTRL_PERIOD_MS / 1000.0;
    delta_P = ctrl_lcl2->targetsp - measurement;


    if (ctrl_lcl2->internal_state <= P_SLOPE_CTRL_STP2)
    {
        //update_decel_zone(ctrl_lcl2->ramprate/1000.0, double total_delta_P)
       
        float slope_tmp;
        slope_tmp = alpha * ctrl_lcl2->set_slope + (1.0 - alpha) * meter.pressure_slope ;
        ctrl_lcl2->set_slope = generate_desired_rate(delta_P);

        error_rate = ctrl_lcl2->set_slope - slope_tmp;//meter.pressure_slope;

        // 瞬时保护 (每个周期)
        // if (debugEn == 0)
        instant_protection(error_rate);

        // 更新误差缓冲区 (供自适应使用)
        update_error_buffer(error_rate);
        // 增益平滑逼近 (必须在速率 PI 计算之前，确保输出连续)
        smooth_gain_update(error_rate);
        // 自适应更新 (按时间间隔)
        if ((now - last_adapt_time) >= ctrl_lcl2->rampAdatpInter && debugEn == 0)
        {
            last_adapt_time = 0;
            now = 0;
            perform_adaptation(ctrl_lcl2->set_slope, error_rate);
        }
        now++;

    }

    // 切换判断：压力误差小、实际速率小、期望速率归零
    if (ratio >= ratioB)
    {
        stage = STAGE_PID;
        stable_cnt = 0;
        first_decel = true;
        zero_rate_hold = false;

    }
    else
    {
        if (fabs(delta_P) < ctrl.rampPressToler &&
                (fabs(meter.pressure_slope) < ctrl.rampRateToler &&
                 ctrl_lcl2->set_slope < 0.03)
           )
        {
            stable_cnt++;
            if (stable_cnt >= ctrl.rampStableCnt)
            {
                // 无扰切换至压力PID
                //	init_pressure_pid(u, delta_P);
                stage = STAGE_PID;
                stable_cnt = 0;
                first_decel = true;
                zero_rate_hold = false;
            }
        }
        else
        {
            stable_cnt = 0;
        }

    }

    ctrl_lcl2->perror = error_rate;

    //     rate_controller_update(ctrl_lcl,  tpsidiff,  measurement);
    switch (ctrl_lcl2->internal_state)
    {
        case P_NO_SLOPE_CTRL:
            if (stage == STAGE_RAMP)
            {
                //	ctrl_lcl2->internal_sp = ctrl_lcl2->currentsp;
                ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP2;//0;
                ctrl_lcl2->piterm = ctrl_lcl2->out - Kp  * ctrl_lcl2->perror -
                                    Ki * ctrl_lcl2->perror; //ctrl_lcl->piterm;

                ctrl_lcl2->ppterm = 0;//ctrl_lcl->ppterm;
                ctrl_lcl2->pout = ctrl_lcl2->out;
                u_last = ctrl_lcl2->pout;
            }


            break;
        case P_SLOPE_CTRL_STP2:

            if (stage == STAGE_RAMP)
            {
                // poutLast = ctrl_lcl2->pout;

                {
                    static float out_last;

                    if (ctrl_lcl2->pout == 0)
                    {
                        if (ctrl_lcl2->out >= 0.95)//valve close th
                            out_last = 0.91;
                        else
                            out_last = ctrl_lcl2->out;
                        ctrl_lcl2->out = 0;
                        out_last = 0;
                    }
                    // ============== 速率计算与滤波 ==============
                    unsigned char slopeEn = 0;
                    if (fabsf(ctrl_lcl2->perror) <= pperror)
                    {
                        if (pperror > 0)
                            slopeEn = 1;
                        else
                            slopeEn = 0;

                    }
                    else
                    {
                        slopeEn = 1;

                    }
                    if (slopeEn == 1)
                    {
                        ctrl_lcl2->piterm = ctrl_lcl2->piterm + Ki * ctrl_lcl2->perror;
                        ctrl_lcl2->ppterm =  Kp * ctrl_lcl2->perror;

                    }

                    ctrl_lcl2->pout = ctrl_lcl2->ppterm + ctrl_lcl2->piterm;

                    // 输出变化率限制

                    if (debugEn == 0)
                        max_du = ctrl_lcl2->rampMaxDu * CTRL_PERIOD_MS / 1000.0;
                    else
                        max_du = (ctrl_lcl2->rampMaxDu + 0.12) * CTRL_PERIOD_MS / 1000.0;
                    double du =  ctrl_lcl2->pout - u_last;
                    if (du > max_du)
                        ctrl_lcl2->pout = u_last + max_du;
                    else if (du < -max_du)
                        ctrl_lcl2->pout = u_last - max_du;

                    //ctrl_lcl2->pout =  clamp(ctrl_lcl2->pout, VALVE_MIN, VALVE_MAX);



                    if (ctrl_lcl2->piterm >= ctrl_lcl2->isath * 0.9) //积分限幅
                    {

                        if (ctrl_lcl2->pout >= ctrl_lcl2->isath)
                            ctrl_lcl2->piterm = ctrl_lcl2->isath * 0.9 ;
                    }
                    else	  if (ctrl_lcl2->piterm <= (ctrl_lcl2->isatl - 1))
                    {
                        if (ctrl_lcl2->pout <= ctrl_lcl2->isatl)
                            ctrl_lcl2->piterm = ctrl_lcl2->isatl;
                    }
                    if (ctrl_lcl2->piterm >= ctrl_lcl2->isath * 0.9) //积分限幅
                    {

                        if (ctrl_lcl2->pout >= ctrl_lcl2->isath)
                            ctrl_lcl2->piterm = ctrl_lcl2->isath * 0.9 ;
                    }
                    else	  if (ctrl_lcl2->piterm <= (ctrl_lcl2->isatl - 1))
                    {
                        if (ctrl_lcl2->pout <= ctrl_lcl2->isatl)
                            ctrl_lcl2->piterm = ctrl_lcl2->isatl;
                    } 			 // if (ctrl_lcl->pout > 0.88)
                    if (ctrl_lcl2->pout >= (ctrl_lcl2->isath * 0.92))
                    {
                        ctrl_lcl2->pout = ctrl_lcl2->isath * 0.92 ;
                    }
                    else if (ctrl_lcl2->pout <= (ctrl_lcl2->isatl))
                    {
                        ctrl_lcl2->pout = ctrl_lcl2->isatl ;
                    }

                    if (ctrl_lcl2->piterm >= ctrl_lcl2->isath * 0.9) //积分限幅
                        ctrl_lcl2->piterm = ctrl_lcl2->isath * 0.9 ;
                    if (ctrl_lcl2->piterm <= (ctrl_lcl2->isatl - 1))
                        ctrl_lcl2->piterm = ctrl_lcl2->isatl;

                    u_last = ctrl_lcl2->pout;
                }
            }
            else
            {
                //ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP2;//4;
                tmpPout = ctrl_lcl2->pout;
                tmpError = ctrl_lcl2->error;
                tmpI1 = ctrl_lcl2->iterm;
                ctrl_lcl2->iterm = ctrl_lcl2->pout - ctrl_lcl2->pidPgainCof2 * ctrl_lcl2->Pgain * ctrl_lcl2->error -
                                   ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error + ctrl_lcl2->pprevError) / 2; //ctrl_lcl->piterm;
                tmpI2 = ctrl_lcl2->iterm;


                ctrl_lcl2->pterm = 0;//ctrl_lcl->ppterm;
                ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP4;//3;
                ctrl_lcl2->stableTimeout = 0;
                ctrl_lcl2->rampinprogress_tmp = 0;
                slopeCtlrStableTime = 0;
                slopeStableFLag = 0;

            }
            break;
        // case P_SLOPE_CTRL_STP2:


        //break;
        case P_SLOPE_CTRL_STP4:
            //  ctrl_lcl2->internal_sp =	ctrl_lcl2->targetsp;
            ctrl_lcl2->pout = 0;

            ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP5;//4;
            break;
        case P_SLOPE_CTRL_STP5:
            // ctrl_lcl2->internal_sp =	ctrl_lcl2->targetsp;
            if (ctrl_lcl2->rampinprogress_tmp == true)
                tmpI3 = ctrl_lcl2->iterm;
            ctrl_lcl2->rampinprogress_tmp = 0;
            ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP5;//4;


            break;
        case P_SLOPE_CTRL_STP3:
            // ctrl_lcl2->internal_sp =	ctrl_lcl2->currentsp;
            ctrl_lcl2->internal_state = P_SLOPE_CTRL_OVER;//4;
            break;
        case P_SLOPE_CTRL_OVER:
            //ctrl_lcl2->internal_sp =	ctrl_lcl2->currentsp;
            break;
        default:
            // ctrl_lcl2->internal_sp = ctrl_lcl2->currentsp;
            break;
    }



    ctrl_lcl2->pterm = ctrl_lcl2->pidPgainCof2 * ctrl_lcl2->Pgain * ctrl_lcl2->error;
    ctrl_lcl2->dterm = ctrl_lcl2->Dgain * (ctrl_lcl2->error - ctrl_lcl2->pprevError);


    // iterm process****************************************************

    if (ctrl_lcl2->currentsp <  ctrl_lcl2->range1Sp)
    {
        ctrl_lcl2->igainCof = 2;
    }
    else   if (ctrl_lcl2->currentsp <  ctrl_lcl2->range2Sp)
    {
        ctrl_lcl2->igainCof = 2;
    }
    else
    {
        if (ratio >= 0.999 && ratio <= 1.001)
            ctrl_lcl2->igainCof = 0.5;//slow iterm speed after stable state
        else
            ctrl_lcl2->igainCof = 1;

    }




    ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof *  ctrl_lcl2->Igain * (ctrl_lcl2->error +
                       ctrl_lcl2->pprevError)	/ 2 ;//change i speed

    if (ctrl_lcl2->out >= ctrl_lcl2->isath * 0.95)
    {
        if (ctrl_lcl2->error < 0) //积分抗饱和
        {
            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
                               ctrl_lcl2->pprevError)  / 2;
        }
    }
    else if (ctrl_lcl2->out < (ctrl_lcl2->isatl + 0.03))
    {
        if (ctrl_lcl2->error > 0)  //积分抗饱和
        {
            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
                               ctrl_lcl2->pprevError)  / 2;
        }
    }
    //    else
    //    {
    //        if (fabsf(ctrl_lcl2->error) <= ctrl_lcl2->internalController.interlSepTh)
    //            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
    //                               ctrl_lcl2->pprevError)  / 2;
    //    }

    if (ctrl_lcl2->iterm >= ctrl_lcl2->isath * 0.9) //积分限幅
    {

        //        if (ctrl_lcl2->out >= ctrl_lcl2->isath)
        ctrl_lcl2->iterm = ctrl_lcl2->isath * 0.9 ;
    }
    else  if (ctrl_lcl2->iterm <= (ctrl_lcl2->isatl - 1))
    {
        //        if (ctrl_lcl2->out <= ctrl_lcl2->isatl)
        ctrl_lcl2->iterm = ctrl_lcl2->isatl;
    }
    if (ctrl_lcl2->iterm >= ctrl_lcl2->isath * 0.9) //积分限幅
    {

        if (ctrl_lcl2->out >= ctrl_lcl2->isath)
            ctrl_lcl2->iterm = ctrl_lcl2->isath * 0.9 ;
    }
    else  if (ctrl_lcl2->iterm <= (ctrl_lcl2->isatl - 1))
    {
        if (ctrl_lcl2->out <= ctrl_lcl2->isatl)
            ctrl_lcl2->iterm = ctrl_lcl2->isatl;
    }


}

float pressureDownProc(ctrl_struct *ctrl_lcl2, float tpsidiff, float measurement)
{


    static uint32_t slopeCtlrStableTime = 0;
    static unsigned char slopeStableFLag = 0;


    // 2. 进入速率控制的条件：压力接近目标（例如误差 < 5 Torr）且仍高于目标
    if (ctrl_lcl2->internalController.ramp_active == 1)
    {
        ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP2;
    }

    PressureController_Update(measurement, ctrl_lcl2);

    ctrl_lcl2->error = ctrl_lcl2->internalController.error;
    ctrl_lcl2->pout = 0;



    //pid realized *******************************************************


    if (ctrl_lcl2->currentsp <= 1)//误差分段处理
    {
        if (ctrl_lcl2->currentsp <=	ctrl_lcl2->range1Sp)//10torr
        {
            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range10TorrC1;
        }
        else    if (ctrl_lcl2->currentsp <=  ctrl_lcl2->range2Sp)//30torr
        {
            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range30TorrC1;
        }
        else    if (ctrl_lcl2->currentsp <= ctrl_lcl2->range3Sp)//100torr
        {

            ctrl_lcl2->error = ctrl_lcl2->error *   ctrl_lcl2->range100TorrC1;

        }
        else
        {

            ctrl_lcl2->error = ctrl_lcl2->error;
        }


        if (fabsf(ctrl_lcl2->error) <= ctrl_lcl2->errCofTh)
        {
            if (stable_total_time < 150)
                stable_total_time++;
            else
            {
                ctrl_lcl2->error = ctrl_lcl2->error * ctrl_lcl2->cofErr;
            }
        }


    }




    //     rate_controller_update(ctrl_lcl,  tpsidiff,  measurement);
    switch (ctrl_lcl2->internal_state)
    {
        case P_NO_SLOPE_CTRL:
            //  ctrl_lcl2->internal_sp = ctrl_lcl2->currentsp;
            ctrl_lcl2->internal_state = P_NO_SLOPE_CTRL;//0;
            break;
        case P_SLOPE_CTRL_STP2:
            if (ctrl.internalController.ramp_active == 1)
            {
                ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP2;//4;
            }

            else
            {

                //                downctrl.integral = ctrl_lcl2->out - downctrl.error*downctrl.kp*CTRL_PERIOD_MS/1000.0;

                //				ctrl_lcl2->iterm = ctrl_lcl2->pout - ctrl_lcl2->Pgain * ctrl_lcl2->error -
                //                                  igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error + ctrl_lcl2->pprevError) / 2; //ctrl_lcl->piterm;

                //ctrl_lcl2->iterm = ctrl_lcl2->iterm + igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error + ctrl_lcl2->pprevError)	/ 2;
                ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP4;//4;
                ctrl_lcl2->pout = 0;

            }

            break;
        case P_SLOPE_CTRL_STP4:
            //  ctrl_lcl2->internal_sp =	ctrl_lcl2->targetsp;
            //ctrl_lcl2->pout = 0;
            ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP5;//4;
            break;
        case P_SLOPE_CTRL_STP5:
            // ctrl_lcl2->internal_sp =	ctrl_lcl2->targetsp;
            ctrl_lcl2->rampinprogress_tmp = 0;
            ctrl_lcl2->internal_state = P_SLOPE_CTRL_STP5;//4;
            break;
        case P_SLOPE_CTRL_STP3:
            // ctrl_lcl2->internal_sp =	ctrl_lcl2->currentsp;
            ctrl_lcl2->internal_state = P_SLOPE_CTRL_OVER;//4;
            break;
        case P_SLOPE_CTRL_OVER:
            //ctrl_lcl2->internal_sp =	ctrl_lcl2->currentsp;
            break;
        default:
            // ctrl_lcl2->internal_sp = ctrl_lcl2->currentsp;
            break;
    }




    //*******************pid realize*******
    //	  if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl2->pressure_dir == 1 &&
    //			 ctrl_lcl2->targetsp >  ctrl_lcl2->range1Sp)
    if ((ratio > 1.2 || ratio < 0.3)) //&& ctrl_lcl2->currentsp >  ctrl_lcl2->range1Sp
    {

        ctrl_lcl2->pterm = ctrl_lcl2->pidPgianCofDW * ctrl_lcl2->Pgain * ctrl_lcl2->error ; //change p speed
        if (fabsf(ctrl_lcl2->pterm) >= 0.8)
        {
            if (ctrl_lcl2->pterm >= 0.8)
                ctrl_lcl2->pterm = 0.8;
            else
                ctrl_lcl2->pterm = -0.8;
        }

        ctrl_lcl2->dterm = ctrl_lcl2->Dgain * (ctrl_lcl2->error - ctrl_lcl2->pprevError);
    }
    else
    {
        static float cof_tmp;
        {
            //            if (ctrl_lcl2->internal_state != P_SLOPE_CTRL_STP2 &&
            //                    ctrl_lcl2->internal_state != P_SLOPE_CTRL_STP3)
            {

                cof_tmp = 0;

                ctrl_lcl2->pterm = ctrl_lcl2->Pgain * ctrl_lcl2->error;
                ctrl_lcl2->dterm = ctrl_lcl2->Dgain * (ctrl_lcl2->error - ctrl_lcl2->pprevError);

            }

        }

    }


    // iterm process****************************************************

    if (ctrl_lcl2->currentsp <  ctrl_lcl2->range1Sp)
    {
        ctrl_lcl2->igainCof = 2;
    }
    else   if (ctrl_lcl2->currentsp <  ctrl_lcl2->range2Sp)
    {
        ctrl_lcl2->igainCof = 2;
    }
    else
    {
        if (ratio >= 0.999 && ratio <= 1.001)
            ctrl_lcl2->igainCof = 0.2;//slow iterm speed after stable state
        else
            ctrl_lcl2->igainCof = 1;

    }





    if (ctrl_lcl2->out >= ctrl_lcl2->isath * 0.95)
    {
        if (ctrl_lcl2->error < 0) //积分抗饱和
        {
            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
                               ctrl_lcl2->pprevError)  / 2;
        }
    }
    else if (ctrl_lcl2->out < (ctrl_lcl2->isatl + 0.03))
    {
        if (ctrl_lcl2->error > 0)  //积分抗饱和
        {
            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
                               ctrl_lcl2->pprevError)  / 2;
        }
    }
    else
    {
        if ((ratio > 1.2 || ratio < 0.3) &&
                ctrl_lcl2->currentsp >  ctrl_lcl2->range1Sp)
        {
            ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->pidIgainCof * ctrl_lcl2->Igain *
                               (ctrl_lcl2->error +
                                ctrl_lcl2->pprevError)	/ 2 ;//change i speed

        }
        else
        {
            float cof_tmp2;
            //            if (ctrl_lcl2->pressure_dir == 1)
            //            {
            //
            //                cof_tmp2 = ctrl_lcl2->pidIgainCofDW;
            //                if (fabsf(meter.pressure_slope) <= 0.02)
            //                    ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->slopeCrack * ctrl_lcl2->pidIgainCofDW * ctrl_lcl2->Igain *
            //                                      (ctrl_lcl2->error + ctrl_lcl2->pprevError)  / 2 ;
            //
            //                else
            //                    ctrl_lcl2->iterm = ctrl_lcl2->iterm + cof_tmp2 * ctrl_lcl2->Igain * (ctrl_lcl2->error + ctrl_lcl2->pprevError)  / 2 ;
            //
            //            }
            //            else
            {

                {
                    ctrl_lcl2->iterm = ctrl_lcl2->iterm + ctrl_lcl2->igainCof * ctrl_lcl2->Igain * (ctrl_lcl2->error +
                                       ctrl_lcl2->pprevError)  / 2;

                }
            }
        }
    }
}
void stateReset()
{
    set_point_last = 0;
    ctrl.internalController.ramp_active = 0;
    ctrl.internalController.target = -0.1;
    igainCofFlag = 0;
    ctrl.slopeCtrlMode = 2;
    ctrl.slope_flag = 0;
    ctrl.slope_pre = 0;
    ctrl.internalSpStartPre = 0;
    ctrl.slope_total_time = 0;
    ctrl.internal_state = P_NO_SLOPE_CTRL;//0;
    //		  ctrl_lcl->slopeCtrlEn = 2;
    //pre_measure = measurement;
    ctrl.piterm = 0;
    ctrl.ppterm = 0;
    ctrl.pout = 0;
    ctrl.slope_time = 0;
    ctrl.stableTimeout = 0;
    ctrl.slopeCtrlVal2 = 0;
    ctrl.rampinprogress_tmp = 0;
    stable_total_time = 0;
    count = 0;
    ctrl.internalController.internalControllerFlag = 0;
    ctrl.internalController.ramp_active = 0;
    ctrl.internalController.target = -0.1;

}
float lastRate;
float type11(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{

    if (set_point_last != ctrl_lcl->targetsp && measurement != 0) //setpoint init
    {

        // ctrl_lcl->slopeCtrlVal3 = 0.75;
        igainCofFlag = 0;
        ctrl_lcl->slopeCtrlMode = 2;
        ctrl_lcl->slope_flag = 0;
        ctrl_lcl->slope_pre = 0;
        ctrl_lcl->internalSpStartPre = 0;
        ctrl_lcl->slope_total_time = 0;
        ctrl_lcl->internal_state = P_NO_SLOPE_CTRL;//0;
        //        ctrl_lcl->slopeCtrlEn = 2;
        pre_measure = measurement;
        P_prev = measurement;
        ctrl_lcl->piterm = 0;
        ctrl_lcl->ppterm = 0;
        ctrl_lcl->pout = 0;
        ctrl_lcl->slope_time = 0;
        ctrl_lcl->stableTimeout = 0;
        ctrl_lcl->slopeCtrlVal2 = 0;
        ctrl_lcl->rampinprogress_tmp = 0;
        stable_total_time = 0;
        count = 0;
        ctrl_lcl->internalController.internalControllerFlag = 0;
        ctrl.internalController.ramp_active = 0;
        ctrl.internalController.target = -0.1;

        // 计算初始减速区
        buf_count = 0;
        //	kpSetP = ctrl_lcl->rampKpOri;
        //kiSetI = ctrl_lcl->rampKiOri;
        if(lastRate != ctrl_lcl->ramprate)
        {
        	Kp =  ctrl_lcl->rampKpOri;
        	Ki =  ctrl_lcl->rampKiOri;
			lastRate = ctrl_lcl->ramprate;

		}

		Kp_ceiling = ctrl_lcl->rampKpMax;
        decel_gain_reduced = false;
        first_decel = true;
        zero_rate_hold = false;

        double total_delta = ctrl_lcl->targetsp - P_prev;
        if (total_delta < 0)
            total_delta = 0;
        stage = STAGE_RAMP;
        if (debugEn == 0)
            decel_zone = compute_decel_zone(ctrl_lcl->ramprate / 10.0, total_delta);
        //stable_time  = 0;
        if (measurement > ctrl_lcl->targetsp)
        {
            ctrl_lcl->pressure_dir = 1;//dec pressure
            //ctrl_lcl->internal_state = P_SLOPE_CTRL_STP1;
        }
        else
        {
            ctrl_lcl->pressure_dir = 0; //inc pressure
        }
        set_point_last = ctrl_lcl->targetsp;
    }//end setpoint init
    else
    {
        if (measurement == 0) //setpoint init
            return 0;

    }


    if (ctrl_lcl->rampinprogress == true)//ramp ctrl
    {
        ctrl_lcl->rampinprogress_tmp = 1;
    }

    ratio = measurement / ctrl_lcl->targetsp;

    //    if (ctrl_lcl->internal_state >= P_SLOPE_CTRL_STP1)//1
    //    {
    //        ctrl_lcl->interal_sp_ratio = measurement /  ctrl_lcl->internal_sp;
    //    }
    //    else
    //        ctrl_lcl->interal_sp_ratio = ratio;


    if (ctrl_lcl->pressure_dir == 0)
    {
        if (ctrl_lcl->rampinprogress_tmp == true && ctrl_lcl->rampmode != 0 ||
                ctrl_lcl->internalController.internalControllerFlag == 1)
        {
            pressureRampProc(ctrl_lcl, tpsidiff, measurement);
            if (ctrl_lcl->rampinprogress_tmp == true && ctrl_lcl->rampmode != 0)
                ctrl_lcl->internalController.internalControllerFlag = 1;

        }
        else
            pressureUpProc(ctrl_lcl, tpsidiff, measurement);

    }
    else
    {
        pressureDownProc(ctrl_lcl, tpsidiff, measurement);

    }

    //ctrl_lcl->iterm = ctrl_lcl->iterm +  comp_out *  igain_cof;
    if (ctrl_lcl->iterm >= ctrl_lcl->isath * 0.9) //积分限幅
    {

        if (ctrl_lcl->out >= ctrl_lcl->isath)
            ctrl_lcl->iterm = ctrl_lcl->isath * 0.9 ;
    }
    else  if (ctrl_lcl->iterm <= (ctrl_lcl->isatl - 1))
    {
        if (ctrl_lcl->out <= ctrl_lcl->isatl)
            ctrl_lcl->iterm = ctrl_lcl->isatl;
    }


    if (ctrl_lcl->pout >= (ctrl_lcl->isath * 0.92))
    {
        ctrl_lcl->pout = ctrl_lcl->isath * 0.92 ;
    }
    else if (ctrl_lcl->pout <= (ctrl_lcl->isatl))
    {
        ctrl_lcl->pout = ctrl_lcl->isatl ;
    }


    //    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
    //        ctrl_lcl->itermT = 1;
    //    else
    //        ctrl_lcl->itermT = 1;
    if (ctrl_lcl->internal_state < P_SLOPE_CTRL_STP2)
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else  if (ctrl_lcl->internal_state == P_SLOPE_CTRL_STP2 ||
              ctrl_lcl->internal_state == P_SLOPE_CTRL_STP4 ||
              ctrl_lcl->internal_state == P_SLOPE_CTRL_STP6)//2
    {
        if (ctrl_lcl->pout != 0)
            ctrl_lcl->out =  ctrl_lcl->pout; //
        else
            ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
        ctrl_lcl->out =  ctrl_lcl->out;// + ctrl_lcl->pout; //
        ctrl_lcl->pout = 0;
    }


    out = ctrl_lcl->out;
    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        out = ctrl_lcl->isath;
        if (ctrl_lcl->out >= ctrl_lcl->isath)
            ctrl_lcl->out = ctrl_lcl->isath;
    }
    else if (ctrl_lcl->out <= ctrl_lcl->isatl)
    {
        out = ctrl_lcl->isatl;
        ctrl_lcl->out = ctrl_lcl->isatl;
    }

    ctrl_lcl->pprevError = ctrl_lcl->error;
    return out;


}

//unsigned char flag2 = 0;
/**
  @brief TYPE 3 Controller Algorithm
         Fuzzy logic with crack2 recover drive. This is mainly used with Pressure Controllers (PC)
*/
float type3(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    float cv;
    GllRecord gll;
    float ratio = fabsf(pv / pctrl->targetsp);
    if ((ratio < 0.95f) && pctrl->downdir)    // we need to discharge rapidly
    {
        pctrl->fcGll.piIntegral = pctrl->icrack2;
        pctrl->fcGll.pidDFilter.pzfValue = pv;
        cv = 1.0f;
    }
    else      // Hybrid-GLL mode
    {
        pctrl->downdir = false;
        pctrl->updir = false;
        math_check(bin_search(pv, pctrl->dynPtable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[0],
                   1.0f);
        math_check(bin_search(pv, pctrl->dynItable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[1],
                   1.0f);
        math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain * pctrl->lGainCorr[0], &pctrl->scaledKp,
                   pctrl->Pgain);
        math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain * pctrl->lGainCorr[1], &pctrl->scaledKi,
                   pctrl->Igain);
        math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
                   pctrl->scaledKi);
        // Run GLL controller
        pctrl->fcGll.piPGain = pctrl->scaledKp;
        pctrl->fcGll.piIGain = pctrl->scaledKiGas;
        pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
        pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
        gll.pi = &pctrl->fcGll;
        gll.cmd = pctrl->currentsp;
        gll.gterm = pctrl->fcGllGain;
        gll.flow = pv;
        gllStep(&gll);
        pctrl->pterm = gll.pi->pTerm;
        pctrl->iterm = gll.pi->piIntegral;
        pctrl->dterm = gll.dterm;
        cv = gll.ctrlv;
    }
    return cv;
}
