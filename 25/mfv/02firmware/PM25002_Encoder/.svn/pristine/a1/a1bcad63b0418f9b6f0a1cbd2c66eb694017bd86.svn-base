/**
  @brief TYPE 5 Controller Algorithm
         Fuzzy logic for PM25
*/
float type5(ctrl_struct *pctrl, float tpsidiff, float pv)
{

    //  GllRecord gll;
    //  pctrl->fcGll.piPGain = pctrl->Pgain;
    //  pctrl->fcGll.piIGain = pctrl->Igain;
    //  pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
    //  pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
    //  gll.pi = &pctrl->fcGll;
    //  gll.cmd = pctrl->setpoint;
    //  gll.gterm = pctrl->fcGllGain;
    //  gll.flow = pv;
    //  gllStep(&gll);
    //  pctrl->pterm = gll.pi->pTerm;
    //  pctrl->iterm = gll.pi->piIntegral;
    //  pctrl->dterm = gll.dterm;
    //  if (gll.error > 0.0f) {
    //    pctrl->transSMState = MOVE_DOWN;
    //  } else if (gll.error < 0.0f) {
    //    pctrl->transSMState = MOVE_UP;
    //  } else {
    //    pctrl->transSMState = MOVE_STOP;
    //  }
    //
    //  pctrl->sm->freq = fabsf(9000.0f * gll.ctrlv);
    //  return gll.ctrlv;


    //  float cv = 0.0f;
    //  pctrl->scaledKp = pctrl->Pgain;
    //  pctrl->scaledKiGas = pctrl->Igain;
    //  cv = PIDController_Update(&ctrl, pctrl->currentsp, pv);
    //  if (ctrl.error > 0.0f) {
    //    pctrl->transSMState = MOVE_DOWN;
    //  } else if (ctrl.error < 0.0f) {
    //    pctrl->transSMState = MOVE_UP;
