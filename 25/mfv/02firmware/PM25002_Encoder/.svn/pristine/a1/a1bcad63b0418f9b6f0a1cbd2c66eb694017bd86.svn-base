    ctrl.internalController.softLandTh = nvmem.app.controllerObj.nsoftLandTh;
    ctrl.internalController.rateSepTh = nvmem.app.controllerObj.nrateSepTh;
    ctrl.range1ChangeSlopeCof = nvmem.app.controllerObj.nrange1ChangeSlopeCof;
    ctrl.range2ChangeSlopeCof = nvmem.app.controllerObj.nrange2ChangeSlopeCof;
    ctrl.range3ChangeSlopeCof = nvmem.app.controllerObj.nrange3ChangeSlopeCof;
    ctrl.Rang1PgainCof = nvmem.app.controllerObj.nRang1PgainCof;
    ctrl.Rang2PgainCof = nvmem.app.controllerObj.nRang2PgainCof;
    ctrl.Rang3PgainCof = nvmem.app.controllerObj.nRang3PgainCof;

    ctrl.rampMaxDu  	=
        nvmem.app.controllerObj.nrampMaxDu;				//#define MAX_DU_DT 			  0.08					   // 阀门最大变化率 (%/s)
    ctrl.rampOscH 		=
        nvmem.app.controllerObj.nrampOscH;				//#define OSC_THRESHOLD_HIGH 	 1.5/10.0					  // 高标准差 (Torr/s)
    ctrl.rampOscL 		=
        nvmem.app.controllerObj.nrampOscL;				//#define OSC_THRESHOLD_LOW		 0.8/10.0					  // 低标准差 (Torr/s)
    ctrl.rampMeanT 		=
        nvmem.app.controllerObj.nrampMeanT;				//#define MEAN_TOL				  0.2/10					 // 均值接近0的判定 (Torr/s)
    ctrl.rampSteadyTh 	=
        nvmem.app.controllerObj.nrampSteadyTh;			//#define STEADY_THRESHOLD		 0.3/10 					// 平稳允许标准差 (Torr/s)
    ctrl.rampQTh 		=
        nvmem.app.controllerObj.nrampQTh;				//#define Q_THRESHOLD 			0.5/10					   // 允许速率误差平滑值 (Torr/s)
    ctrl.rampAdatpInter =
        nvmem.app.controllerObj.nrampAdatpInter;		//#define ADAPT_INTERVAL		   0.2*30					  // 自适应更新周期 (s)
    ctrl.rampInstabliTh =
        nvmem.app.controllerObj.nrampInstabliTh;		//#define INSTABILITY_THRESHOLD   3.0/10					  // 瞬时幅值保护 (Torr/s)
    ctrl.rampLockTime	=
        nvmem.app.controllerObj.nrampLockTime;			//#define LOCK_TIME				 2.0					 // 振荡后锁定增益增加时间 (s)
    ctrl.rampPressToler =
        nvmem.app.controllerObj.nrampPressToler;		//#define PRESSURE_TOLERANCE	   0.51/1000	 // 压力误差 (Torr)
    ctrl.rampRateToler 	=
        nvmem.app.controllerObj.nrampRateToler;			//#define RATE_TOLERANCE		  0.4/10	 // 速率波动 (Torr/s)
    ctrl.rampStableCnt 	=
        nvmem.app.controllerObj.nrampStableCnt;			//#define STABLE_CNT_SWITCH 	  5 	  // 连续满足周期数
    ctrl.rampKpRate 	= nvmem.app.controllerObj.nrampKpRate;			//#define KP_RATE_LIMIT  0.5/10	 // 每秒最大变化量
    ctrl.rampKiRate 	= nvmem.app.controllerObj.nrampKiRate;			//#define KI_RATE_LIMIT  0.1/10	 // 相应 Ki 变化率限制
    ctrl.rampKpMin 		= nvmem.app.controllerObj.nrampKpMin;				//#define KP_MIN				  0.5
    ctrl.rampKpMax 		= nvmem.app.controllerObj.nrampKpMax;				//#define KP_MAX				  8.0
    ctrl.rampKiMin 		= nvmem.app.controllerObj.nrampKiMin;				//#define KI_MIN				  0.01
    ctrl.rampKiMax 		= nvmem.app.controllerObj.nrampKiMax;				//#define KI_MAX				  0.8
    ctrl.rampKpOri 		= nvmem.app.controllerObj.nrampKpOri;				//#define KP0					  2.0
    ctrl.rampKiOri 		= nvmem.app.controllerObj.nrampKiOri;				//#define KI0					  0.05
    ctrl.rampMaxDecRate =
        nvmem.app.controllerObj.nrampMaxDecRate;		//#define DECEL_ACCEL	1.5/10	 // 允许的最大减速度 (Torr/s²)
    ctrl.rampMagin 		= nvmem.app.controllerObj.nrampMagin;				//#define DECEL_MARGIN 5.0/1000   // 安全余量 (Torr)
    ctrl.rampMinRate 	= nvmem.app.controllerObj.nrampMinRate;			//#define V_MIN					0.5/10	   // 最小速率截断 (Torr/s)
    ctrl.pressLowRangSlopeCof = nvmem.app.controllerObj.npressLowRangSlopeCof;//0.8
    Ki_old = ctrl.rampKiOri;

    internalController_Init(&ctrl);
}

/**
  @brief ARM TYPE Contorller Algorithm
         Stock ARM baed PID using matrices
*/
float typearm(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    float cv;
    float output;
    math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain, &pctrl->scaledKp, pctrl->Pgain);
    math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain, &pctrl->scaledKi, pctrl->Igain);
    math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
               pctrl->scaledKi);
    PID.Kp = pctrl->scaledKp;
    PID.Ki = pctrl->scaledKi;
    PID.Kd = pctrl->Dgain;
    /* Initialize PID system, float32_t format */
    arm_pid_init_f32(&PID, 0);

    /* Calculate error */
    pctrl->error = pctrl->currentsp - pv;


    /* Calculate PID here, argument is error */
    output = arm_pid_f32(&PID, pctrl->error);

    // check if we are going to saturate the actuator
    if (PID.state[2] > pctrl->isath)
    {
        PID.state[0] = 0;
        PID.state[1] = 0;
        PID.state[2] = pctrl->isath;
        cv = pctrl->isath;
        pctrl->saturated = true;
    }
    else if (PID.state[2] < pctrl->isatl)
    {
        PID.state[0] = 0;
        PID.state[1] = 0;
        PID.state[2] = pctrl->isatl;
        cv = pctrl->isatl;
        pctrl->saturated = true;
    }
    else
    {
        pctrl->saturated = false;
        cv = output;
    }

    return cv;
}

/**
  @brief TYPE 1 Controller Algorithm
         Discrete PID implementation
*/
float type1(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain, &pctrl->scaledKp, pctrl->Pgain);
    math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain, &pctrl->scaledKi, pctrl->Igain);
    math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
               pctrl->scaledKi);
    return PIDController_Update(&ctrl, pctrl->currentsp, pv);
}

/**
  @brief TYPE 2 Controller Algorithm
         Standard GLL controller implementation
*/
float type2(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    GllRecord gll;
    math_check(bin_search(pctrl->setpoint, pctrl->dynPtable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1),
               &pctrl->lGainCorr[0], 1.0f);
    math_check(bin_search(pctrl->setpoint, pctrl->dynItable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1),
               &pctrl->lGainCorr[1], 1.0f);
    math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain * pctrl->lGainCorr[0], &pctrl->scaledKp,
               pctrl->Pgain);
    math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain * pctrl->lGainCorr[1], &pctrl->scaledKi,
               pctrl->Igain);
    math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
               pctrl->scaledKi);
    pctrl->fcGll.piPGain = pctrl->scaledKp;
    pctrl->fcGll.piIGain = pctrl->scaledKiGas;
    pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
    pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
    gll.pi = &pctrl->fcGll;
    gll.cmd = pctrl->currentsp;
    gll.gterm = pctrl->fcGllGain;
    gll.flow = pv;
    gllStep(&gll);
    pctrl->pterm = gll.pi->pTerm;
    pctrl->iterm = gll.pi->piIntegral;
    pctrl->dterm = gll.dterm;
    return gll.ctrlv;
}

