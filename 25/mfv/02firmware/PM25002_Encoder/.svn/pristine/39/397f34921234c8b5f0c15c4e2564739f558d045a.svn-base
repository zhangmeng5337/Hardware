#ifndef __BSP_STEP_MOTOR_CTRL_H
#define	__BSP_STEP_MOTOR_CTRL_H

#include "bsp_stepper_init.h"
#include "bsp_encoder.h"
#include "main.h"
/*宏定义*/
/*******************************************************/
#define TIM_STEP_FREQ     (SystemCoreClock/TIM2PS) // 频率ft值

/*电机单圈参数*/
#define STEP_ANGLE				1.8f                 //步进电机的步距角 单位：度
#define FSPR              (360.0f/STEP_ANGLE)  //步进电机的一圈所需脉冲数
#define MICRO_STEP        1         				 //细分器细分数 
#define SPR               (FSPR*MICRO_STEP)    //细分后一圈所需脉冲数
#define PULSE_RATIO       (float)(SPR/ENCODER_TOTAL_RESOLUTION)//步进电机单圈脉冲数与编码器单圈脉冲的比值
#define SAMPLING_PERIOD   50                          //PID采样频率，单位Hz
//#define SAMPLING_PERIOD     (unsigned int)(1000 / GET_BASIC_TIM_PERIOD())  //PID采样频率，单位Hz
/* 补充：例程默认写固定了SAMPLING_PERIOD宏频率值，如果需要试PID助手的发送周期效果，注释切换下一行宏 */

#define MOVE_CTRL         2.5f                 //启用速度环控制量
#define TARGET_DISP       50                   //步进电机运动时的目标圈数，单位：转

#define TARGET_SPEED_MAX  1600                 // 目标速度的最大值

typedef struct {
  unsigned char stepper_dir;               //步进电机方向
  unsigned char stepper_running;           //步进电机运行状态
  unsigned char MSD_ENA;                   //驱动器使能状态
    /* 经过pid计算后的期望值 */

  uint32_t time_out;
  uint32_t time_sensor_out;
  uint32_t set_time_sensor_out;  
  uint32_t set_time_out;
 
}__SYS_STATUS;

void StepMotorDirection(unsigned char dir);
void MSD_ENA(int NewState);
void Set_Stepper_Stop(void);
void Set_Stepper_Start(void);
void Stepper_Ctrl(void);
__SYS_STATUS *get_sys_sataus(void);
void Set_Stepper_Start_PWM(void);
#endif /* __STEP_MOTOR_CTRL_H */
