void PID_init()
{
    pid_usr.setpoint = 0.0;
    pid_usr.pv = 0.0;
    pid_usr.error = 0.0;
    pid_usr.err_k_2 = 0.0;
    pid_usr.err_k_1 = 0.0;
    pid_usr.err = 0.0;
    pid_usr.Kp = 6;                   // 需要自行整定
    pid_usr.Ki =
        0.1;                   // 注意，和普通增量，以及积分分离类型相比，这里加大了积分环节的值
    pid_usr.Kd = 0;
    pid_usr.interal = 0;
    pid_usr.crack2 = 0.001; //
    pid_usr.crack1 = 0;
    pid_usr.inter_enable = 0;
    pid_usr.umax = 1;
    pid_usr.umin = 0;
    pid_usr.cv = 0;
    pid_usr.controller_type = 1;
    pid_usr.increment = 0;

}
float out1 = 0.5;
float out2 = 5;
float out3 = 5, out4 = 2, out5 = 0.7, out6 = 2.6, out7 = 2.6, out8 = 4, out9 = 9;
float out;
float comp_out = 0;
float rate_now, rate_last;
float pre_last;
unsigned char div = 12, div_count = 10;
unsigned char step;
float pth1 = 0.7, pth2 = 0.3, pth3 = 0.35, pth4 = 0.019, pth5 = 0.035;

float ratio;
float  err_max, err_min;
float out1;//降速积分系数
float sp_err_coff;
unsigned char step = 0;
static unsigned char state = 0;
float err_c1 = 100, err_c2 = 10, err_c5 = 0.00125, err_c3 = 1, err_c4 = 1, err_c7 = 0.1, err_c6 = 0.2;
float spRange_1, spRange_2;
float preRateH = 0.35, preRateL = 0.1;
float ramtim_tick = 0, pre_speed, ramp_flag = 0, pre_total_time, open_valve_pre, open_valve_time, last_setpoint,
      iterm_detal, inter2_enable;
float measure_first;
float ramp_time_start = 10000;
float internal_sp, interal_sp_ratio;
unsigned char internal_state;
float pre_last, pre_measure;
float err_t = 1.0;
float pre_t = 1;
float interm_cof = 5, interm_cof2 = 0.1;
float tau = 1;
float type9(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{

    if (div-- == 0)
    {
        if (pre_last != 0)
            rate_now = ((measurement - pre_last) * 1000.0f + rate_last) / 2;
        pre_last = measurement;
        div = div_count;
        rate_last = rate_now ;

    }
    if (last_setpoint != ctrl_lcl->targetsp)
    {
        inter2_enable = 0;
        ramp_flag = 0;
        pre_speed = 0;
        open_valve_pre = 0;
        pre_total_time = 0;
        internal_state = 0;
        last_setpoint = ctrl_lcl->targetsp;
        ctrl_lcl->piterm = 0;
        ctrl_lcl->ppterm = 0;
        // ctrl_lcl->pout = 0;
    }
    ratio = measurement / ctrl_lcl->targetsp;

    if (internal_state >= 1)
    {
        interal_sp_ratio = measurement / internal_sp;
    }
    else
        interal_sp_ratio = ratio;




    if (get_pos() <= 0.05 && ctrl_lcl->overShot_ctrl == 1 )
    {

        if ((ctrl_lcl->targetsp - measurement) >= 0.003)
        {
            if (ramp_flag == 0)
            {
                measure_first = measurement;
                ramp_flag = 1;

            }
        }
		else
		{
 			measure_first = measurement;
			ramp_flag = 1;
		}

    }
    pre_measure = measurement;

    if (ramp_flag == 1)
    {

        if (measurement >= (measure_first + 0.003)||(ctrl_lcl->targetsp - measurement) < 0.003)
        {
            ramp_flag = 2;
            pre_speed = (measurement - measure_first) * 100000 / ramtim_tick / 3;
            pre_total_time = (ctrl_lcl->targetsp - measurement) * 1000000 / pre_speed;
            if (pre_total_time > ramp_time_start)
                open_valve_time = (pre_total_time - ramp_time_start) / pre_total_time;
            else
                open_valve_time = 0.1;

            open_valve_pre = measurement + open_valve_time * (ctrl_lcl->targetsp - measurement);
            ramtim_tick = 0;
            measure_first = 0;
            internal_state = 1;

        }
        else
        {

            ramtim_tick++;
        }

    }





    switch (internal_state)
    {
        case 0:
            internal_sp = ctrl_lcl->targetsp;
            internal_state = 0;
            break;
        case 1:
            if (fabs(ctrl_lcl->targetsp) >= 0.01 && ramp_flag > 0)
            {
                if (measurement >= open_valve_pre && open_valve_pre > 0)
                {
                    iterm_detal = ctrl_lcl->out * 3 / 500;
                    //open_valve_pre = 0;
                    // inter2_enable = 1;
                    //                    if ((ctrl_lcl->targetsp - measurement) >= (pre_t * pre_speed / 1000))
                    //                        internal_sp = measurement + pre_t * pre_speed / 1000;
                    //                    else
                    //                        internal_sp = ctrl_lcl->targetsp;

                    if ((ctrl_lcl->targetsp - measurement) < (interal_sp_ratio * internal_sp + pre_t / 1000))
                        internal_sp = interal_sp_ratio * internal_sp + pre_t / 1000;
                    else
                        internal_sp = ctrl_lcl->targetsp;

                    unsigned char debounce = 0;
                    static unsigned char current_state = 0, last_state;
                    static float last_value;

                //  interm_cof2 = 0.01;//ctrl_lcl->iterm * pre_speed / 50;
                // ctrl_lcl->iterm = ctrl_lcl->iterm - interm_cof2;
//                 if (meter.pressure_slope > interm_cof2 || meter.pressure_slope < interm_cof2 / 5)
                if (meter.pressure_slope > interm_cof2 || meter.pressure_slope < interm_cof2 / 6)
                {
                    ctrl_lcl->perror = interm_cof2 - meter.pressure_slope  ;
                    ctrl_lcl->piterm = ctrl_lcl->piterm + ctrl_lcl->pIgain * ctrl_lcl->perror;
                    ctrl_lcl->ppterm = ctrl_lcl->pPgain * ctrl_lcl->perror;
                    ctrl_lcl->pout = ctrl_lcl->ppterm + ctrl_lcl->piterm;
                }


                   // if (rate_now > 0.4)
                    {
                        float tmp;
                        tmp = 0.0714 * ctrl_lcl->targetsp + 0.878;

                        //            if (ratio >= 0.9 || (ctrl_lcl->targetsp - measurement) <= 0.007)
                        //            {
                        //
                        //                //  interm_cof2 = 0.01;//ctrl_lcl->iterm * pre_speed / 50;
                        //                // ctrl_lcl->iterm = ctrl_lcl->iterm - interm_cof2;
                        //                ctrl_lcl->perror = meter.pressure_slope - interm_cof2;
                        //                ctrl_lcl->piterm = ctrl_lcl->piterm + ctrl_lcl->pIgain * ctrl_lcl->perror;
                        //                ctrl_lcl->ppterm = ctrl_lcl->pPgain * ctrl_lcl->perror;
                        //                ctrl_lcl->pout = ctrl_lcl->ppterm + ctrl_lcl->piterm;
                        //
                        //            }


                    }
                    internal_state = 2;

                }
                else
                    internal_sp = ctrl_lcl->targetsp;
            }
            else
                internal_sp = ctrl_lcl->targetsp;
            break;
        case 2:
            internal_sp = internal_sp;
            if (internal_sp < ctrl_lcl->targetsp)
            {

                if (interal_sp_ratio >= err_t)//1.01
                {

                    if (internal_sp < ctrl_lcl->targetsp)
                    {

                        internal_state = 1;
                    }

                    else
                        internal_state = 2;
                }
                interm_cof = interm_cof2;
            }
            else
            {
                internal_sp = ctrl_lcl->targetsp;
                interm_cof = 1;
                internal_state = 2;
            }


            break;
        case 3:
            //;internal_sp = internal_sp;
            break;
    }
    if (internal_state == 0)
        ctrl_lcl->error = ctrl_lcl->targetsp - measurement;
    else
        ctrl_lcl->error = internal_sp - measurement;
    if (ctrl_lcl->targetsp <= 1)//误差分段处理
    {
        if (ctrl_lcl->targetsp <= 0.010)
        {
            ctrl_lcl->error = ctrl_lcl->error * err_c1;
        }
        else     if (ctrl_lcl->targetsp <= 0.030)
        {
            ctrl_lcl->error = ctrl_lcl->error * err_c2;
        }
        else     if (ctrl_lcl->targetsp <= 0.10)
        {

            ctrl_lcl->error = ctrl_lcl->error * err_c3;

        }
        else
        {

            ctrl_lcl->error = ctrl_lcl->error;
        }

    }


    //*******************pid realize*******
    ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error;
    ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);


    if (ctrl_lcl->out >= ctrl_lcl->isath)
    {
        if (ctrl_lcl->error < 0)//积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {
        if (ctrl_lcl->error > 0)//积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else
    {
        ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;
    }


    //ctrl_lcl->iterm = ctrl_lcl->iterm +  comp_out *  igain_cof;
    if (ctrl_lcl->iterm >= ctrl_lcl->isath*0.9 ) //积分限幅
    {
        ctrl_lcl->iterm = ctrl_lcl->isath*0.9 ;
    }
    else  if (ctrl_lcl->iterm <= ctrl_lcl->isatl)
    {
        ctrl_lcl->iterm = ctrl_lcl->isatl;
    }


		
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
        ctrl_lcl->out = ctrl_lcl->out + ctrl_lcl->pout;





    out = ctrl_lcl->out;
    if (ctrl_lcl->out >= ctrl_lcl->isath)
    {
        out = ctrl_lcl->isath;
        ctrl_lcl->out = ctrl_lcl->isath;
    }
    else if (ctrl_lcl->out <= ctrl_lcl->isatl)
    {
        out = ctrl_lcl->isatl;
        ctrl_lcl->out = ctrl_lcl->isatl;
    }

    ctrl_lcl->pprevError = ctrl_lcl->error;
    return out;


}
float type8(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{

    float ratio = fabsf(measurement / ctrl_lcl->targetsp);
    /* Error signal */
    ctrl_lcl->error = ctrl_lcl->targetsp - measurement;
    if (div-- == 0)
    {
        rate_last = rate_now ;
        rate_now = (measurement - pre_last) * 1000.0f * 3;
        pre_last = measurement;
        div = div_count;

    }

    //    ctrl_lcl->overShot_ctrl = 0;
    //    ctrl_lcl->iterm_enable = 1;

    if (ctrl_lcl->targetsp >= pth4)
    {
        if (ctrl_lcl->targetsp <= pth5)
            pth1 = (ctrl_lcl->targetsp * 1000 - 5) / ctrl_lcl->targetsp / 1000;
        else
            pth1 = (ctrl_lcl->targetsp * 1000 - 15) / ctrl_lcl->targetsp / 1000;
    }

    else
        pth1 = 0.7;
    //comp_out = 0;
    //    if (ratio >= 0.95 && ratio <= 1.05f)
    //if (ratio >= 0.95)
    if (ratio >= pth1)
    {
        //        if (ctrl_lcl->targetsp < 0.005)
        if (ctrl_lcl->targetsp < pth4)
        {

            ctrl_lcl->error = ctrl_lcl->error * 1000;//1000
        }
        //        else if (ctrl_lcl->targetsp < 0.05)
        //        {
        //
        //            ctrl_lcl->error = ctrl_lcl->error * 10 * out1;
        //        }
        else if (ctrl_lcl->targetsp < 0.5)
        {
            if (ctrl_lcl->overShot_ctrl == 1)
            {
                if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)//valve closed ,run this
                {
                    if (ctrl_lcl->overShot_ctrl == 1)
                        ctrl_lcl->overShot_ctrl = 2;

                }
            }
            if (ctrl_lcl->overShot_ctrl != 3 && ctrl_lcl->overShot_ctrl > 1)
            {
                {
                    if (rate_now > pth3)
                        comp_out = comp_out - (ctrl_lcl->error) * out9;
                    else
                        comp_out = comp_out + (ctrl_lcl->error) * out9;
                }


            }
            if (ratio > 1 && ctrl_lcl->overShot_ctrl == 2)
            {
                ctrl_lcl->overShot_ctrl = 3;
            }

            ctrl_lcl->error = ctrl_lcl->error * out7;
        }

        else
        {

            ctrl_lcl->error = ctrl_lcl->error ;
        }
    }
    else if (ratio >= pth2 && ratio < pth1)
    {
        if (ctrl_lcl->out <= -0.5)
        {
            ctrl_lcl->iterm = 0;
            ctrl_lcl->out = 0;
        }
        else
        {
            if (ctrl_lcl->targetsp < 0.005)
            {

                ctrl_lcl->error = ctrl_lcl->error * 100;
            }
            else if (ctrl_lcl->targetsp < 0.05)
            {

                ctrl_lcl->error = ctrl_lcl->error * 10 * out2;
            }
            else if (ctrl_lcl->targetsp < 0.5)
            {

                ctrl_lcl->error = ctrl_lcl->error * out2 ;
            }
        }


    }
    else
    {
        if (ctrl_lcl->targetsp < 0.005)
        {

            ctrl_lcl->error = ctrl_lcl->error * 100;
        }
        else
            ctrl_lcl->error = ctrl_lcl->error * out3 ;
    }




    //pid sat
    if (out >= ctrl_lcl->isath * 0.97)
    {
        if (ctrl_lcl->error < 0)
        {
            if (ctrl_lcl->overShot_ctrl == 2)
            {

                ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;
            }

            if (ctrl_lcl->overShot_ctrl == 3)
            {
                ctrl_lcl->overShot_ctrl = 0;
                ctrl_lcl->iterm =  ctrl_lcl->iterm + comp_out;
                comp_out = 0;
            }
        }

    }
    else if (out <= ctrl_lcl->isatl)
    {

        if (ctrl_lcl->error > 0)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;

            if (ctrl_lcl->error > 0 && ctrl_lcl->overShot_ctrl == 3)
            {
                ctrl_lcl->overShot_ctrl = 0;
                ctrl_lcl->iterm =  ctrl_lcl->iterm + comp_out;
                comp_out = 0;
            }
        }
    }
    else
    {
        if (ctrl_lcl->error > 0)
        {
            if (ctrl_lcl->overShot_ctrl <= 1 || ratio < pth1)
                ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;

        }
        else
        {
            if (ctrl_lcl->overShot_ctrl == 3)
            {
                ctrl_lcl->overShot_ctrl = 0;
                ctrl_lcl->iterm =  ctrl_lcl->iterm + comp_out;
                comp_out = 0;
            }
            else
            {
                ctrl_lcl->overShot_ctrl = 0;
                comp_out = 0;
                if (ctrl_lcl->overShot_ctrl >= 2 && ratio < pth1)
                {
                    ctrl_lcl->overShot_ctrl = 0;
                    ctrl_lcl->iterm =  ctrl_lcl->iterm + comp_out;

                }
                else

                    ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;

            }
        }
    }



    /* Proportional */
    ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error ;

    ctrl_lcl->dterm = (ctrl_lcl->error - ctrl_lcl->prevError) * ctrl_lcl->Dgain ;

    ctrl_lcl->out = ctrl_lcl->pterm + (ctrl_lcl->iterm + comp_out) * ctrl_lcl->Igain   +
                    ctrl_lcl->dterm ;

    /* Store error and measurement for later use */
    ctrl_lcl->prevError = ctrl_lcl->error;
    ctrl_lcl->prevMeasurement = measurement;


    out = ctrl_lcl->out;

    if (ctrl_lcl->out > ctrl_lcl->isath)
    {
        out = ctrl_lcl->isath;
        ctrl_lcl->saturated = true;
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {

        out = ctrl_lcl->isatl;
        ctrl_lcl->saturated = true;

    }
    else
    {
        ctrl_lcl->saturated = false;
    }
    ctrl_lcl->iterm_sat = ctrl_lcl->out - out;


    /* return PID output */
    return out;


}
float type7(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{

    float ratio = fabsf(measurement / ctrl_lcl->targetsp);
    /* Error signal */
    ctrl_lcl->error = ctrl_lcl->targetsp - measurement;
    if (div-- == 0)
    {
        rate_now = (measurement - pre_last) * 1000.0f;
        pre_last = measurement;
        div = 3;

    }

    //    ctrl_lcl->overShot_ctrl = 0;
    //    ctrl_lcl->iterm_enable = 1;



    //comp_out = 0;
    //    if (ratio >= 0.95 && ratio <= 1.05f)
    if (ratio >= 0.95)
        // if (ratio >= 0.80)
    {
        if (ctrl_lcl->targetsp < 0.005)
        {

            ctrl_lcl->error = ctrl_lcl->error * 1000;//1000
        }
        else if (ctrl_lcl->targetsp < 0.05)
        {

            ctrl_lcl->error = ctrl_lcl->error * 100 * out1;
        }
        else if (ctrl_lcl->targetsp < 0.5)
        {
            if (ratio > 0.95 && ctrl_lcl->overShot_ctrl != 3)
            {

                ctrl_lcl->overShot_ctrl = 2;
                if (rate_now > 0 && rate_now < 0.045)
                {
                    ctrl_lcl->overShot_ctrl = 3;
                    ctrl_lcl->iterm =  ctrl_lcl->iterm + comp_out;
                    // comp_out = 0;
                }
                else if (rate_now > 0)
                    comp_out = comp_out - out5;

            }

            ctrl_lcl->error = ctrl_lcl->error * 10 * out6;

        }
        else
        {

            ctrl_lcl->error = ctrl_lcl->error ;
        }
    }
    else if (ratio >= 0.3 && ratio < 0.95f)
    {
        if (ctrl_lcl->targetsp < 0.005)
        {

            ctrl_lcl->error = ctrl_lcl->error * 100;
        }
        else if (ctrl_lcl->targetsp < 0.05)
        {

            ctrl_lcl->error = ctrl_lcl->error * 10 * out2;
        }
        else if (ctrl_lcl->targetsp < 0.5)
        {

            ctrl_lcl->error = ctrl_lcl->error * out2 ;
        }

    }
    else
    {

        ctrl_lcl->error = ctrl_lcl->error * out3 ;
    }




    //pid sat
    if (ctrl_lcl->out > ctrl_lcl->isath)
    {
        if (ctrl_lcl->error < 0)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;
        }
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {
        if (ctrl_lcl->error > 0)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;
        }
    }
    else
    {
        ctrl_lcl->iterm = ctrl_lcl->iterm +  ctrl_lcl->error;
    }



    /* Proportional */
    ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error ;

    ctrl_lcl->dterm = (ctrl_lcl->error - ctrl_lcl->prevError) * ctrl_lcl->Dgain ;

    ctrl_lcl->out = ctrl_lcl->pterm + (ctrl_lcl->iterm) * ctrl_lcl->Igain   +
                    ctrl_lcl->dterm ;

    /* Store error and measurement for later use */
    ctrl_lcl->prevError = ctrl_lcl->error;
    ctrl_lcl->prevMeasurement = measurement;


    out = ctrl_lcl->out;

    if (ctrl_lcl->out > ctrl_lcl->isath)
    {
        out = ctrl_lcl->isath;
        ctrl_lcl->saturated = true;
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {

        out = ctrl_lcl->isatl;
        ctrl_lcl->saturated = true;

    }
    else
    {
        ctrl_lcl->saturated = false;
    }
    ctrl_lcl->iterm_sat = ctrl_lcl->out - out;

    rate_last = rate_now ;

    /* return PID output */
    return out;


}
unsigned char flag2 = 0;
/**
  @brief TYPE 3 Controller Algorithm
         Fuzzy logic with crack2 recover drive. This is mainly used with Pressure Controllers (PC)
*/
float type3(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    float cv;
    GllRecord gll;
    float ratio = fabsf(pv / pctrl->targetsp);
    if ((ratio < 0.95f) && pctrl->downdir)    // we need to discharge rapidly
    {
        pctrl->fcGll.piIntegral = pctrl->icrack2;
        pctrl->fcGll.pidDFilter.pzfValue = pv;
        cv = 1.0f;
    }
    else      // Hybrid-GLL mode
    {
        pctrl->downdir = false;
        pctrl->updir = false;
        math_check(bin_search(pv, pctrl->dynPtable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[0],
                   1.0f);
        math_check(bin_search(pv, pctrl->dynItable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[1],
                   1.0f);
        math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain * pctrl->lGainCorr[0], &pctrl->scaledKp,
                   pctrl->Pgain);
        math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain * pctrl->lGainCorr[1], &pctrl->scaledKi,
                   pctrl->Igain);
        math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
                   pctrl->scaledKi);
        // Run GLL controller
        pctrl->fcGll.piPGain = pctrl->scaledKp;
        pctrl->fcGll.piIGain = pctrl->scaledKiGas;
        pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
        pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
        gll.pi = &pctrl->fcGll;
        gll.cmd = pctrl->currentsp;
        gll.gterm = pctrl->fcGllGain;
        gll.flow = pv;
        gllStep(&gll);
        pctrl->pterm = gll.pi->pTerm;
        pctrl->iterm = gll.pi->piIntegral;
        pctrl->dterm = gll.dterm;
        cv = gll.ctrlv;
    }
    return cv;
}
float type6(ctrl_struct *pctrl, float tpsidiff, float pv)
{
    float cv;

    GllRecord gll;
    float ratio = fabsf(pv / pctrl->targetsp);
    //if ((ratio < 0.95f) && pctrl->updir)    // we need to discharge rapidly

    if ((ratio > 0.90f) && pctrl->overShot_ctrl == 2 && pctrl->targetsp >= 0.02 && pctrl->rampmode == 0)
    {

        pctrl->fcGll.piIntegral = 0.79;//pctrl->icrack2;
        pctrl->fcGll.pidDFilter.pzfValue = pv;
        pctrl->overShot_ctrl = 0;

    }
    else if (ratio < 0.90f && pctrl->overShot_ctrl != 0 && pctrl->targetsp >= 0.02 && pctrl->rampmode == 0)
    {
        if (pctrl->overShot_ctrl == 1)
        {
            pctrl->overShot_ctrl = 2;
        }
        cv = 1.0f;

    }
    else
    {
        //        if ((ratio > 0.95f) && pctrl->overShot_ctrl == 2 && pctrl->targetsp < 0.02 && pctrl->rampmode == 0)
        //        {
        //            pctrl->fcGll.piIntegral = 0.82;//0.75 pctrl->icrack2;
        //            pctrl->fcGll.pidDFilter.pzfValue = pv;
        //            pctrl->overShot_ctrl = 0;
        //
        //        }
        //        else if (ratio < 0.95f && pctrl->overShot_ctrl != 0 && pctrl->targetsp < 0.02 && pctrl->rampmode == 0)
        //        {
        //            if (pctrl->overShot_ctrl == 1)
        //            {
        //                pctrl->overShot_ctrl = 2;
        //            }
        //            cv = 1.0f;
        //
        //        }
        //        else      // Hybrid-GLL mode
        {
            //flag = 0;
            pctrl->overShot_ctrl = 0;
            pctrl->downdir = false;
            pctrl->updir = false;
            math_check(bin_search(pv, pctrl->dynPtable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[0],
                       1.0f);
            math_check(bin_search(pv, pctrl->dynItable, MAX_DYNAMIC_GAIN_TABLE, X_DIRECTION_INC, 1.0f, 1), &pctrl->lGainCorr[1],
                       1.0f);
            math_check(tpsidiff * nvmem.app.controllerObj.KppPsi + pctrl->Pgain * pctrl->lGainCorr[0], &pctrl->scaledKp,
                       pctrl->Pgain);
            math_check(tpsidiff * nvmem.app.controllerObj.KipPsi + pctrl->Igain * pctrl->lGainCorr[1], &pctrl->scaledKi,
                       pctrl->Igain);
            //            math_check(pctrl->scaledKi * powf((*pctrl->currentmW / nvmem.app.controllerObj.tMw), 0.5f), &pctrl->scaledKiGas,
            //                       pctrl->scaledKi);
            // Run GLL controller
            static float pv_last;
            //			if(pv_last>pv &&(ratio > 0.73f && ratio <= 0.85f))
            //			{
            //                pctrl->fcGll.piPGain = pctrl->scaledKp;
            //                pctrl->fcGll.piIGain = pctrl->scaledKi * 10;
            //			}
            //			else
            static unsigned char flag = 0;
            if (pctrl->targetsp <= 0.01)
            {
                if (ratio > 0.92f && ratio < 0.98f)//inter1_th1 inter1_th2
                {
                    if (flag == 0)
                    {
                        pctrl->fcGll.piPGain = pctrl->scaledKp;
                        pctrl->fcGll.piIGain = pctrl->scaledKi * 0.5;//pctrl->inter1_scale; //0.5;// 0.5 ;//0.1 inter1_scale

                    }
                }
                else   if (ratio >= 0.98f && ratio < 1.02f)
                {
                    flag = 1;
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi * 8; // pctrl->inter2_scale; //8;// ; //5 ;//10 inter2_scale
                }

                else   if (ratio >=  2.0f) //|| ratio < 0.4f)
                {
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi * 0.4; //pctrl->inter2_scale;//0.1;// ; //5 ;//10 inter2_scale
                }
                else
                {
                    flag = 0;
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi * 1.5;//pctrl->inter3_scale; //1.5;// * ; //1
                }
            }
            else
            {
                if (ratio > 0.90f && ratio < 0.98f)
                {
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi * 0.5;
                }
                else   if (ratio >= 0.98f && ratio < 1.02f)
                {
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi * 2; // pctrl->inter2_scale; //5 ;//10 inter2_scale
                }
                else
                {
                    pctrl->fcGll.piPGain = pctrl->scaledKp;
                    pctrl->fcGll.piIGain = pctrl->scaledKi;
                }
            }

            pv_last = pv;
            pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
            pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
            gll.pi = &pctrl->fcGll;
            gll.cmd = pctrl->currentsp;
            gll.gterm = pctrl->fcGllGain;
            gll.flow = pv;
            gllStep(&gll);
            if (fabs(gll.pi->piIntegral) >= 100000)
            {
                if (gll.pi->piIntegral > 0)
                    gll.pi->piIntegral = 10000;
                else
                    gll.pi->piIntegral = -10000;
            }

            pctrl->pterm = gll.pi->pTerm;
            pctrl->iterm = gll.pi->piIntegral;
            pctrl->dterm = gll.dterm;
            cv = gll.ctrlv;
        }
    }

    return cv;
}
//void contronller_pid(float pv, float setpoint, float *cv)
//{
//    float tpsidiff = 0.0f;
//    *cv = typearm2(&ctrl2, tpsidiff, pv);
//    ctrl2.normalizeddrive = ctrl.invertdrive == 1 ? 1.0f - *cv : *cv;
//    //ctrl2.normalizeddrive = ctrl2.invertdrive == *cv;
//    *cv = ctrl2.normalizeddrive;
//}
/**
	@brief Simple controller implementstion
*/
void controller(float pv, float setpoint, float *cv)
{
    float output = 0.0f;
    float tpsidiff = 0.0f;
    static uint8_t enerPreLoad = 0;
    GllRecord gll;

    switch (ctrl.override)
    {
        case OVERRIDE_OFF:
            *cv = 0.0f;
            ctrl.normalizeddrive = 0.0f;
            ctrl.currentsp = 0.0f;
            ctrl.transSMState = STATE_HOME;
            ctrlsm = CTRL_OFF;
            break;
        case OVERRIDE_ON:
            // apply controller inversion here
            ctrl.normalizeddrive = 1.0f;
            ctrl.transSMState = STATE_FOPEN;
            break;
        case OVERRIDE_HOLD:
            break;
        case OVERRIDE_SAFESTATE:
            break;
        case OVERRIDE_SYSTEM_IDENT:
            if (ctrl.sysIdent.SourceEnabledFlag == 0)
            {
                SystemIdent_Init(&ctrl.sysIdent);
                ctrl.sysIdent.SourceEnabledFlag = 1;
            }
            SystemIdent_Cycle(&ctrl.sysIdent);
            *cv = ctrl.sysIdent.SourceOut;
            ctrl.normalizeddrive = *cv;
            ctrl.transSMState = STATE_MOVE;
            break;
        case OVERRIDE_MANUAL_DRIVE:
            // ctrl is updated from a different source
            if (getStepMotor()->op_complete == 0)
            {
                ctrl.normalizeddrive = *cv;
                getStepMotor()->set_position = ctrl.normalizeddrive;
                ctrl.transSMState = STATE_MOVE;
            }
            break;
        case OVERRIDE_NORMAL:
        default:
            ctrl.sysIdent.SourceEnabledFlag = 0;
            tpsidiff = (*ctrl.currentpressure - nvmem.app.controllerObj.tPsi);
            switch (ctrlsm)
            {
                case CTRL_OFF:
                    *cv = 0.0f;
                    if (setpoint > ctrl.shutoffthreshold)
                    {
                        if (ctrl.delayctr > CTRL_PERIOD_MS)   // implement a controller turn ON delay
                        {
                            ctrl.delayctr -= CTRL_PERIOD_MS;
                        }
                        else
                        {
                            enerPreLoad = 5;  // stay at crack for 5 cycles. This is to energize the valve so the plunger will start moving
                            ctrlsm = CTRL_CRACK;
                            if (ctrl.type == 5)
                            {
                                ctrl.currentsp = setpoint;
                                ctrl.targetsp = setpoint;
                                ctrl.rampinprogress = false;
                                ctrlsm = CTRL_NORMAL;
                            }
                        }
                    }
                    else
                    {
                        PIDController_Init(&ctrl);
                        ctrl.fcGll.piIntegral = 0.0f;
                        ctrl.fcGll.pidDFilter.pzfValue = 0.0F;
                        ctrl.fcGll.ffValue = 0.0F;
                        ctrl.delayctr = ctrl.turnondelay;
                        if (ctrl.type == 5)
                        {
                            ctrl.transSMState = MOVE_DOWN;
                        }
                    }
                    // get the idle drive state
                    ctrl.normalizeddrive = nvmem.app.manufacturing.idledrive == 1 ? 1.0f : 0.0f;
                    ctrl.transSMState = STATE_HOME;
                    break;
                case CTRL_CRACK:
                    if (ctrl.type == 1)
                    {
                        math_check(tpsidiff * nvmem.app.controllerObj.cpPsi + ctrl.icrack, &ctrl.scaledcrack, ctrl.icrack);
                        ctrl.iterm = ctrl.scaledcrack;
                        *cv = ctrl.icrack;
                        if (enerPreLoad-- == 0)
                        {
                            ctrlsm = CTRL_RAMP_SETUP;
                        }
                    }
                    else if (ctrl.type == 2)      // GLL controller
                    {
                        math_check(tpsidiff * nvmem.app.controllerObj.cpPsi + ctrl.icrack, &ctrl.scaledcrack, ctrl.icrack);
                        ctrl.fcGll.piIntegral = ctrl.scaledcrack;
                        ctrl.fcGll.pidDFilter.pzfValue = pv;
                        *cv = ctrl.scaledcrack;
                        if (enerPreLoad-- == 0)
                        {
                            ctrlsm = CTRL_RAMP_SETUP;
                        }
                    }
                    else if (ctrl.type == 3)      // Fuzzy logic controller
                    {
                        // initialize logic controller here
                        ctrl.fcGll.piIntegral = ctrl.icrack;
                        ctrl.fcGll.pidDFilter.pzfValue = pv;
                        *cv = ctrl.icrack;
                        if (enerPreLoad-- == 0)
                        {
                            ctrlsm = CTRL_RAMP_SETUP;
                        }
                        ctrl.downdir = false;
                        ctrl.updir = true;
                    }
                    else
                    {
                        PID.Kp = ctrl.Pgain;
                        PID.Ki = ctrl.Igain;
                        PID.Kd = ctrl.Dgain;
                        /* Initialize PID system, float32_t format */
                        arm_pid_init_f32(&PID, 1);
                        PID.state[2] = ctrl.icrack;
                        *cv = ctrl.icrack;
                        ctrlsm = CTRL_RAMP_SETUP;
                    }
                    // apply controller inversion here
                    ctrl.normalizeddrive = ctrl.invertdrive == 1 ? 1.0f - *cv : *cv;
                    ctrl.transSMState = STATE_MOVE;
                    break;
                case CTRL_RAMP_SETUP:
                    // setup ramps
                    ctrl.rampdir = ((setpoint - ctrl.currentsp) < 0.0f ? -1 : 1);
                    switch (ctrl.rampmode)
                    {
                        case 2:
                            ctrl.rampinprogress = true;
                            ctrl.ramp_rate = ctrl.rampdir * (ctrl.ramprate / 10.f) / 1000.0f * CTRL_PERIOD_MS / 1000.0f;
                            //                            ctrl.ramp_rate = ctrl.rampdir * (ctrl.ramprate / 1000.f) / 1000.0f * CTRL_PERIOD_MS;
                            break;
                        case 1:
                            ctrl.rampinprogress = true;
                            ctrl.ramp_rate = (setpoint - ctrl.currentsp) / ((ctrl.ramptime / 10.0f) / CTRL_PERIOD_S);
                            break;
                        case 0:
                        default:
                            ctrl.rampinprogress = false;
                            ctrl.ramp_rate = setpoint;
                            ctrl.currentsp = setpoint;
                            break;
                    }
                    ctrl.targetsp = setpoint;
                    ctrl.delayctr = ctrl.turnondelay; // be ready for the next delay request
                    ctrlsm = CTRL_NORMAL;
                    break;
                case CTRL_NORMAL:
                    // if we want to turn off even if ramp is in progress
                    if (setpoint <= ctrl.shutoffthreshold)   // turn OFF if setpoint is <0.5%FS but make sure ramp is not in progress
                    {
                        if (ctrl.turnoffdelay > CTRL_PERIOD_MS)    // implement a controller turn OFF delay
                        {
                            ctrl.turnoffdelay -= CTRL_PERIOD_MS;
                        }
                        else
                        {
                            ctrl.currentsp = 0.0f;
                            ctrlsm = CTRL_OFF;
                            return;
                        }
                    }
                    // handle ramps
                    if (ctrl.rampinprogress)
                    {
                        ctrl.currentsp += ctrl.ramp_rate;  // ramp internal setpoint
                        if (((ctrl.currentsp >= ctrl.targetsp) && (ctrl.rampdir == 1)) || ((ctrl.currentsp <= ctrl.targetsp) &&
                                (ctrl.rampdir == -1)))
                        {
                            ctrl.currentsp = setpoint;
                            ctrl.targetsp = setpoint;
                            ctrl.rampinprogress = false;
                        }
                        if (ctrl.targetsp != setpoint)    // is there a new setpoint request while we are still ramping?
                        {
                            ctrlsm = CTRL_RAMP_SETUP;
                            if (setpoint < ctrl.currentsp)
                            {
                                ctrl.downdir = true;
                                ctrl.updir = false;
                                ctrl.currentsp = setpoint;
                                ctrl.targetsp = setpoint;
                                ctrl.rampinprogress = false;
                            }
                            else
                            {
                                ctrl.downdir = false;
                                ctrl.updir = true;
                            }
                            return;
                        }
                    }
                    else
                    {
                        if (ctrl.currentsp != setpoint)   // did the setpoint change? add some epsilon
                        {
                            if (ctrl.delayctr > CTRL_PERIOD_MS)   // implement a controller turn ON delay
                            {
                                ctrl.delayctr -= CTRL_PERIOD_MS;
                            }
                            else
                            {
                                ctrlsm = CTRL_RAMP_SETUP;
                                if (setpoint < ctrl.currentsp)
                                {
                                    ctrl.downdir = true;
                                    ctrl.updir = false;
                                }
                                else
                                {
                                    ctrl.downdir = false;
                                    ctrl.updir = true;
                                }
                                return;
                            }
                        }
                    }

                    // controller implementation
                    if (ctrl.type == 1)
                    {
                        *cv = type1(&ctrl, tpsidiff, pv);
                    }
                    else if (ctrl.type == 2)
                    {
                        *cv = type2(&ctrl, tpsidiff, pv);
                    }
                    else if (ctrl.type == 3)
                    {
                        *cv = type3(&ctrl, tpsidiff, pv);
                    }
                    else if (ctrl.type == 5)
                    {
                        *cv = type5(&ctrl, tpsidiff, pv);
                        break;
                    }
                    else if (ctrl.type == 6)
                    {
                        *cv = type6(&ctrl, tpsidiff, pv);
                        //break;
                    }
                    else if (ctrl.type == 7)
                    {
                        *cv = type7(&ctrl, tpsidiff, pv);
                        //break;
                    }
                    else if (ctrl.type == 8)
                    {
                        *cv = type8(&ctrl, tpsidiff, pv);
                        //break;
                    }
                    else if (ctrl.type == 9)
                    {
                        *cv = type9(&ctrl, tpsidiff, pv);
                        //break;
                    }
                    else
                    {
                        *cv = typearm(&ctrl, tpsidiff, pv);


                    }
                    ctrl.normalizeddrive = ctrl.invertdrive == 1 ? 1.0f - *cv : *cv;
                    *cv = ctrl.normalizeddrive;
                    //if (!ctrl.saturated)
                    {
                        // apply controller inversion here
                        //            ctrl.normalizeddrive = ctrl.invertdrive == 1 ? 1.0f - *cv : *cv;
                        //            getStepMotor()->set_position = ctrl.normalizeddrive;
                        //ctrl.transSMState = STATE_MOVE;
                        ctrl.currSMState = 99;
                    }
                    break;
            }
            break;
    }
}

/**
*/
void actuatorControl(uint8_t stateRequest)
{


    ctrl.direction = 1.0f * stateRequest;
    StepMotorCtrl(stateRequest); // set direction of shaft movement 1 up; 2 down; 3 stop

    return;


    /**
      This is the normal position request loop. Use this for PID, GLL Fuzzy
    */

    if (ctrl.currSMState == stateRequest)
    {
        return; // bail out. no need to command stepper motor
    }

    switch (stateRequest)
    {
        case STATE_HOME:
            StepMotorHomming(HOME_INIT);
            ctrl.currSMState = stateRequest;

            break;
        case STATE_FOPEN:
            getStepMotor()->set_position = ctrl.normalizeddrive;
            StepMotorCtrl(getStepMotor()->set_position);
            ctrl.currSMState = stateRequest;

            break;
        case STATE_MOVE:
            //if (!getStepMotor()->op_complete)
        {
            //getStepMotor()->set_position = ctrl.normalizeddrive;
            if (StepMotorStateProc(STATE_MOVE) == 1)
            {
                getStepMotor()->op_complete = 0;
                ctrl.currSMState = STATE_IDLE;
            }
        }
        break;
        case STATE_IDLE:
            // do nothing
            break;
    }

}
