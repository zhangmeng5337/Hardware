typedef struct
{
    float setpoint;                 // 定义设定值
    float pv;              // 定义实际值
    float error;                    // 定义偏差值
    float err_k_1;              // 定义偏差值(k-1)
    float err_k_2;              // 定义偏差值(k-2)
    float err;
    float Kp, Ki, Kd;               // 定义比例、积分、微分系数
    float umax;
    float umin;
    float crack2;   //积分分离阈值
    float crack1;//积分项
    float cv;
    float increment;
    float interal;
    unsigned char controller_type;//0:increment 1:position
    unsigned char inter_enable;
} pid_stru;



typedef enum
{
    CTRL_OFF = 0,
    CTRL_CRACK,
    CTRL_RAMP_SETUP,
    CTRL_NORMAL
} ctrl_state;

typedef struct
{
    // inputs
    PiPtr       pi;     // LL structure (WR8)
    float       cmd;    // Command value (DR0) fcCompositeSetpoint
    float       flow;   // current measured flow fmNormalizedFlow
    // intermediate values
    float       gterm;  // Gain term (WR10)
    float       dterm;
    float       fbk;    // Feedback value (DR4)
    float       error;
    //  float       pterm;
    //  float       iterm;
    // outputs
    float       ctrlv;  // LL controller output (DR0)
    uint16_t      flags;  // PID overflow flags (R10)

    float		u;
    float		v;
    float		br;

} GllRecord, *GllPtr;
