{
    uint8_t override;
    uint8_t status;
} dns_saa_struct;

typedef struct
{
    float pvariable;
    uint8_t status;
} dns_ssc_struct;

typedef struct
{
    float   pzfValue;
    float   pzfPoleGain;
    float   pzfZeroGain;
} PzfRecord;

typedef struct
{
    float       piIntegral;     // previous integrator output
    float       piIGain;
    float       piPGain;
    PzfRecord   pidDFilter;
    float       llDTerm;        // result of D-term calculation
    float       ffValue;
    float       fcGllOutput;
    float       pTerm;
} PiRecord, *PiPtr;

typedef struct
{
    uint8_t idx;
    float fny[FFDPSPAN];
    float m;
} mffdp_struct;
// ==================== 控制器状态 ====================
typedef struct {
    float integral;         // 积分项
