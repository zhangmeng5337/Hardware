//void contronller_pid(float pv, float setpoint, float *cv)
//{
//    float tpsidiff = 0.0f;
//    *cv = typearm2(&ctrl2, tpsidiff, pv);
//    ctrl2.normalizeddrive = ctrl.invertdrive == 1 ? 1.0f - *cv : *cv;
//    //ctrl2.normalizeddrive = ctrl2.invertdrive == *cv;
//    *cv = ctrl2.normalizeddrive;
