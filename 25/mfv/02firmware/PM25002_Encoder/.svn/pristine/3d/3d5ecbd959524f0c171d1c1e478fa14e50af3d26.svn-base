/**
  @brief TYPE 5 Controller Algorithm
         Fuzzy logic for PM25
*/
float type5(ctrl_struct *pctrl, float tpsidiff, float pv)
{

    //  GllRecord gll;
    //  pctrl->fcGll.piPGain = pctrl->Pgain;
    //  pctrl->fcGll.piIGain = pctrl->Igain;
    //  pctrl->fcGll.pidDFilter.pzfPoleGain = pctrl->Dgain;
    //  pctrl->fcGll.pidDFilter.pzfZeroGain = pctrl->D2gain;
    //  gll.pi = &pctrl->fcGll;
    //  gll.cmd = pctrl->setpoint;
    //  gll.gterm = pctrl->fcGllGain;
    //  gll.flow = pv;
    //  gllStep(&gll);
    //  pctrl->pterm = gll.pi->pTerm;
    //  pctrl->iterm = gll.pi->piIntegral;
    //  pctrl->dterm = gll.dterm;
    //  if (gll.error > 0.0f) {
    //    pctrl->transSMState = MOVE_DOWN;
    //  } else if (gll.error < 0.0f) {
    //    pctrl->transSMState = MOVE_UP;
    //  } else {
    //    pctrl->transSMState = MOVE_STOP;
    //  }
    //
    //  pctrl->sm->freq = fabsf(9000.0f * gll.ctrlv);
    //  return gll.ctrlv;


    //  float cv = 0.0f;
    //  pctrl->scaledKp = pctrl->Pgain;
    //  pctrl->scaledKiGas = pctrl->Igain;
    //  cv = PIDController_Update(&ctrl, pctrl->currentsp, pv);
    //  if (ctrl.error > 0.0f) {
    //    pctrl->transSMState = MOVE_DOWN;
    //  } else if (ctrl.error < 0.0f) {
    //    pctrl->transSMState = MOVE_UP;
    //  } else {
    //    pctrl->transSMState = MOVE_STOP;
    //  }
    //
    //  pctrl->sm->freq = fabsf(9000.0f * cv);
    //  return cv;

    pctrl->error = pv / pctrl->currentsp - 1.0f;
    if (pctrl->error < -0.0001f)  //00039f
    {

        pctrl->transSMState = MOVE_DOWN;
    }
    else if (pctrl->error > 0.0002f)
    {


        pctrl->transSMState = MOVE_UP;
    }
    else
    {
        pctrl->transSMState = MOVE_STOP;
    }

    //pctrl->sm->error = pctrl->error;
    //  pctrl->transSMState = timer_freq_pre(pctrl->transSMState);
    //pctrl->sm->freq = max(3000.0f, min(6000.0f, 9000.0f * (fabsf(pctrl->error) * pctrl->Pgain)));
    return 0;

}
void PID_init()
{
    pid_usr.setpoint = 0.0;
    pid_usr.pv = 0.0;
    pid_usr.error = 0.0;
    pid_usr.err_k_2 = 0.0;
    pid_usr.err_k_1 = 0.0;
    pid_usr.err = 0.0;
    pid_usr.Kp = 6;                   // 需要自行整定
    pid_usr.Ki =
        0.1;                   // 注意，和普通增量，以及积分分离类型相比，这里加大了积分环节的值
    pid_usr.Kd = 0;
    pid_usr.interal = 0;
    pid_usr.crack2 = 0.001; //
    pid_usr.crack1 = 0;
    pid_usr.inter_enable = 0;
    pid_usr.umax = 1;
    pid_usr.umin = 0;
    pid_usr.cv = 0;
    pid_usr.controller_type = 1;
    pid_usr.increment = 0;

}
float out1 = 0.5;
float out2 = 5;
float out3 = 5, out4 = 2, out5 = 0.7, out6 = 2.6, out7 = 2.6, out8 = 4, out9 = 9;
float out;
float comp_out = 0;
float rate_now, rate_last;
float pre_last;
unsigned char div = 12, div_count = 10;
unsigned char step;
float pth1 = 0.7, pth2 = 0.3, pth3 = 0.35, pth4 = 0.019, pth5 = 0.035;


float ratio;
//float err_c1 = 100, err_c2 = 10, err_c3 = 1;
//float ramtim_tick = 0, pre_speed, ramp_flag = 0, pre_total_time;
//float open_valve_pre, open_valve_time, last_setpoint;
//float measure_first;
//float ramp_time_start = 10000;
//
//
//float pre_last, pre_measure;
//float err_t = 1.0;
//float pre_t = 1;
//float  interm_cof2 = 0.15;


//float range10TorrC1 = 100,range30TorrC1 = 10,range100TorrC1 = 1;
//float range1Sp=0.01,range2Sp=0.03,range3Sp=0.1;
//float slope_time,slope_pre,slope_flag,slope_total_time;
//float internalSpStartPre,internalSpStartPerc;
//float slopePoint1;
//float internalSpCtrlPoint= 10000;
//float internal_sp, interal_sp_ratio;
//unsigned char internal_state;
//float internalCtrlRatio=1,internalCtrlSpInterval=1;
//float slopeCtrlVal= 0.15;
//float slopeStableTime=60;
//float slopeMinPerr1 = 0.0001;
//float slopeMinPerr2=0.003;
float pre_measure;
float set_point_last;
unsigned char stable_time = 0;
unsigned char flag_inter = 0;
float timecof = 5;
float slope_set_val = 0.998;
float err_cof = 5;
float cof2 = 1;
float type11(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{
    static  unsigned int count = 0;


    if (set_point_last != ctrl_lcl->targetsp)//setpoint init
    {

        // ctrl_lcl->slopeCtrlVal3 = 0.75;
        ctrl_lcl->slope_flag = 0;
        ctrl_lcl->slope_pre = 0;
        ctrl_lcl->internalSpStartPre = 0;
        ctrl_lcl->slope_total_time = 0;
        ctrl_lcl->internal_state = 0;
        //        ctrl_lcl->slopeCtrlEn = 2;
        pre_measure = measurement;
        ctrl_lcl->piterm = 0;
        ctrl_lcl->ppterm = 0;
        ctrl_lcl->pout = 0;
        ctrl_lcl->slope_time = 0;
        ctrl_lcl->stableTimeout = 0;
        count = 0;
        stable_time  = 0;
        if (measurement > ctrl_lcl->targetsp)
        {
            ctrl_lcl->pressure_dir = 1;//dec pressure
        }
        else
        {
            ctrl_lcl->pressure_dir = 0; //inc pressure
        }

        //        if (set_point_last <= ctrl_lcl->targetsp)
        //            ctrl_lcl->pressure_dir = 0; //inc pressure
        //        else if (set_point_last > ctrl_lcl->targetsp)
        //            ctrl_lcl->pressure_dir = 1;//dec pressure
        //        else if (measurement > set_point_last)
        //            ctrl_lcl->pressure_dir = 1;//dec pressure
        set_point_last = ctrl_lcl->targetsp;
        // ctrl_lcl->slopeCtrlVal = nvmem.app.controllerObj.nSlopeCtrlVal;

    }

    ratio = measurement / ctrl_lcl->targetsp;

    if (ctrl_lcl->internal_state >= 1)
    {
        ctrl_lcl->interal_sp_ratio = measurement /  ctrl_lcl->internal_sp;
    }
    else
        ctrl_lcl->interal_sp_ratio = ratio;

    if (get_pos() > 0.05)
    {
        pre_measure = measurement;
        stable_time = 0;

    }
    else
    {
        if (get_pos() < 0.01)
        {
            ctrl_lcl->slopeCtrlVal2 = meter.pressure_slope;
		}


    }



    if (ctrl_lcl->pressure_dir == 0)
    {
        if (get_pos() <= 0.05 && ctrl_lcl->overShot_ctrl == 1) //rise pressure
        {

            if (stable_time++ >=  ctrl_lcl->slopeStableTime)//wait pressure stable
            {

                if ((measurement - pre_measure) >=  ctrl_lcl->slopeMinPerr1)//flow gas
                {
                    stable_time =  ctrl_lcl->slopeStableTime;
                    pre_measure = measurement;
                    ctrl_lcl->overShot_ctrl = 0;
                    ctrl_lcl->slopePoint1 = measurement;
                    ctrl_lcl->slope_flag = 1;
                    //                    ctrl_lcl->slopeCtrlEn = 1;
                }
                else
                {

                    {
                        stable_time = 0;
                        return 0;
                    }

                }

            }

        }
        else if (ratio >= ctrl_lcl->slopeMinTh3 && ctrl_lcl->overShot_ctrl == 1)
        {
            pre_measure = measurement;
            ctrl_lcl->overShot_ctrl = 0;
            ctrl_lcl->slopePoint1 = measurement;
            ctrl_lcl->slope_flag = 1;
            //            ctrl_lcl->slopeCtrlEn = 1;
        }
    }
    else if (ctrl_lcl->pressure_dir == 1)//down mode
    {
        ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
        //        if ((ctrl_lcl->targetsp - measurement) >= ctrl_lcl->slopeCtrlPreTh)
        //            ctrl_lcl->slopeCtrlEn = 1;

    }


    if (ctrl_lcl->pressure_dir == 0)
    {
        if (ctrl_lcl->slope_flag == 1)//cal slope ctrl point pressure
        {

            if (measurement >= (ctrl_lcl->slopePoint1 +  ctrl_lcl->slopeMinPerr2) ||
                    (ctrl_lcl->targetsp - measurement) <  ctrl_lcl->slopeMinPerr2 ||
                    ratio >= ctrl_lcl->slopeMinTh3)
            {
                ctrl_lcl->slope_flag = 2;
                ctrl_lcl->slope_pre = (measurement -  ctrl_lcl->slopePoint1) * 100000 /  ctrl_lcl->slope_time / 3;
                ctrl_lcl->slope_total_time = (ctrl_lcl->targetsp - measurement) * 1000000 /  ctrl_lcl->slope_pre;
                if (ctrl_lcl->slope_total_time >  ctrl_lcl->internalSpCtrlPoint)
                {
                    ctrl_lcl->internalSpStartPerc = (ctrl_lcl->slope_total_time -  ctrl_lcl->internalSpCtrlPoint) /
                                                    ctrl_lcl->slope_total_time;
                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    ctrl_lcl->internalSpStartPre = measurement +  ctrl_lcl->internalSpStartPerc * (ctrl_lcl->targetsp - measurement);
                    if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <= ctrl_lcl->slopeMinTh1) //0.05
                        ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeMin1;//0.02;//ctrl_lcl->slopeCtrlVal / 6;
                    else if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <=  ctrl_lcl->slopeMinTh2) //0.07
                        ctrl_lcl->slopeCtrlVal2 = ctrl_lcl->slopeMin2;// 0.025;//ctrl_lcl->slopeCtrlVal / 4;

                    ctrl_lcl->slopeCtrlMode = 0;
                }

                else
                {
                    ctrl_lcl->slopeCtrlMode = 1;

                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    if (get_pos() > 0.11)
                    {
                        if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                            ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeCtrlVal * 1.5;
                    }
                    else  if (get_pos() > 0.15)
                    {
                        if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                            ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeCtrlVal * 2;
                    }

                    else
                    {

                        if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                            ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeMin2;
                    }
                    ctrl_lcl->internalSpStartPre = measurement;// +  ctrl_lcl->internalSpStartPerc * (ctrl_lcl->targetsp - measurement);
                }



                //ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                ctrl_lcl->slope_time = 0;
                ctrl_lcl->slopePoint1 = 0;
                ctrl_lcl->internal_state = 1;

                //                if (ctrl_lcl->internalSpStartPre / ctrl_lcl->targetsp <= 0.82)
                //                    ctrl_lcl->internalSpStartPre = ctrl_lcl->targetsp * 0.82;
            }
            else
            {

                ctrl_lcl->slope_time++;
            }

        }
    }
    else
    {
        if (ctrl_lcl->slope_flag == 1)
        {
            ctrl_lcl->internal_state = 1;
            ctrl_lcl->slope_flag = 2;
        }

    }


    if (ctrl_lcl->internal_state == 1 || ctrl_lcl->internal_state == 2)
    {
        if (meter.pressure_slope > ctrl_lcl->slopeCtrlVal2)
        {
            ctrl_lcl->slopeCtrlVal2 = meter.pressure_slope;
        }
    }




    switch (ctrl_lcl->internal_state)
    {
        case 0:
            ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            ctrl_lcl->internal_state = 0;
            break;
        case 1:
            if (fabs(ctrl_lcl->targetsp) >= 0.01 &&  ctrl_lcl->slope_flag > 0 && ctrl_lcl->pressure_dir == 0)
            {
                if (measurement >=  ctrl_lcl->internalSpStartPre &&  ctrl_lcl->internalSpStartPre > 0)
                {
                    //                    if ((ctrl_lcl->targetsp - measurement) < (ctrl_lcl->interal_sp_ratio *  ctrl_lcl->internal_sp +
                    //                            ctrl_lcl->internalCtrlSpInterval / 1000) && (ctrl_lcl->targetsp - measurement) > 0)
                    //                        ctrl_lcl->internal_sp =  ctrl_lcl->interal_sp_ratio *  ctrl_lcl->internal_sp +  ctrl_lcl->internalCtrlSpInterval / 1000;
                    //                    else
                    if (measurement < ctrl_lcl->targetsp)
                    {
                        ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
                        ctrl_lcl->internal_state = 2;
                    }
                    else
                    {
                        ctrl_lcl->internal_state = 4;
                        ctrl_lcl->pressure_dir = 1;
                    }


                }
                else
                    ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            }
            else
            {
                ctrl_lcl->internal_state = 3;
                ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            }
            //            if (meter.pressure_slope <  ctrl_lcl->slopeCtrlVal)
            //            {
            //                ctrl_lcl->slopeCtrlVal = meter.pressure_slope * 0.9;
            //            }

            break;
        case 2:
            ctrl_lcl->internal_sp =  ctrl_lcl->internal_sp;
            ctrl_lcl->internal_state = 2;
            if (ctrl_lcl->interal_sp_ratio >= slope_set_val  ||
                    ctrl_lcl->stableTimeout >= ctrl_lcl->stableTimeTh)//40
            {
                ctrl_lcl->iterm = ctrl_lcl->pout;//ctrl_lcl->piterm;
                ctrl_lcl->pterm = 0;//ctrl_lcl->ppterm;
                ctrl_lcl->internal_state = 3;
                ctrl_lcl->stableTimeout = 0;

            }
            else
            {
                static float out_last;

                if (ctrl_lcl->pout == 0)
                {
                    if (ctrl_lcl->out >= 0.95)
                        out_last = 0.91;
                    else
                        out_last = ctrl_lcl->out;
                    ctrl_lcl->out = 0;
                }
                if (ctrl_lcl->slopeCtrlVal2 > 4 * ctrl_lcl->slopeCtrlVal)
                    ctrl_lcl->pressureChangeSlope = ctrl_lcl->targetsp - ctrl_lcl->slopeCtrlVal2 / 100 / 2 * ctrl_lcl->slopeCtrlVal3;
                else
                    ctrl_lcl->pressureChangeSlope = ctrl_lcl->targetsp - ctrl_lcl->slopeCtrlVal / 100 * ctrl_lcl->slopeCtrlVal3;
                if (measurement >= ctrl_lcl->pressureChangeSlope)
                {
                    if(ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeMin3)
 						ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.8;
					else
                    ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;// close to set point change speed

                    {
                        if (ctrl_lcl->slopeCtrlVal > ctrl_lcl->slopeCtrlVal2 / 2)
                            cof2 = 1;
                        else
                        {
                            //                            cof2 = -2.7 * ctrl_lcl->slopeCtrlVal2 + 1.27;
                            cof2 = ctrl_lcl->slopeCtrlK * ctrl_lcl->slopeCtrlVal2 + ctrl_lcl->slopeCtrlB;

                            if (cof2 <= ctrl_lcl->slopeCtrlMinCof)
                                cof2 = ctrl_lcl->slopeCtrlMinCof;//0.2;
                            if (cof2 > 1)
                                cof2 = 1;
                        }


                    }

                }

                else
                {
                    {
                        if (ctrl_lcl->slopeCtrlMode == 0)//valve close
                        {
                            if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 2.5)
                            {

                                cof2 =  1;
                                if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.6;//0.8
                                else
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal;

                            }

                            else
                            {
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2;
                                if ((ctrl_lcl->targetsp - ctrl_lcl->internalSpStartPre) <= ctrl_lcl->set_slope * 4 / 100 ||
                                        ctrl_lcl->slopeCtrlVal > ctrl_lcl->slopeCtrlVal2)
                                    cof2 = 1;
                                else
                                {
                                    //                                    cof2 = -2.7 * ctrl_lcl->set_slope + 1.27;
                                    if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 2.5)
                                        cof2 = 1;
                                    else
                                    {
                                        cof2 = ctrl_lcl->slopeCtrlK * ctrl_lcl->slopeCtrlVal2 + ctrl_lcl->slopeCtrlB;
                                        if (cof2 <= ctrl_lcl->slopeCtrlMinCof)
                                            cof2 = ctrl_lcl->slopeCtrlMinCof;//0.2;
                                        if (cof2 > 1)
                                            cof2 = 1;
                                    }


                                }

                            }

                        }
                        else
                        {


                            if (ctrl_lcl->slopeCtrlVal2 > ctrl_lcl->slopeCtrlVal)
                            {
                                cof2 =  1;
                                if (ctrl_lcl->slopeCtrlVal > ctrl_lcl->slopeCtrlVal2 / 2)
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 * 0.6 ; ///1.5
                                else

                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2 ; ///1.5
                            }

                            else
                            {
                                if (2 * ctrl_lcl->slopeCtrlVal2 >= ctrl_lcl->slopeCtrlVal)
                                {
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2; ///
                                    if ((ctrl_lcl->targetsp - ctrl_lcl->internalSpStartPre) <= ctrl_lcl->set_slope * 4 / 100)
                                        cof2 = 1;
                                    else
                                    {
                                        //                                        cof2 = -2.7 * ctrl_lcl->set_slope + 1.27;
                                        //                                        if (cof2 <= 0.1)
                                        //                                            cof2 = 0.1;
                                        cof2 = ctrl_lcl->slopeCtrlK * ctrl_lcl->slopeCtrlVal2 + ctrl_lcl->slopeCtrlB;
                                        if (cof2 <= ctrl_lcl->slopeCtrlMinCof)
                                            cof2 = ctrl_lcl->slopeCtrlMinCof;//0.2;
                                        if (cof2 > 1)
                                            cof2 = 1;
                                    }
                                }

                                else
                                {
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2;//
                                    cof2 = 1;
                                }
                            }

                        }
                    }
                }

                unsigned char slopeEn = 0;
                float tmp4;
                tmp4 = meter.pressure_slope / ctrl_lcl->set_slope;
                if (meter.pressure_slope < ctrl_lcl->set_slope && meter.pressure_slope >= ctrl_lcl->slopeMin4)
                {
                    if (ctrl_lcl->set_slope > ctrl_lcl->slopeMin3 &&
                            meter.pressure_slope < ctrl_lcl->set_slope &&
                            meter.pressure_slope >= ctrl_lcl->slopeMin3)
                    {



                        if (fabsf(tmp4) <= 1.05 && fabsf(meter.pressure_slope) >=  ctrl_lcl->set_slope / 3)
// 					if (fabsf(tmp4) <= 1.2 && fabsf(tmp4) >= 0.5)

						slopeEn = 0;
                        else
                            slopeEn = 1;

                    }
                    else
                        slopeEn = 1;

                    if (ctrl_lcl->set_slope == ctrl_lcl->slopeMin3)
                    {
                    if (fabsf(tmp4) <= 1.05 && fabsf(meter.pressure_slope) >=  ctrl_lcl->set_slope / 2.5)
                       
//                        if (fabsf(tmp4) <= 1.1 && fabsf(tmp4) >= 0.3)
                        {
                            slopeEn = 0;
							//if(ratio >= 0.998)
                            	ctrl_lcl->stableTimeout ++;
                        }
                        else
                        {
                            ctrl_lcl->stableTimeout = 0;
                            slopeEn = 1;

                        }

                    }

                }
                else
                    slopeEn = 1;
                if (slopeEn == 1)
                {
                    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                    {
                        ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                    }
                    else
                        ctrl_lcl->perror =  ctrl_lcl->set_slope - meter.pressure_slope  ;
                    ctrl_lcl->piterm = ctrl_lcl->piterm + cof2 * ctrl_lcl->pIgain * ctrl_lcl->perror;
                    ctrl_lcl->ppterm = cof2 * ctrl_lcl->pPgain * ctrl_lcl->perror;
                    ctrl_lcl->pout = ctrl_lcl->ppterm + ctrl_lcl->piterm + out_last;
                    if (ctrl_lcl->pout > 0.9)
                        ctrl_lcl->pout = 0.91;

                }

            }
            break;

        case 3:
            ctrl_lcl->internal_sp =  ctrl_lcl->internal_sp;
            //ctrl_lcl->pout = 0;
            ctrl_lcl->internal_state = 4;


            break;
        case 4:
            //;internal_sp = internal_sp;
            break;
        default:
            ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            break;
    }

    //pid realized *******************************************************
    if (ctrl_lcl->internal_state == 0)
        ctrl_lcl->error = ctrl_lcl->targetsp - measurement;
    else
        ctrl_lcl->error =  ctrl_lcl->internal_sp - measurement;


    if (ctrl_lcl->targetsp <= 1)//误差分段处理
    {
        if (ctrl_lcl->targetsp <=  ctrl_lcl->range1Sp)//10torr
        {
            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range10TorrC1;
        }
        else     if (ctrl_lcl->targetsp <  ctrl_lcl->range2Sp)//30torr
        {
            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range30TorrC1;
        }
        else     if (ctrl_lcl->targetsp <=  ctrl_lcl->range3Sp)//100torr
        {

            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range100TorrC1;

        }
        else
        {

            ctrl_lcl->error = ctrl_lcl->error;
        }

    }


    //*******************pid realize*******
    //     if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl->pressure_dir == 1 &&
    //            ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
    if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
    {

        ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * ctrl_lcl->pidPgainCof;//change p speed
        if (fabsf(ctrl_lcl->pterm) >= 0.8)
        {
            if (ctrl_lcl->pterm >= 0.8)
                ctrl_lcl->pterm = 0.8;
            else
                ctrl_lcl->pterm = -0.8;
        }

        ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);
    }
    else
    {
        static float cof_tmp;
        if (ctrl_lcl->pressure_dir == 1)//down mode
        {
            cof_tmp = ctrl_lcl->pidPgianCofDW;
            ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * cof_tmp;
            ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);
        }
        else
        {
            if (ctrl_lcl->internal_state != 2 &&
                    ctrl_lcl->internal_state != 3)
            {

                cof_tmp = 0;
                ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error;
                ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);

            }


        }

    }


    // iterm process****************************************************
    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        if (ctrl_lcl->error < 0 &&
                ctrl_lcl->internal_state != 2 && ctrl_lcl->internal_state != 3)//积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {
        if (ctrl_lcl->error > 0 &&
                ctrl_lcl->internal_state != 2 && ctrl_lcl->internal_state != 3) //积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else
    {
        if ((ratio > 1.2 || ratio < 0.3) &&
                ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->pidIgainCof * ctrl_lcl->Igain * (ctrl_lcl->error +
                              ctrl_lcl->pprevError)  / 2 ;//change i speed

        }
        else
        {
            float cof_tmp2;
            if (ctrl_lcl->pressure_dir == 1)
            {

                cof_tmp2 = ctrl_lcl->pidIgainCofDW;
                if (fabsf(meter.pressure_slope) <= 0.02)
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->slopeCrack * ctrl_lcl->pidIgainCofDW * ctrl_lcl->Igain *
                                      (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

                else
                    ctrl_lcl->iterm = ctrl_lcl->iterm + cof_tmp2 * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

            }
            else
            {

                if (ctrl_lcl->internal_state != 2 &&
                        ctrl_lcl->internal_state != 3)
                {
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;

                }
            }

        }


    }


    //ctrl_lcl->iterm = ctrl_lcl->iterm +  comp_out *  igain_cof;
    if (ctrl_lcl->iterm >= ctrl_lcl->isath * 0.9) //积分限幅
    {

        if (ctrl_lcl->out >= ctrl_lcl->isath)
            ctrl_lcl->iterm = ctrl_lcl->isath * 0.9 ;
    }
    else  if (ctrl_lcl->iterm <= ctrl_lcl->isatl)
    {
        if (ctrl_lcl->out <= ctrl_lcl->isatl)
            ctrl_lcl->iterm = ctrl_lcl->isatl;
    }


    if (ctrl_lcl->pout >= (ctrl_lcl->isath + 1))
    {
        ctrl_lcl->pout = ctrl_lcl->isath + 1;
    }
    else if (ctrl_lcl->pout <= (ctrl_lcl->isatl - 1))
    {
        ctrl_lcl->pout = ctrl_lcl->isatl - 1;
    }


    //    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
    //        ctrl_lcl->itermT = 1;
    //    else
    //        ctrl_lcl->itermT = 1;
    if (ctrl_lcl->internal_state < 2)
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else  if (ctrl_lcl->internal_state == 2)
    {
        if (ctrl_lcl->pout != 0)
            ctrl_lcl->out =  ctrl_lcl->pout; //
        else
            ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
        ctrl_lcl->out =  ctrl_lcl->out;// + ctrl_lcl->pout; //
        ctrl_lcl->pout = 0;
    }

    out = ctrl_lcl->out;
    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        out = ctrl_lcl->isath;
        //        ctrl_lcl->out = ctrl_lcl->isath;
    }
    else if (ctrl_lcl->out <= ctrl_lcl->isatl)
    {
        out = ctrl_lcl->isatl;
        ctrl_lcl->out = ctrl_lcl->isatl;
    }

    ctrl_lcl->pprevError = ctrl_lcl->error;
    return out;


}
float type10(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
{
    static  unsigned int count = 0;


    if (set_point_last != ctrl_lcl->targetsp)//setpoint init
    {
        ctrl_lcl->slopeMin4 = 0.01;

        ctrl_lcl->slope_flag = 0;
        ctrl_lcl->slope_pre = 0;
        ctrl_lcl->internalSpStartPre = 0;
        ctrl_lcl->slope_total_time = 0;
        ctrl_lcl->internal_state = 0;
        //        ctrl_lcl->slopeCtrlEn = 2;
        pre_measure = measurement;
        ctrl_lcl->piterm = 0;
        ctrl_lcl->ppterm = 0;
        ctrl_lcl->pout = 0;
        count = 0;
        stable_time  = 0;
        if (measurement > ctrl_lcl->targetsp)
        {
            ctrl_lcl->pressure_dir = 1;//dec pressure
        }
        else
        {
            ctrl_lcl->pressure_dir = 0; //inc pressure
        }

        //        if (set_point_last <= ctrl_lcl->targetsp)
        //            ctrl_lcl->pressure_dir = 0; //inc pressure
        //        else if (set_point_last > ctrl_lcl->targetsp)
        //            ctrl_lcl->pressure_dir = 1;//dec pressure
        //        else if (measurement > set_point_last)
        //            ctrl_lcl->pressure_dir = 1;//dec pressure
        set_point_last = ctrl_lcl->targetsp;
        // ctrl_lcl->slopeCtrlVal = nvmem.app.controllerObj.nSlopeCtrlVal;

    }

    ratio = measurement / ctrl_lcl->targetsp;

    if (ctrl_lcl->internal_state >= 1)
    {
        ctrl_lcl->interal_sp_ratio = measurement /  ctrl_lcl->internal_sp;
    }
    else
        ctrl_lcl->interal_sp_ratio = ratio;

    if (get_pos() > 0.05)
    {
        pre_measure = measurement;
        stable_time = 0;
    }



    if (ctrl_lcl->pressure_dir == 0)
    {
        if (get_pos() <= 0.05 && ctrl_lcl->overShot_ctrl == 1) //rise pressure
        {

            if (stable_time++ >=  ctrl_lcl->slopeStableTime)//wait pressure stable
            {

                if ((measurement - pre_measure) >=  ctrl_lcl->slopeMinPerr1)//flow gas
                {
                    stable_time =  ctrl_lcl->slopeStableTime;
                    pre_measure = measurement;
                    ctrl_lcl->overShot_ctrl = 0;
                    ctrl_lcl->slopePoint1 = measurement;
                    ctrl_lcl->slope_flag = 1;
                    //                    ctrl_lcl->slopeCtrlEn = 1;
                }
                else
                {

                    {
                        stable_time = 0;
                        return 0;
                    }

                }

            }

        }
        else if ((ctrl_lcl->targetsp - measurement) <= ctrl_lcl->slopeCtrlPreTh &&
                 ctrl_lcl->overShot_ctrl == 1)//rise pressure but pressure error too small
        {
            ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
            ctrl_lcl->overShot_ctrl = 0;
            //            ctrl_lcl->slopeCtrlEn = 2;
            if (ctrl_lcl->slope_flag == 0)
                ctrl_lcl->slope_flag = 1;
        }
    }

    else if (ctrl_lcl->pressure_dir == 1)//down mode
    {
        if (ctrl_lcl->slope_flag == 0)
            ctrl_lcl->slope_flag = 1;
        ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
        //        if ((ctrl_lcl->targetsp - measurement) >= ctrl_lcl->slopeCtrlPreTh)
        //            ctrl_lcl->slopeCtrlEn = 1;

    }


    if (ctrl_lcl->pressure_dir == 0)
    {
        if (ctrl_lcl->slope_flag == 1)//cal slope ctrl point pressure
        {

            if (measurement >= (ctrl_lcl->slopePoint1 +  ctrl_lcl->slopeMinPerr2) ||
                    (ctrl_lcl->targetsp - measurement) <  ctrl_lcl->slopeMinPerr2)
            {
                ctrl_lcl->slope_flag = 2;
                ctrl_lcl->slope_pre = (measurement -  ctrl_lcl->slopePoint1) * 100000 /  ctrl_lcl->slope_time / 3;
                ctrl_lcl->slope_total_time = (ctrl_lcl->targetsp - measurement) * 1000000 /  ctrl_lcl->slope_pre;
                if (ctrl_lcl->slope_total_time >  ctrl_lcl->internalSpCtrlPoint)
                {
                    ctrl_lcl->internalSpStartPerc = (ctrl_lcl->slope_total_time -  ctrl_lcl->internalSpCtrlPoint) /
                                                    ctrl_lcl->slope_total_time;
                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <= ctrl_lcl->slopeMinTh1) //0.05
                        ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeMin1;//0.02;//ctrl_lcl->slopeCtrlVal / 6;
                    else if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <=  ctrl_lcl->slopeMinTh2) //0.07
                        ctrl_lcl->slopeCtrlVal2 = ctrl_lcl->slopeMin2;// 0.025;//ctrl_lcl->slopeCtrlVal / 4;

                    ctrl_lcl->slopeCtrlMode = 0;
                }

                else
                {
                    ctrl_lcl->slopeCtrlMode = 1;
                    if ((ctrl_lcl->targetsp - measurement) <=  ctrl_lcl->slopeCtrlPreTh)
                        ctrl_lcl->internalSpStartPerc = 0;
                    else
                        ctrl_lcl->internalSpStartPerc = 0.1;
                    ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                    //					if (get_pos() > 0.15 && ctrl_lcl->slopeCtrlVal2 >= ctrl_lcl->slopeMinTh1)
                    if (get_pos() > 0.15)
                    {
                        ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeCtrlVal * 1.5;
                    }
                    else
                    {
                        if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <= ctrl_lcl->slopeMinTh1)
                            ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeMin1;//0.02;//ctrl_lcl->slopeCtrlVal / 6;
                        else if (fabsf(ctrl_lcl->slopeCtrlVal - ctrl_lcl->slopeCtrlVal2) <= ctrl_lcl->slopeMinTh2)
                            ctrl_lcl->slopeCtrlVal2 =  ctrl_lcl->slopeMin2;//0.025;//ctrl_lcl->slopeCtrlVal /
                    }

                }


                ctrl_lcl->internalSpStartPre = measurement +  ctrl_lcl->internalSpStartPerc * (ctrl_lcl->targetsp - measurement);
                //ctrl_lcl->slopeCtrlVal2 =  meter.pressure_slope;
                ctrl_lcl->slope_time = 0;
                ctrl_lcl->slopePoint1 = 0;
                ctrl_lcl->internal_state = 1;

                //                if (ctrl_lcl->internalSpStartPre / ctrl_lcl->targetsp <= 0.82)
                //                    ctrl_lcl->internalSpStartPre = ctrl_lcl->targetsp * 0.82;
            }
            else
            {

                ctrl_lcl->slope_time++;
            }

        }
    }
    else
    {
        if (ctrl_lcl->slope_flag == 1)
        {
            ctrl_lcl->internal_state = 1;
            ctrl_lcl->slope_flag = 2;
        }

    }







    switch (ctrl_lcl->internal_state)
    {
        case 0:
            ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            ctrl_lcl->internal_state = 4;
            break;
        case 1:
            if (fabs(ctrl_lcl->targetsp) >= 0.01 &&  ctrl_lcl->slope_flag > 0 && ctrl_lcl->pressure_dir == 0)
            {
                if (measurement >=  ctrl_lcl->internalSpStartPre &&  ctrl_lcl->internalSpStartPre > 0)
                {
                    //                    if ((ctrl_lcl->targetsp - measurement) < (ctrl_lcl->interal_sp_ratio *  ctrl_lcl->internal_sp +
                    //                            ctrl_lcl->internalCtrlSpInterval / 1000) && (ctrl_lcl->targetsp - measurement) > 0)
                    //                        ctrl_lcl->internal_sp =  ctrl_lcl->interal_sp_ratio *  ctrl_lcl->internal_sp +  ctrl_lcl->internalCtrlSpInterval / 1000;
                    //                    else
                    ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
                    ctrl_lcl->internal_state = 2;

                }
                else
                    ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            }
            else
            {
                ctrl_lcl->internal_state = 3;
                ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            }
            //            if (meter.pressure_slope <  ctrl_lcl->slopeCtrlVal)
            //            {
            //                ctrl_lcl->slopeCtrlVal = meter.pressure_slope * 0.9;
            //            }

            break;
        case 2:
            ctrl_lcl->internal_sp =  ctrl_lcl->internal_sp;
            ctrl_lcl->internal_state = 2;
            if (ctrl_lcl->interal_sp_ratio >= slope_set_val)
            {
                ctrl_lcl->iterm = ctrl_lcl->pout;//ctrl_lcl->piterm;
                ctrl_lcl->pterm = 0;//ctrl_lcl->ppterm;
                ctrl_lcl->internal_state = 3;

            }
            else
            {
                static float out_last;

                if (ctrl_lcl->pout == 0)
                {
                    out_last = ctrl_lcl->out;
                    ctrl_lcl->out = 0;
                }
                ctrl_lcl->pressureChangeSlope = ctrl_lcl->targetsp - ctrl_lcl->slopeCtrlVal2 / 100;
                if (measurement >= ctrl_lcl->pressureChangeSlope &&
                        ctrl_lcl->slopeCtrlVal2 > ctrl_lcl->slopeCtrlVal)
                {
                    ctrl_lcl->set_slope = ctrl_lcl->slopeMin3;// close to set point change speed

                }

                else
                {
                    if (ctrl_lcl->slopeCtrlVal > ctrl_lcl->slopeCtrlVal2)
                        ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2;
                    else
                    {
                        if (ctrl_lcl->slopeCtrlMode == 0)//valve close
                        {
                            if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 2.5)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal;
                            else
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2;
                        }
                        else
                        {


                            if (fabsf(ctrl_lcl->slopeCtrlVal2 / ctrl_lcl->slopeCtrlVal) < 1.5)
                                ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal ;///1.5
                            else
                            {
                                if (ctrl_lcl->slopeCtrlVal2 >= 2 * ctrl_lcl->slopeCtrlVal)
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2 / 2; ///
                                else
                                    ctrl_lcl->set_slope = ctrl_lcl->slopeCtrlVal2;//

                            }

                        }

                    }

                }


                unsigned char slopeEn = 0;
                if (meter.pressure_slope < ctrl_lcl->set_slope && meter.pressure_slope >= ctrl_lcl->slopeMin4)
                {
                    if (ctrl_lcl->set_slope > ctrl_lcl->slopeMin4 &&
                            meter.pressure_slope < ctrl_lcl->set_slope &&
                            meter.pressure_slope >= ctrl_lcl->slopeMin4)
                    {
                        float tmp4 ;
                        tmp4 = ctrl_lcl->set_slope / meter.pressure_slope;


                        if (tmp4 < 2 && tmp4 > 1)
                            slopeEn = 0;
                        else
                            slopeEn = 1;

                    }

                    if (ctrl_lcl->set_slope == ctrl_lcl->slopeMin4 &&
                            meter.pressure_slope >= ctrl_lcl->slopeMin4 / 2 &&
                            meter.pressure_slope <= ctrl_lcl->slopeMin4)
                        slopeEn = 0;
                    else
                        slopeEn = 1;
                }
                else
                    slopeEn = 1;
                if (slopeEn == 1)
                {
                    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
                    {
                        ctrl_lcl->perror =  err_cof * (ctrl_lcl->set_slope - meter.pressure_slope)  ;
                    }
                    else
                        ctrl_lcl->perror =  ctrl_lcl->set_slope - meter.pressure_slope  ;
                    ctrl_lcl->piterm = ctrl_lcl->piterm + ctrl_lcl->pIgain * ctrl_lcl->perror;
                    ctrl_lcl->ppterm = ctrl_lcl->pPgain * ctrl_lcl->perror;
                    ctrl_lcl->pout = ctrl_lcl->ppterm + ctrl_lcl->piterm + out_last;
                }

            }
            break;

        case 3:
            ctrl_lcl->internal_sp =  ctrl_lcl->internal_sp;
            //ctrl_lcl->pout = 0;
            ctrl_lcl->internal_state = 4;


            break;
        case 4:
            //;internal_sp = internal_sp;
            break;
        default:
            ctrl_lcl->internal_sp = ctrl_lcl->targetsp;
            break;
    }

    //pid realized *******************************************************
    if (ctrl_lcl->internal_state == 0)
        ctrl_lcl->error = ctrl_lcl->targetsp - measurement;
    else
        ctrl_lcl->error =  ctrl_lcl->internal_sp - measurement;


    if (ctrl_lcl->targetsp <= 1)//误差分段处理
    {
        if (ctrl_lcl->targetsp <=  ctrl_lcl->range1Sp)//10torr
        {
            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range10TorrC1;
        }
        else     if (ctrl_lcl->targetsp <  ctrl_lcl->range2Sp)//30torr
        {
            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range30TorrC1;
        }
        else     if (ctrl_lcl->targetsp <=  ctrl_lcl->range3Sp)//100torr
        {

            ctrl_lcl->error = ctrl_lcl->error *  ctrl_lcl->range100TorrC1;

        }
        else
        {

            ctrl_lcl->error = ctrl_lcl->error;
        }

    }


    //*******************pid realize*******
    //     if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl->pressure_dir == 1 &&
    //            ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
    if ((ratio > 1.2 || ratio < 0.3) && ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
    {

        ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * ctrl_lcl->pidPgainCof;//change p speed
        if (fabsf(ctrl_lcl->pterm) >= 0.8)
        {
            if (ctrl_lcl->pterm >= 0.8)
                ctrl_lcl->pterm = 0.8;
            else
                ctrl_lcl->pterm = -0.8;
        }

        ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);
    }
    else
    {
        static float cof_tmp;
        if (ctrl_lcl->pressure_dir == 1)//down mode
        {
            cof_tmp = ctrl_lcl->pidPgianCofDW;
            ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error * cof_tmp;
            ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);
        }
        else
        {
            if (ctrl_lcl->internal_state != 2 &&
                    ctrl_lcl->internal_state != 3)
            {

                cof_tmp = 0;
                ctrl_lcl->pterm = ctrl_lcl->Pgain * ctrl_lcl->error;
                ctrl_lcl->dterm = ctrl_lcl->Dgain * (ctrl_lcl->error - ctrl_lcl->pprevError);

            }


        }

    }


    // iterm process****************************************************
    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        if (ctrl_lcl->error < 0 &&
                ctrl_lcl->internal_state != 2 && ctrl_lcl->internal_state != 3)//积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else if (ctrl_lcl->out < ctrl_lcl->isatl)
    {
        if (ctrl_lcl->error > 0 &&
                ctrl_lcl->internal_state != 2 && ctrl_lcl->internal_state != 3) //积分抗饱和
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;
        }
    }
    else
    {
        if ((ratio > 1.2 || ratio < 0.3) &&
                ctrl_lcl->targetsp >  ctrl_lcl->range1Sp)
        {
            ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->pidIgainCof * ctrl_lcl->Igain * (ctrl_lcl->error +
                              ctrl_lcl->pprevError)  / 2 ;//change i speed

        }
        else
        {
            float cof_tmp2;
            if (ctrl_lcl->pressure_dir == 1)
            {

                cof_tmp2 = ctrl_lcl->pidIgainCofDW;
                if (fabsf(meter.pressure_slope) <= 0.02)
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->slopeCrack * ctrl_lcl->pidIgainCofDW * ctrl_lcl->Igain *
                                      (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

                else
                    ctrl_lcl->iterm = ctrl_lcl->iterm + cof_tmp2 * ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2 ;

            }
            else
            {

                if (ctrl_lcl->internal_state != 2 &&
                        ctrl_lcl->internal_state != 3)
                {
                    ctrl_lcl->iterm = ctrl_lcl->iterm + ctrl_lcl->Igain * (ctrl_lcl->error + ctrl_lcl->pprevError)  / 2;

                }
            }

        }


    }


    //ctrl_lcl->iterm = ctrl_lcl->iterm +  comp_out *  igain_cof;
    if (ctrl_lcl->iterm >= ctrl_lcl->isath * 0.9) //积分限幅
    {

        if (ctrl_lcl->out >= ctrl_lcl->isath)
            ctrl_lcl->iterm = ctrl_lcl->isath * 0.9 ;
    }
    else  if (ctrl_lcl->iterm <= ctrl_lcl->isatl)
    {
        if (ctrl_lcl->out <= ctrl_lcl->isatl)
            ctrl_lcl->iterm = ctrl_lcl->isatl;
    }


    if (ctrl_lcl->pout >= (ctrl_lcl->isath + 1))
    {
        ctrl_lcl->pout = ctrl_lcl->isath + 1;
    }
    else if (ctrl_lcl->pout <= (ctrl_lcl->isatl - 1))
    {
        ctrl_lcl->pout = ctrl_lcl->isatl - 1;
    }


    //    if (ctrl_lcl->slopeCtrlVal2 < ctrl_lcl->slopeCtrlVal)
    //        ctrl_lcl->itermT = 1;
    //    else
    //        ctrl_lcl->itermT = 1;
    if (ctrl_lcl->internal_state < 2)
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else  if (ctrl_lcl->internal_state == 2)
    {
        if (ctrl_lcl->pout != 0)
            ctrl_lcl->out =  ctrl_lcl->pout; //
        else
            ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
    }
    else
    {
        ctrl_lcl->out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;
        ctrl_lcl->out =  ctrl_lcl->out;// + ctrl_lcl->pout; //
        ctrl_lcl->pout = 0;
    }

    out = ctrl_lcl->out;
    if (ctrl_lcl->out >= ctrl_lcl->isath * 0.95)
    {
        out = ctrl_lcl->isath;
        ctrl_lcl->out = ctrl_lcl->isath;
    }
    else if (ctrl_lcl->out <= ctrl_lcl->isatl)
    {
        out = ctrl_lcl->isatl;
        ctrl_lcl->out = ctrl_lcl->isatl;
    }

    ctrl_lcl->pprevError = ctrl_lcl->error;
    return out;


}
//float type9(ctrl_struct *ctrl_lcl, float tpsidiff, float measurement)
//{
//    static  unsigned int count = 0;
//    float slope_set_val;
//
//    if (set_point_last != ctrl_lcl->targetsp)//setpoint init
//    {
//
//        ctrl_lcl->slope_flag = 0;
//        ctrl_lcl->slope_pre = 0;
//        ctrl_lcl->internalSpStartPre = 0;
//        ctrl_lcl->slope_total_time = 0;
//        ctrl_lcl->internal_state = 0;
//        ctrl_lcl->slopeCtrlEn = 2;
//        pre_measure = measurement;
//        ctrl_lcl->piterm = 0;
//        ctrl_lcl->ppterm = 0;
//        ctrl_lcl->pout = 0;
//        count = 0;
