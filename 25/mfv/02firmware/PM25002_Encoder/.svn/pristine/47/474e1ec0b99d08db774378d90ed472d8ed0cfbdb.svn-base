/**
  @brief Initialization function for Discrete PID implementation with derivative filter of 10ms
*/
void PIDController_Init(ctrl_struct *ctrl_lcl)
{

    /* Clear controller variables */
    ctrl_lcl->pterm = 0.0f;

    ctrl_lcl->iterm = 0.0f;
    ctrl_lcl->prevError = 0.0f;

    ctrl_lcl->dterm = 0.0f;
    ctrl_lcl->prevMeasurement = 0.0f;

    ctrl_lcl->T = 0.002f;
    ctrl_lcl->tau = 0.01f;

    PID_init();
}

/**
  @brief Discrete PID implementation with derivative filter of 10ms
*/
float PIDController_Update(ctrl_struct *ctrl_lcl, float setpoint, float measurement)
{

    /* Error signal */
    ctrl_lcl->error = setpoint - measurement;

    /* Proportional */
    ctrl_lcl->pterm = ctrl_lcl->scaledKp * ctrl_lcl->error;

    /* Intgral */
    ctrl_lcl->iterm = ctrl_lcl->iterm + 0.5f * ctrl_lcl->scaledKiGas * 1000.0f * ctrl_lcl->T *
                      (ctrl_lcl->error + ctrl_lcl->prevError);

    /* Anit-windup via dynamic integraotr clamping */
    float limMinInt, limMaxInt;

    if (ctrl_lcl->isath > ctrl_lcl->pterm)
    {
        limMaxInt = ctrl_lcl->isath - ctrl_lcl->pterm;
    }
    else
    {
        limMaxInt = 0.0f;
    }

    if (ctrl_lcl->isatl < ctrl_lcl->pterm)
    {
        limMinInt = ctrl_lcl->isatl - ctrl_lcl->pterm;
    }
    else
    {
        limMinInt = 0.0f;
    }

    /* Clamp Integrator */
    if (ctrl_lcl->iterm > limMaxInt)
    {
        ctrl_lcl->iterm = limMaxInt;
    }
    else if (ctrl_lcl->iterm < limMinInt)
    {
        ctrl_lcl->iterm = limMinInt;
    }

    /* Derivative (band-limited differentiator) */
    ctrl_lcl->dterm = (2.0f * ctrl_lcl->Dgain * (measurement - ctrl_lcl->prevMeasurement)
                       + (2.0f * ctrl_lcl->tau - ctrl_lcl->T) * ctrl_lcl->dterm)
                      / (2.0f * ctrl_lcl->tau + ctrl_lcl->T);

    /* Compute output and apply limits */
    float out = ctrl_lcl->pterm + ctrl_lcl->iterm + ctrl_lcl->dterm;

    if (out > ctrl_lcl->isath)
    {
        out = ctrl_lcl->isath;
        ctrl_lcl->saturated = true;
    }
    else if (out < ctrl_lcl->isatl)
    {
        out = ctrl_lcl->isatl;
        ctrl_lcl->saturated = true;
    }
    else
    {
        ctrl_lcl->saturated = false;
    }

    /* Store error and measurement for later use */
    ctrl_lcl->prevError = ctrl_lcl->error;
    ctrl_lcl->prevMeasurement = measurement;

    /* return PID output */
    return out;

}

/**
*/
bool ffDPslope(float dp, mffdp_struct *mffdp)
{
    if (mffdp->idx < FFDPSPAN)
    {
        mffdp->fny[mffdp->idx++] = dp;
        mffdp->m = 0.0f;
        return false;
    }
    else
    {
        //mffdp->m = mcalc(mffdp->fny, mffdp->idx);
        for (int i = 0; i < FFDPSPAN - 1; i++)
        {
            mffdp->fny[i] = mffdp->fny[i + 1];
        }
        mffdp->fny[FFDPSPAN - 1] = dp;
    }

}

/**
  @brief Initialization function for GLL controller implementation
*/
void GLLController_Init(ctrl_struct *ctrl_lcl)
{

    /* Clear controller variables */
    ctrl_lcl->fcGll.piIntegral = 0.0f;
    ctrl_lcl->fcGll.pidDFilter.pzfValue = 0.0F;
    ctrl_lcl->fcGll.ffValue = 0.0F;
    //  ctrl->fcGllGain = 1.0f;
    //  ctrl->fcValveGain = 0.0F;
    //  ctrl->fcPlantGain = 0.0F;
    //  ctrl->fcActuatorGain = 0.0F;
}

/**
  @brief GLL controller
*/
static void gpiStep(GllPtr gll)   /*@modifies gll @*/
{
    float ctrl_error;
    float dummy;

    //D=ad*D-bd*(y-yold) % update derivative part
    ctrl_error = gll->gterm * (gll->cmd - gll->fbk);
    gll->error = ctrl_error;

    // P=kp*(b*r-y) % compute proportional part
    gll->pi->pTerm = ctrl_error * gll->pi->piPGain;

    // calculate FF value
    //	if (!( flowcontroller[0].fcFreeze & ((uint16_t)BIT00 << fcsFreezeFFvalue) ))
    //    ffDPslope(meter.psid, &ctrl.mffdp);
    //		gll->pi->ffValue = 0; //ctrl.mffdp.m * ctrl.ffGain;

    //	if (!( valvedriver[0].vdFreeze & ((uint16_t)BIT00 << vdsFreezeGllOutput) )) // if not frozen, update glloutput
    gll->pi->fcGllOutput = gll->pi->piIntegral + gll->pi->pTerm;

    // v=P+I+D % compute temporary output
    gll->v =  gll->pi->fcGllOutput;// + gll->pi->ffValue;

    // check saturation u
    gll->u = gll->v > ctrl.isatl ? (gll->v < ctrl.isath ? gll->v : ctrl.isath) : ctrl.isatl;
    //gll->u = gll->v > ctrl.icrack ? (gll->v < ctrl.isath ? gll->v : ctrl.isath) : ctrl.icrack;


    // update controller output
    gll->ctrlv = gll->u;

    // I=I+bi*(r-y)+br*(u-v) % update integral
    gll->br = 2 * gll->pi->piIGain;
    gll->pi->piIntegral += gll->pi->piIGain * ctrl_error + gll->br * (gll->u - gll->v);
    //	gll->iterm = gll->pi->piIntegral;

}

static float DStep(float x, PzfRecord *pzf) /*@modifies pzf->pzfValue@*/
{
    float   scaledDelta;
    scaledDelta = (x - pzf->pzfValue) * pzf->pzfPoleGain;
    pzf->pzfValue += scaledDelta;
    return scaledDelta * pzf->pzfZeroGain;
}

static void __llCore(GllPtr gll)
{
    gll->dterm = DStep(gll->flow, &gll->pi->pidDFilter);
    gll->fbk = gll->flow + gll->dterm;
    gll->pi->llDTerm = gll->fbk;
}

void gllStep(GllPtr gll)
{
    static float lastCtrlv = 0;
    gll->flags = 0;
    __llCore(gll);
    gpiStep(gll);
    lastCtrlv = gll->ctrlv;
}

/**
*/
float PC_controller(ctrl_struct *ctrl, float setpoint, float measurement)
{

    // Hybrid mode
    if ((setpoint / measurement - 1.0f) > 0.01)
    {
        return 0.5f;
    }
    else
    {
        return PIDController_Update(ctrl, setpoint, measurement);
    }

}

/**
  @breif retrun controller state
*/
ctrl_state getControllerState(void)
{
    return ctrlsm;
}

/**
	@breif Configures all live controller parameters with default values from non-volatile memory.
*/
void load_controller_parameters(float *sig1, float *sig2, float *pa)
{
    ctrl.Pgain = nvmem.app.controllerObj.pgain;//10
    ctrl.Igain = nvmem.app.controllerObj.igain;//0.15
    ctrl.Dgain = nvmem.app.controllerObj.dgain;
    ctrl.D2gain = 1.0f;
    ctrl.icrack = nvmem.app.controllerObj.icrack;
    ctrl.icrack2 = nvmem.app.controllerObj.icrack2;
    ctrl.turnondelay = nvmem.app.controllerObj.turnondelay;
    math_check(nvmem.app.controllerObj.isath, &ctrl.isath, 0.99f);
    ctrl.isath = nvmem.app.controllerObj.isath;
    math_check(nvmem.app.controllerObj.isatl, &ctrl.isatl, 0.0f);
    ctrl.isatl = nvmem.app.controllerObj.isatl;
    ctrl.invertdrive = nvmem.app.manufacturing.invertdrive;
    // limit shutoff threshold between 0.0f..2.0f. if beyond limits, revert to 0.2% ass cutoff
    float flt = nvmem.app.controllerObj.shutoffthreshold;
    math_check(nvmem.app.controllerObj.shutoffthreshold, &flt, 0.002f);
    nvmem.app.controllerObj.shutoffthreshold = flt;
    ctrl.shutoffthreshold = nvmem.app.controllerObj.shutoffthreshold < 0.0f ? 0.002f :
                            nvmem.app.controllerObj.shutoffthreshold > 2.0f ? 0.002f : nvmem.app.controllerObj.shutoffthreshold;
    ctrl.ramprate = (int32_t)nvmem.app.controllerObj.ramprate;
    ctrl.minramprate = nvmem.app.controllerObj.minramptime;
    switch (nvmem.app.controllerObj.fbsel)
    {
        case 2:
            ctrl.feedback = sig2;
            break;
        case 0:
        case 1:
        default:
            ctrl.feedback = sig1;
            break;
    }

    ctrl.type = nvmem.app.controllerObj.type; // controller implementation types

    PID.Kp = ctrl.Pgain;
    PID.Ki = ctrl.Igain;
    PID.Kd = ctrl.Dgain;
    /* Initialize PID system, float32_t format */
    arm_pid_init_f32(&PID, 1);

    // new controller setup
    ctrl.currentpressure = pa;
    PIDController_Init(&ctrl);
    //PressureControl_Init();

    // dynamic gain polynomial
    for (uint8_t idx = 0; idx < MAX_DYNAMIC_GAIN_TABLE; idx++)
    {
        ctrl.dynPtable[idx].x = nvmem.app.controllerObj.dynGain.SP.fxn[idx];
        ctrl.dynItable[idx].x = nvmem.app.controllerObj.dynGain.SP.fxn[idx];
        ctrl.dynPtable[idx].y = nvmem.app.controllerObj.dynGain.P.fxn[idx];
        ctrl.dynItable[idx].y = nvmem.app.controllerObj.dynGain.I.fxn[idx];
    }
    //	ctrl.inter1_th1 = nvmem.app.controllerObj.inter1_th1;
    //	ctrl.inter1_th2 = nvmem.app.controllerObj.inter1_th2;
    //	ctrl.inter2_th1 = nvmem.app.controllerObj.inter2_th1;
    //	ctrl.inter2_th1 = nvmem.app.controllerObj.inter2_th2;
    //	ctrl.inter3_th1 = nvmem.app.controllerObj.inter3_th1;
    //	ctrl.inter3_th2 = nvmem.app.controllerObj.inter3_th2;
    //	ctrl.inter1_scale = nvmem.app.controllerObj.inter1_scale;
    //	ctrl.inter2_scale = nvmem.app.controllerObj.inter2_scale;
    //	ctrl.inter3_scale = nvmem.app.controllerObj.inter3_scale;

    //    ctrl.pPgain = 0.003;
    //    ctrl.pIgain = 0.0052;
    //    ctrl.range10TorrC1 = 100;
    //    ctrl.range30TorrC1 = 10;
    //    ctrl.range100TorrC1 = 1;
    //    ctrl.range1Sp = 0.01;
    //    ctrl.range2Sp = 0.03;
    //    ctrl.range3Sp = 0.1;
    //    ctrl.internalSpCtrlPoint = 10000;
    //    ctrl.internalCtrlRatio = 1;
    //    ctrl.internalCtrlSpInterval = 1;
    //    ctrl.slopeCtrlVal = 0.15;
    //    ctrl.slopeStableTime = 60;
    //    ctrl.slopeMinPerr1 = 0.0001;
    //    ctrl.slopeMinPerr2 = 0.003;
    ctrl.pPgain = nvmem.app.controllerObj.nPPgain;
    ctrl.pIgain = nvmem.app.controllerObj.nPigain;
    ctrl.range10TorrC1 = nvmem.app.controllerObj.nRange10TorrC1;
    ctrl.range30TorrC1 = nvmem.app.controllerObj.nRange30TorrC1;
    ctrl.range100TorrC1 = nvmem.app.controllerObj.nRange100TorrC1;
    ctrl.range1Sp = nvmem.app.controllerObj.nRange1Sp;
    ctrl.range2Sp = nvmem.app.controllerObj.nRange2Sp;
    ctrl.range3Sp = nvmem.app.controllerObj.nRange3Sp;
    ctrl.internalSpCtrlPoint = nvmem.app.controllerObj.nInternalSpCtrlPoint;
    //    ctrl.internalCtrlRatio = nvmem.app.controllerObj.nInternalCtrlRatio;
    //    ctrl.internalCtrlSpInterval = nvmem.app.controllerObj.nInternalCtrlSpInterval;
    ctrl.slopeCtrlVal = nvmem.app.controllerObj.nSlopeCtrlVal;
    ctrl.slopeStableTime = nvmem.app.controllerObj.nSlopeStableTime;
    ctrl.slopeMinPerr1       = nvmem.app.controllerObj.nSlopeMinPerr1;
    ctrl.slopeMinPerr2       = nvmem.app.controllerObj.nSlopeMinPerr2;
    ctrl.pidPgianCofDW       =  nvmem.app.controllerObj.npidPgianCofDW;
    ctrl.pidIgainCofDW       =  nvmem.app.controllerObj.npidIgainCofDW;
    ctrl.pidIgainCof         =  nvmem.app.controllerObj.npidIgainCof;
    //    ctrl.pidIgainStableCofUP = nvmem.app.controllerObj.npidIgainStableCofUP;//0.25
    ctrl.slopeCtrlPreTh      = nvmem.app.controllerObj.nslopeCtrlPreTh;//0.01
    ctrl.pidPgainCof         = nvmem.app.controllerObj.npidPgainCof;//0.2
    //    ctrl.pidPgainStableCofUP = nvmem.app.controllerObj.npidPgainStableCofUP;//0.08
    //    ctrl.pidIgainStableCofUP2 = nvmem.app.controllerObj.npidIgainStableCofUP2;//0.25
    ctrl.slopeCrack           = nvmem.app.controllerObj.nslopeCrack;//5

    ctrl.slopeMin1 = nvmem.app.controllerObj.nslopeMin1;//0.02	;
