    ctrl.cofErr =  nvmem.app.controllerObj.ncofErr;//5
    ctrl.errCofTh = nvmem.app.controllerObj.nerrCofTh;
    ctrl.slopeCtrlL = nvmem.app.controllerObj.nslopeCtrlL;
    ctrl.slopeCtrlC = nvmem.app.controllerObj.nslopeCtrlC;
