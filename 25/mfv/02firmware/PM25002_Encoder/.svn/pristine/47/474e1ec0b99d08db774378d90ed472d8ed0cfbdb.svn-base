    ctrl.slopeMin3 = nvmem.app.controllerObj.nslopeMin3;// 0.01
    ctrl.slopeMinTh1 = nvmem.app.controllerObj.nslopeMinTh1;// 0.05	;
    ctrl.slopeMinTh2 = nvmem.app.controllerObj.nslopeMinTh2;// 0.07	;
    ctrl.slopeMinTh3 = nvmem.app.controllerObj.nslopeMinTh3;// 0.85	;
    ctrl.slopeCtrlVal3 = nvmem.app.controllerObj.nslopeCtrlVal3;// 0.75	;
