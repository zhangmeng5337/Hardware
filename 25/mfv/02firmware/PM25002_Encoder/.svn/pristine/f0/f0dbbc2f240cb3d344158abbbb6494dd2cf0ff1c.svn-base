binary nullAttr = {0};

/**
  @brief For Pgain flash writes, automatically load information to RAM for controller object
*/
static uint8_t cmdPtw(uint8_t *cmdInfo) {
#ifndef BOOTLOADER  
  command_info *cmdInfo_lcl = (command_info *)cmdInfo; 
  uint8_t cmd;
  binary value;  
  cmd = cmdInfo_lcl->cmdSpecific;
  memcpy(&value._uint32, cmdInfo_lcl->data_array, sizeof(float));
  ctrl.dynPtable[cmd - 120].y = value._float;
  return _CONTINUE;
#else
  return _FAIL; 
#endif    
}

/**
  @brief For Igain flash writes, automatically load information to RAM for controller object
*/
static uint8_t cmdItw(uint8_t *cmdInfo) {
#ifndef BOOTLOADER  
  command_info *cmdInfo_lcl = (command_info *)cmdInfo; 
  uint8_t cmd;
  binary value;  
  cmd = cmdInfo_lcl->cmdSpecific;
  memcpy(&value._uint32, cmdInfo_lcl->data_array, sizeof(float));
  ctrl.dynItable[cmd - 126].y = value._float;
  return _CONTINUE;  
#else
  return _FAIL;  
#endif 
}

/**
  @brief For Setpoint flash writes, automatically load information to RAM for controller object
*/
static uint8_t cmdSPtw(uint8_t *cmdInfo) {
#ifndef BOOTLOADER  
  command_info *cmdInfo_lcl = (command_info *)cmdInfo; 
  uint8_t cmd;
  binary value;  
  cmd = cmdInfo_lcl->cmdSpecific;
  memcpy(&value._uint32, cmdInfo_lcl->data_array, sizeof(float));
  ctrl.dynPtable[cmd - 132].x = value._float;
  ctrl.dynItable[cmd - 132].x = value._float;
  return _CONTINUE;
#else
  return _FAIL;
#endif 
}

