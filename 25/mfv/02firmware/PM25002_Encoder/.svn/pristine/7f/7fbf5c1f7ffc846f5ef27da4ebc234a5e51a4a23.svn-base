/**
  @brief DFU jump setup 
*/
void JumpToBootloader(void) {  
  
  GPIO_InitTypeDef GPIO_InitStruct;
  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11|GPIO_PIN_12, GPIO_PIN_RESET);
  /**USB GPIO Configuration    
  PA11     ------> USB_DM
  PA12     ------> USB_DP 
  */
  GPIO_InitStruct.Pin = GPIO_PIN_11|GPIO_PIN_12;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_PULLDOWN;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);
  HAL_Delay(1000);  
  USBD_Stop(&hUsbDeviceFS);
  HAL_Delay(1000);  
  USBD_DeInit(&hUsbDeviceFS);
  HAL_Delay(1000);
  
  *((unsigned long *)0x2001FFF1) = 0xDEADBEEF;
  NVIC_SystemReset();
}

/**
  @brief DFU jump manager
*/
void __bootloader_manager(void)
{
  // function pointer
  void (*SysMemBootJump)(void);

  // Add this to SystemInit() in system_clocks.c
  if ( *((unsigned long *)0x2001FFF1) == 0xDEADBEEF) {

    // reset the trigger
    *((unsigned long *)0x2001FFF1) =  0xCAFEFEED; 

    __HAL_SYSCFG_REMAPMEMORY_SYSTEMFLASH();

    const uint32_t p = (*((uint32_t *) 0x1FFF0000));
    __set_MSP( p );

    void (*SysMemBootJump)(void);
    SysMemBootJump = (void (*)(void)) (*((uint32_t *) 0x1FFF0004));
    SysMemBootJump();
    while (42);
  }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{


  /* USER CODE BEGIN 1 */  __bootloader_manager();  
#ifdef RELEASE        
    SCB->VTOR = NVIC_VectTab_FLASH | (VECTOR_TABLE_OFFSET & (uint32_t)0x1FFFFF80);
#else
    SCB->VTOR = NVIC_VectTab_FLASH | (0 & (uint32_t)0x1FFFFF80);
#endif

#ifdef BOOTLOADER	
	uint16_t bootTimeOut = 100;	
  if (validate_app_image() == 1) {
		MX_GPIO_Init();
		MX_TIM6_Init();
		HAL_TIM_Base_Start_IT(&htim6);
    //sprintf((char *)blver, "%02d.%02d.%02d", FW_BL_REVISION_MAJOR, FW_BL_REVISION_MINOR, FW_BL_REVISION_PATCH);    
		while (bootTimeOut > 0) {
			if (HAL_GPIO_ReadPin(GPIO_ZERO_CS4_GPIO_Port, GPIO_ZERO_CS4_Pin) == GPIO_PIN_RESET) {	// device booted while zero button is pressed
				HAL_Delay(100);	// delay 100ms
				bootTimeOut--;
			} else {
				runApplicationFirmware();	// run application firmware
			}				
		}		
	}	
#endif  
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /*##-1- Check if the system has resumed from IWDG reset ####################*/
  if (__HAL_RCC_GET_FLAG(RCC_FLAG_IWDGRST) != 0x00u)
  {
#ifndef BOOTLOADER    

#endif
  }
  /* Clear reset flags in any cases */
  __HAL_RCC_CLEAR_RESET_FLAGS();
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_SPI3_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_TIM5_Init();
  MX_TIM6_Init();
  MX_TIM7_Init();
  MX_TIM8_Init();
  MX_TIM15_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start_IT(&htim6);  
  
  osKernelInitialize();                 // Initialize CMSIS-RTOS

  Init_Semaphore_bgnd();
#ifndef BOOTLOADER  
  Init_Semaphore_sigproc();  
  Init_Semaphore_ec();
#endif
  Init_Semaphore_mem();
  Init_Semaphore_comms_usbd();
  
  osKernelStart();                      // Start thread execution  
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

